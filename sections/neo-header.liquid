  #shopify-section-{{ section.id }} .neo-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: min(86%, 360px);
    height: 100dvh;
    background: var(--neo-bg);
    color: var(--neo-txt);
    border-radius: 0 var(--neo-radius) var(--neo-radius) 0;
    box-shadow: 24px 0 60px -20px rgba(22, 24, 29, 0.35);
