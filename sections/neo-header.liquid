<script>
  (function () {
    const sectionWrapper = document.getElementById('shopify-section-{{ section.id }}');
    const sectionEl = document.getElementById('neo-header-{{ section.id }}');
    if (!sectionWrapper || !sectionEl) return;

    const stickZone = sectionEl.querySelector('[data-neo-stickzone]');
    const spacerEl = sectionEl.querySelector('[data-neo-stick-spacer]');
    const toggleBtn = sectionEl.querySelector('[data-neo-menu-toggle]');
    const closeBtn = sectionEl.querySelector('[data-neo-menu-close]');
    const overlay = sectionEl.querySelector('[data-neo-menu-overlay]');
    const panel = sectionEl.querySelector('[data-neo-menu-panel]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- Smart sticky: fix past threshold, hide on scroll down, reveal on scroll up ---------- */
    let thresholdPx = 0;
    let lastSpacerH = 0;
    let lastScrollY = window.scrollY;
    let ticking = false;

    function measureThreshold() {
      const prev = sectionWrapper.previousElementSibling; /* announcement bar if present */
      thresholdPx = prev ? prev.offsetHeight : 0;
    }

    function applySticky() {
      const y = window.scrollY;
      const shouldFix = y >= thresholdPx;

      if (shouldFix) {
        if (!stickZone.classList.contains('is-fixed')) stickZone.classList.add('is-fixed');
        const h = stickZone.offsetHeight;
        if (lastSpacerH !== h) {
          spacerEl.style.height = h + 'px';
          lastSpacerH = h;
        }
        /* Hide on scroll down (past one header height), reveal on scroll up */
        const goingDown = y > lastScrollY;
        const menuOpen = panel && !panel.hidden;
        if (goingDown && y > thresholdPx + h * 2 && !menuOpen) {
          stickZone.classList.add('is-hidden');
        } else if (!goingDown || y <= thresholdPx + h) {
          stickZone.classList.remove('is-hidden');
        }
      } else {
        stickZone.classList.remove('is-fixed', 'is-hidden');
        if (lastSpacerH !== 0) {
          spacerEl.style.height = '0px';
          lastSpacerH = 0;
        }
      }
      lastScrollY = y;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        applySticky();
        ticking = false;
      });
    }

    function initSticky() {
      measureThreshold();
      applySticky();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () {
      measureThreshold();
      applySticky();
    });
    document.addEventListener('shopify:section:load', initSticky);
    initSticky();

    /* ---------- Mobile drawer: scroll lock + focus trap ---------- */
    if (toggleBtn && closeBtn && overlay && panel) {
      let lastFocused = null;

      function focusables() {
        return panel.querySelectorAll('a[href], button:not([disabled])');
      }

      function trapFocus(evt) {
        if (evt.key !== 'Tab') return;
        const items = focusables();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (evt.shiftKey && document.activeElement === first) {
          evt.preventDefault();
          last.focus();
        } else if (!evt.shiftKey && document.activeElement === last) {
          evt.preventDefault();
          first.focus();
        }
      }

      function openMenu() {
        lastFocused = document.activeElement;
        panel.hidden = false;
        overlay.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        requestAnimationFrame(function () {
          panel.classList.add('is-open');
          overlay.classList.add('is-open');
          toggleBtn.setAttribute('aria-expanded', 'true');
          closeBtn.focus();
        });
        panel.addEventListener('keydown', trapFocus);
      }

      function closeMenu() {
        panel.classList.remove('is-open');
        overlay.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
        panel.removeEventListener('keydown', trapFocus);
        const delay = reduceMotion ? 0 : 380;
        setTimeout(function () {
          panel.hidden = true;
          overlay.hidden = true;
        }, delay);
        if (lastFocused && lastFocused.focus) lastFocused.focus();
      }

      toggleBtn.addEventListener('click', function () {
        if (panel.hidden) openMenu();
        else closeMenu();
      });
      closeBtn.addEventListener('click', closeMenu);
      overlay.addEventListener('click', closeMenu);
      document.addEventListener('keydown', function (evt) {
        if (evt.key === 'Escape' && !panel.hidden) closeMenu();
      });
      /* Close when a drawer link is tapped so the drawer isn't open on back-nav */
      panel.addEventListener('click', function (evt) {
        if (evt.target.closest('a[href]')) closeMenu();
      });
    }

    /* ---------- Live cart count ---------- */
    const countEls = sectionEl.querySelectorAll('[data-neo-cart-count]');

    function setCartCount(n) {
      countEls.forEach(function (el) {
        const prev = parseInt(el.textContent, 10) || 0;
        el.textContent = n;
        el.classList.toggle('is-empty', n === 0);
        if (n > prev) {
          el.classList.remove('is-bumping');
          void el.offsetWidth; /* restart animation */
          el.classList.add('is-bumping');
        }
      });
    }

    let refreshTimer = null;
    function refreshCartCount() {
      clearTimeout(refreshTimer);
      refreshTimer = setTimeout(async function () {
        try {
          const res = await fetch('/cart.js', {
            headers: { Accept: 'application/json' },
            credentials: 'same-origin'
          });
          if (!res.ok) return;
          const cart = await res.json();
          setCartCount(cart.item_count || 0);
        } catch (e) {
          /* silent */
        }
      }, 150);
    }

    /* Standard add-to-cart form submits */
    document.addEventListener(
      'submit',
      function (e) {
        const form = e.target;
        if (form && form.action && form.action.indexOf('/cart/add') !== -1) {
          setTimeout(refreshCartCount, 400);
          setTimeout(refreshCartCount, 1200);
        }
      },
      true
    );

    /* Themes/apps that emit cart events */
    ['cart:updated', 'cart:refresh', 'cart:change'].forEach(function (evtName) {
      document.addEventListener(evtName, refreshCartCount);
    });

    /* Catch custom AJAX hitting the cart API */
    const _fetch = window.fetch;
    window.fetch = function () {
      const args = arguments;
      let url = '';
      try {
        url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url) || '';
      } catch (e) {}
      const isCartMutation = /\/cart\/(add|change|update|clear)(\.js)?([?/]|$)/.test(url);
      return _fetch.apply(this, args).then(function (resp) {
        if (isCartMutation && resp.ok) refreshCartCount();
        return resp;
      });
    };

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) refreshCartCount();
    });
    window.addEventListener('pageshow', refreshCartCount);
  })();
</script>

