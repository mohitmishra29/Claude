  #shopify-section-{{ section.id }} .neo-mobile-icon-chip .neo-cart-count--inline {
    position: absolute;
    top: 0.35rem;
    right: 0.5rem;
    margin: 0;
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .neo-header-shell {
      padding: 0.65rem 0.9rem;
    }
    #shopify-section-{{ section.id }} .neo-logo-img {
      max-height: calc(44px * var(--logo-scale));
