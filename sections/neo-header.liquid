  /* Small phones: hide account icon in the bar (still reachable in drawer) */
  @media (max-width: 400px) {
    #shopify-section-{{ section.id }} .neo-account-btn {
      display: none;
    }
    #shopify-section-{{ section.id }} .neo-logo-img {
      max-height: calc(30px * var(--logo-scale));
