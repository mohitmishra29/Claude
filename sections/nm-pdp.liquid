{% comment %}
NM PDP v5.0
New in v5.0:
- OOS guard: Add to Cart & Buy Now disabled when inventory = 0 with tracking enabled
- Description always open — removed from accordion; full content visible by default
- SEO · AEO · AIO · SXO · GEO · LLM: Product JSON-LD, FAQPage JSON-LD,
  BreadcrumbList — Brand, GTIN, MPN, meta-description override, canonical override
  all configurable from Theme Editor with no code changes
Kept from v4.9:
- Trust badge grid (≤ 6 blocks, 2-per-row, per-badge BG/text color)
- Desktop/mobile body text sizing (11–20 mobile · 14–24 desktop)
- Title size sliders (Description / Manufacturing Details)
- Price cleanup / save-% badge
- Sticky CTA, swipe gallery, variant swatches, FAQ accordion
{% endcomment %}

{%- liquid
  assign s    = section.settings
  assign prod = product

  if prod == blank
    echo '<div style="padding:20px;text-align:center">Select a product to preview this section.</div>'
    break
  endif

  assign show_top = false
  if s.show_top
    assign show_top = true
  endif

  assign show_gallery = false
  if show_top and s.show_gallery
    assign show_gallery = true
  endif

  assign show_summary = false
  if show_top and s.show_summary
    assign show_summary = true
  endif

  assign two_cols = false
  if show_gallery and show_summary
    assign two_cols = true
  endif

  assign add_label  = s.add_label  | default: '<p>Add to cart</p>'
  assign buy_label  = s.buy_label  | default: '<p>Buy now</p>'
  assign oos_label  = s.oos_label  | default: '<p>Out of stock</p>'

  # ----- Badge (per-product metafields priority -> section fallback)
  assign mf_badge_enabled = false
  if prod.metafields.custom.badge_enabled
    if prod.metafields.custom.badge_enabled == true or prod.metafields.custom.badge_enabled.value == true
      assign mf_badge_enabled = true
    endif
  endif
  assign mf_badge_text_html = ''
  if prod.metafields.custom.badge_text
    if prod.metafields.custom.badge_text.value
      assign mf_badge_text_html = prod.metafields.custom.badge_text | metafield_tag
    else
      assign mf_badge_text_html = prod.metafields.custom.badge_text
    endif
  endif
  assign show_badge = false
  assign badge_html = ''
  if mf_badge_enabled and mf_badge_text_html != blank
    assign show_badge = true
    assign badge_html = mf_badge_text_html
  elsif s.badge_show_default
    assign show_badge = true
    assign badge_html = s.badge_rich
    if badge_html == blank
      assign badge_html = '<p>Best seller</p>'
    endif
  endif

  # ----- Benefits rich (product metafield -> section fallback)
  assign benefits_html = ''
  if prod.metafields.custom and prod.metafields.custom.benefits
    if prod.metafields.custom.benefits.value
      assign benefits_html = prod.metafields.custom.benefits | metafield_tag
    else
      assign benefits_html = prod.metafields.custom.benefits
    endif
  endif
  if benefits_html == blank
    assign benefits_html = s.benefits_rich
  endif

  # ----- Rating
  assign rating_val = 0
  if product.metafields.reviews.rating and product.metafields.reviews.rating.value
    assign rating_val = product.metafields.reviews.rating.value
  elsif product.metafields.reviews.rating
    assign rating_val = product.metafields.reviews.rating
  elsif product.metafields.judgeme and product.metafields.judgeme.badge_average
    assign rating_val = product.metafields.judgeme.badge_average
  elsif product.metafields.loox and product.metafields.loox.avg_rating
    assign rating_val = product.metafields.loox.avg_rating
  endif
  assign rating_pct = 0
  if rating_val
    assign rating_pct = rating_val | times: 20
  endif

  # ----- Discount math for price badge
  assign curr_variant    = product.selected_or_first_available_variant
  assign compare_price   = curr_variant.compare_at_price
  assign actual_price    = curr_variant.price
  assign show_save_badge = false
  assign save_pct        = 0
  if compare_price > actual_price and compare_price > 0
    assign diff     = compare_price | minus: actual_price
    assign save_pct = diff | times: 100 | divided_by: compare_price
    assign show_save_badge = true
  endif

  # ----- Availability (controls disabled state of all CTA buttons)
  assign curr_available = false
  if curr_variant.available
    assign curr_available = true
  endif

  # ----- Trust badge blocks presence
  assign any_trust = false
  for b in section.blocks
    if b.type == 'trust_badge' and b.settings.enabled
      assign any_trust = true
      break
    endif
  endfor
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ section.settings.font_family | default: 'Poppins' | url_encode }}:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
#nm-{{ section.id }}{
  --bg: {{ s.bg | default: '#e9eef5' }};
  --elev: {{ s.elev | default: '#f3f7fd' }};
  --text: {{ s.text | default: '#0e1320' }};
  --brand: {{ s.brand | default: '#100146' }};
  --accent: {{ s.accent | default: '#ff7a1a' }};
  --radius: {{ s.radius | default: 16 }}px;
  --sd: {{ s.shadow_depth | default: 8 }}px;
  --page: {{ s.max_width | default: 1600 }}px;

  --btnBg: {{ s.btn_bg | default: '#f3f7fd' }};
  --btnText: {{ s.btn_text | default: '#0e1320' }};
  --buyBg: {{ s.buy_bg | default: '#f3f7fd' }};
  --buyText: {{ s.buy_text | default: '#0e1320' }};

  --badgeBg: {{ s.badge_bg | default: '#e9edff' }};
  --badgeText: {{ s.badge_text | default: '#100146' }};

  --light: rgba(255,255,255,.95);
  --dark: rgba(0,14,38,.16);
  --outer: var(--sd) var(--sd) calc(var(--sd)*2) var(--dark),
           calc(var(--sd)*-1) calc(var(--sd)*-1) calc(var(--sd)*2) var(--light);
  --inset: inset 6px 6px 12px rgba(0,0,0,.10), inset -6px -6px 12px rgba(255,255,255,.75);
  --pill: 999px;

  --bodyTextDesktop: {{ s.body_font_size_desktop | default: 16 }}px;
  --bodyTextMobile:  {{ s.body_font_size_mobile  | default: 15 }}px;

  font-family:'{{ s.font_family | default: "Poppins" }}', ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial;
  color:var(--text);
}
#nm-{{ section.id }} *{box-sizing:border-box}
#nm-{{ section.id }} .page{max-width:var(--page);margin:24px auto;padding:0 16px;background:var(--bg)}
#nm-{{ section.id }} .wrap{display:grid;gap:clamp(14px,2.2vw,22px);grid-template-columns:{% if two_cols %}1fr 1fr{% else %}1fr{% endif %};align-items:start}
#nm-{{ section.id }} .card{background:var(--elev);border-radius:var(--radius);box-shadow:var(--outer)}
#nm-{{ section.id }} .nm-desk-title{margin:0 0 10px;font-size:clamp(22px,2.1vw,28px);line-height:1.25}
#nm-{{ section.id }} .nm-m-title{display:none;margin:8px 0 8px;font-size:20px;line-height:1.25}

/* Gallery */
#nm-{{ section.id }} .stage{position:relative;width:100%;border-radius:var(--radius);overflow:hidden;background:#fff;aspect-ratio:1/1;max-height:760px}
#nm-{{ section.id }} .slide{position:absolute;inset:0;opacity:0;transition:opacity .25s ease}
#nm-{{ section.id }} .slide.active{opacity:1}
#nm-{{ section.id }} .stage picture,
#nm-{{ section.id }} .stage img,
#nm-{{ section.id }} .stage video{display:block;width:100%!important;height:100%!important;object-fit:cover!important;object-position:center center!important;background:#fff}
#nm-{{ section.id }} .navBtn{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:var(--pill);border:1px solid rgba(255,255,255,.45);background:linear-gradient(180deg,rgba(255,255,255,.35),rgba(255,255,255,.18));backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 8px 18px rgba(16,1,70,.18);z-index:2;cursor:pointer}
#nm-{{ section.id }} .prev{left:10px}
#nm-{{ section.id }} .next{right:10px}
#nm-{{ section.id }} .thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px}
#nm-{{ section.id }} .thumb{aspect-ratio:1/1;border-radius:14px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--elev);box-shadow:var(--outer);cursor:pointer}
#nm-{{ section.id }} .thumb.active{box-shadow:var(--inset)}
#nm-{{ section.id }} .dots{display:none;gap:6px;justify-content:center;margin:10px 0 2px}
#nm-{{ section.id }} .dot{width:6px;height:6px;border-radius:999px;background:rgba(0,0,0,.18)}
#nm-{{ section.id }} .dot.active{background:var(--brand)}

/* Summary / Buy box */
#nm-{{ section.id }} .summary{position:sticky;top:16px;padding:16px;align-self:start}

/* Small badge (top "Best seller") */
#nm-{{ section.id }} .badge{
  background:var(--badgeBg);color:var(--badgeText);
  box-shadow:var(--outer);border-radius:var(--pill);
  padding:4px 10px;font-size:12px;font-weight:800;
  display:inline-flex;align-items:center;gap:6px;line-height:1;vertical-align:middle;white-space:nowrap
}
#nm-{{ section.id }} .badge *{all:unset;display:inline;line-height:inherit;font:inherit;color:inherit;font-weight:inherit}

/* Rating */
#nm-{{ section.id }} .rating{display:flex;align-items:center;gap:8px;margin:6px 0 10px;flex-wrap:wrap}
#nm-{{ section.id }} .stars{position:relative;display:inline-block;font-size:16px;letter-spacing:2px;line-height:1;white-space:nowrap;color:var(--accent)!important}
#nm-{{ section.id }} .stars:before{content:'★★★★★';opacity:.28;color:var(--accent)!important}
#nm-{{ section.id }} .stars-fill{position:absolute;left:0;top:0;bottom:0;width:0;overflow:hidden;color:var(--accent)!important;pointer-events:none}
#nm-{{ section.id }} .stars-fill:before{content:'★★★★★';color:var(--accent)!important}

/* Price / variants / qty */
#nm-{{ section.id }} .priceRow{display:flex;align-items:flex-start;flex-wrap:wrap;row-gap:4px;column-gap:12px;margin:8px 0 12px}
#nm-{{ section.id }} .priceRow .price__container:first-child .price__regular{display:none !important;}
#nm-{{ section.id }} .priceRow .price-item--regular{font-size:14px;line-height:1.2;color:rgba(0,0,0,.45);text-decoration:line-through;font-weight:500;}
#nm-{{ section.id }} .priceRow .price-item--sale,
#nm-{{ section.id }} .priceRow .price-item--last{font-size:16px;line-height:1.2;font-weight:800;color:var(--text);}
#nm-{{ section.id }} .nm-save-badge{background:var(--badgeBg);color:var(--badgeText);box-shadow:var(--outer);border-radius:var(--pill);padding:2px 8px;font-size:11px;font-weight:700;line-height:1.2;display:inline-flex;align-items:center;margin-left:6px;}

/* Variant group */
#nm-{{ section.id }} .option{margin-top:12px}
#nm-{{ section.id }} .label{font-size:12px;opacity:.75;margin:8px 0 6px;font-weight:600;line-height:1.3;display:flex;flex-wrap:wrap;gap:4px}
#nm-{{ section.id }} .label .currentChoice{display:none}
#nm-{{ section.id }} .swatches{display:flex;flex-wrap:wrap;gap:10px}
#nm-{{ section.id }} .sw{min-width:44px;text-align:center;padding:8px 12px;border:none;background:var(--elev);box-shadow:var(--outer);border-radius:var(--pill);cursor:pointer;font-weight:700;font-size:13px;line-height:1.2}
#nm-{{ section.id }} .sw[aria-pressed="true"]{box-shadow:var(--inset)}

/* Qty + CTA row */
#nm-{{ section.id }} .qty{display:flex;gap:10px;align-items:flex-start;flex-wrap:wrap;margin:12px 0 0}
#nm-{{ section.id }} .stepper{display:flex;align-items:center;border-radius:var(--pill);overflow:hidden;background:var(--elev);box-shadow:var(--outer)}
#nm-{{ section.id }} .stepper button{border:none;background:transparent;padding:8px 12px;font-weight:800;cursor:pointer;font-size:16px;line-height:1}
#nm-{{ section.id }} .stepper input{width:44px;text-align:center;border:none;background:transparent;padding:8px 0;font-weight:800;font-size:14px;line-height:1}

/* CTA buttons */
#nm-{{ section.id }} .btn{border:none!important;outline:none!important;background:var(--btnBg);color:var(--btnText);box-shadow:var(--outer);border-radius:var(--pill);padding:10px 14px;font-weight:800;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease,opacity .2s ease;font-size:14px;line-height:1;text-align:center}
#nm-{{ section.id }} .btn-buy{background:var(--buyBg);color:var(--buyText);box-shadow:var(--outer),0 0 8px rgba(0,0,0,.05)}
#nm-{{ section.id }} .btn:active{box-shadow:var(--inset)}
#nm-{{ section.id }} .btn .rte-inline *{all:unset;display:inline;line-height:inherit;font:inherit;color:inherit;font-weight:inherit}

/* Out of stock — disabled button state */
#nm-{{ section.id }} .btn:disabled,
#nm-{{ section.id }} .btn[disabled]{
  opacity:.38;
  cursor:not-allowed;
  pointer-events:none;
  box-shadow:var(--inset) !important;
}
/* OOS message */
#nm-{{ section.id }} .nm-oos-msg{
  display:none;
  margin:8px 0 0;
  padding:6px 12px;
  border-radius:8px;
  background:rgba(192,57,43,.07);
  color:#c0392b;
  font-size:12px;
  font-weight:700;
  line-height:1.4;
}
#nm-{{ section.id }} .nm-oos-msg.visible{display:block}

/* Benefits box text */
#nm-{{ section.id }} .benefits-box-body{font-size:var(--bodyTextMobile);line-height:1.5;}
@media (min-width:768px){
  #nm-{{ section.id }} .benefits-box-body{font-size:var(--bodyTextDesktop) !important;line-height:1.5;}
}

/* Trust badges grid */
#nm-{{ section.id }} .nm-trust-badges{margin-top:12px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;align-items:stretch;}
#nm-{{ section.id }} .nm-trust-badge{display:flex;align-items:center;gap:8px;border-radius:var(--pill);padding:8px 12px;box-shadow:var(--outer);font-size:12px;line-height:1.3;font-weight:600;min-height:44px;text-align:left;word-break:break-word;}
#nm-{{ section.id }} .nm-trust-ic{flex-shrink:0;width:28px;height:28px;border-radius:999px;overflow:hidden;box-shadow:var(--inset);background:rgba(255,255,255,.6);display:flex;align-items:center;justify-content:center;}
#nm-{{ section.id }} .nm-trust-ic img{display:block;width:100%;height:100%;object-fit:contain;}
#nm-{{ section.id }} .nm-trust-text{font-size:12px;line-height:1.3;font-weight:600;color:inherit;}
#nm-{{ section.id }} .nm-trust-text p{margin:0;display:inline;font-size:inherit;line-height:inherit;font-weight:inherit;color:inherit;}

/* Description — always open */
#nm-{{ section.id }} .nm-desc-card{padding:16px 20px}
#nm-{{ section.id }} .nm-desc-header{display:flex;align-items:center;gap:10px;margin:0 0 12px}

/* Accordion / long text bodies */
#nm-{{ section.id }} .section{margin:24px 0}
#nm-{{ section.id }} .sec-head{display:flex;align-items:center;justify-content:space-between;margin:0 0 10px;flex-wrap:wrap;row-gap:10px}
#nm-{{ section.id }} .sec-title{display:flex;align-items:center;gap:10px;margin:0;font-weight:800;font-size:16px;line-height:1.3}
#nm-{{ section.id }} .accordion{display:grid;gap:12px}
#nm-{{ section.id }} .acc-card{background:var(--elev);box-shadow:var(--outer);border-radius:14px;overflow:hidden}
#nm-{{ section.id }} .acc-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;cursor:pointer;font-weight:800;font-size:14px;line-height:1.3}
#nm-{{ section.id }} .acc-head .left{display:flex;align-items:center;gap:10px}
#nm-{{ section.id }} .acc-body{display:none;padding:12px 14px;border-top:1px solid rgba(0,0,0,.06)}
#nm-{{ section.id }} .acc-card.open .acc-body{display:block}

#nm-{{ section.id }} .nm-desc-body,
#nm-{{ section.id }} .nm-mfg-body{font-size:var(--bodyTextMobile);line-height:1.5;}
@media (min-width:768px){
  #nm-{{ section.id }} .nm-desc-body,
  #nm-{{ section.id }} .nm-mfg-body{font-size:var(--bodyTextDesktop) !important;line-height:1.5;}
}

/* FAQ accordion */
#nm-{{ section.id }} .faq-accordion .faq-card{background:var(--elev);box-shadow:var(--outer);border-radius:14px;margin:10px 0;overflow:hidden}
#nm-{{ section.id }} .faq-accordion .faq-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;cursor:pointer;font-weight:800;font-size:14px;line-height:1.3}
#nm-{{ section.id }} .faq-accordion .faq-body{display:none;padding:12px 14px;border-top:1px solid rgba(0,0,0,.06);font-size:var(--bodyTextMobile);line-height:1.5}
#nm-{{ section.id }} .faq-accordion .faq-card.open .faq-body{display:block}
@media (min-width:768px){
  #nm-{{ section.id }} .faq-accordion .faq-body{font-size:var(--bodyTextDesktop) !important;line-height:1.5;}
}

/* Sticky mobile CTA bar */
#nm-{{ section.id }} .nm-sticky-cta{display:none;position:fixed;left:0;right:0;bottom:0;background:rgba(255,255,255,.34);border-top:1px solid rgba(0,0,0,.08);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:10px 12px;box-shadow:0 -10px 24px rgba(0,0,0,.10);z-index:999}
#nm-{{ section.id }} .nm-sticky-cta .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#nm-{{ section.id }} .nm-sticky-cta .btn{width:100%}
#nm-{{ section.id }} .nm-sticky-cta .btn-buy{box-shadow:var(--outer),0 0 8px rgba(0,0,0,.05)}

/* Banner */
#nm-{{ section.id }} .nm-banner{margin:20px 0}
#nm-{{ section.id }} .nm-banner a{display:block;border-radius:var(--radius);overflow:hidden;box-shadow:var(--outer);background:var(--elev);position:relative}
#nm-{{ section.id }} .nm-banner img{display:block;width:100%;height:{{ s.banner_h_desktop | default: 360 }}px;object-fit:cover}
#nm-{{ section.id }} .nm-banner .only-mob{display:none}
#nm-{{ section.id }} .nm-banner .only-desk{display:block}

/* Responsive */
@media (max-width:990px){
  #nm-{{ section.id }} .summary{position:static;padding:14px}
}
@media (max-width:768px){
  #nm-{{ section.id }} .nm-m-title{display:block}
  #nm-{{ section.id }} .nm-desk-title{display:none}
  #nm-{{ section.id }} .navBtn{display:none}
  #nm-{{ section.id }} .thumbs{display:none!important}
  #nm-{{ section.id }} .wrap{display:block}
  #nm-{{ section.id }} .page{padding-bottom:92px}
  #nm-{{ section.id }} .nm-sticky-cta{display:block}
  #nm-{{ section.id }} .cta{display:none!important}
  #nm-{{ section.id }} .nm-banner img{height:{{ s.banner_h_mobile | default: 220 }}px}
  #nm-{{ section.id }} .nm-banner .only-mob{display:block}
  #nm-{{ section.id }} .nm-banner .only-desk{display:none}
}

/* Toast */
#nm-{{ section.id }} .nm-toast{position:fixed;left:50%;bottom:92px;transform:translateX(-50%);background:var(--elev);box-shadow:var(--outer);border-radius:14px;padding:10px 14px;font-weight:700;z-index:1000;transition:opacity .25s;opacity:0;}
</style>

<div id="nm-{{ section.id }}">
  <div class="page">

    <h1 class="nm-m-title">{{ product.title }}</h1>

    {% if show_top %}
    <div class="wrap">

      {% if show_gallery %}
      <section>
        <div class="card stage" data-stage>
          {% for m in product.media limit: 12 %}
            <div class="slide {% if forloop.first %}active{% endif %}">
              {% if m.media_type == 'image' %}
                {{ m | image_url: width: 1600 | image_tag: widths: '360,540,720,960,1200,1600', sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 560px', loading: 'lazy', alt: m.alt | escape }}
              {% else %}
                {{ m | media_tag: image_size: '1600x', autoplay: false, loop: false, controls: true }}
              {% endif %}
            </div>
          {% endfor %}
          <button class="navBtn prev" data-prev aria-label="Previous">◀</button>
          <button class="navBtn next" data-next aria-label="Next">▶</button>
        </div>
        <div class="dots" aria-hidden="true">
          {% for m in product.media limit: 12 %}
            <span class="dot {% if forloop.first %}active{% endif %}" data-dot="{{ forloop.index0 }}"></span>
          {% endfor %}
        </div>
        <div class="thumbs">
          {% for m in product.media limit: 12 %}
            <button class="thumb {% if forloop.first %}active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}">
              {{ m | image_url: width: 300 | image_tag: widths: '180,240,300', sizes: '180px', loading: 'lazy', alt: m.alt | escape }}
            </button>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if show_summary %}
      <aside class="card summary">
        <h1 class="nm-desk-title">{{ product.title }}</h1>

        <div class="rating">
          <span class="stars">
            <span class="stars-fill" style="width:{{ rating_pct }}%" data-rating-pct="{{ rating_pct }}"></span>
          </span>
          {% if product.metafields.reviews.rating_count %}
            <span style="opacity:.7;font-size:12px">{{ product.metafields.reviews.rating_count }} reviews</span>
          {% endif %}
          {% if show_badge %}
            <span class="badge"><span class="badge-text">{{ badge_html }}</span></span>
          {% endif %}
        </div>

        <div class="priceRow">
          {% render 'price', product: product, use_variant: true, price_class: 'price--large' %}
          {% if show_save_badge %}
            <span class="nm-save-badge">-{{ save_pct }}%</span>
          {% endif %}
        </div>

        {% form 'product', product, id: 'nm-form-{{ section.id }}', class: 'product-form', novalidate: 'novalidate' %}
          {% if product.has_only_default_variant == false %}
            {% for opt in product.options_with_values %}
              {%- assign opt_index0 = forloop.index0 -%}
              <div class="option">
                <div class="label" data-opt-label="{{ opt_index0 }}">
                  <span class="baseName">{{ opt.name }}</span>
                  <span class="currentChoice" data-current-choice="{{ opt_index0 }}">{{ opt.selected_value }}</span>
                </div>
                <div class="swatches" data-opt="{{ opt_index0 }}">
                  {% for val in opt.values %}
                    <button type="button" class="sw"
                      aria-pressed="{% if opt.selected_value == val %}true{% else %}false{% endif %}"
                      data-value="{{ val | escape }}">{{ val }}</button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
            <select name="id" id="nm-variant-{{ section.id }}" hidden>
              {% for v in product.variants %}
                <option value="{{ v.id }}"
                  {% if v == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless v.available %}disabled{% endunless %}
                >{{ v.title }}</option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="label" style="margin-top:8px">
            <span class="baseName">Quantity</span>
          </div>
          <div class="qty">
            <div class="stepper" data-stepper>
              <button type="button" aria-label="Decrease">−</button>
              <input name="quantity" value="1" inputmode="numeric" pattern="[0-9]*" aria-label="Quantity" />
              <button type="button" aria-label="Increase">+</button>
            </div>

            <div class="cta">
              <button class="btn" type="submit" name="add"
                {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
                <span class="rte-inline">{% if curr_available %}{{ add_label }}{% else %}{{ oos_label }}{% endif %}</span>
              </button>
              <button class="btn btn-buy" type="button" data-buy
                {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
                <span class="rte-inline">{{ buy_label }}</span>
              </button>
            </div>
          </div>

          <div class="nm-oos-msg {% unless curr_available %}visible{% endunless %}" role="alert">
            {{ s.oos_message | default: 'Currently out of stock — please check back soon.' }}
          </div>
        {% endform %}

        {% if s.show_benefits and benefits_html != blank %}
          <div class="card" style="padding:12px;margin-top:12px">
            <h4 style="margin:0 0 8px;font-size:14px;line-height:1.3;font-weight:800">{{ s.benefits_title }}</h4>
            <div class="benefits-box-body rte">
              {{ benefits_html }}
            </div>
          </div>
        {% endif %}

        {% if any_trust %}
          <div class="nm-trust-badges">
            {% for b in section.blocks %}
              {% if b.type == 'trust_badge' and b.settings.enabled %}
                <div class="nm-trust-badge"
                  style="background:{{ b.settings.badge_bg | default: s.elev }};color:{{ b.settings.badge_text_color | default: s.text }};">
                  {% if b.settings.badge_icon != blank %}
                    <span class="nm-trust-ic">
                      <img src="{{ b.settings.badge_icon | image_url: width: 64 }}"
                           alt=""
                           width="28"
                           height="28"
                           loading="lazy">
                    </span>
                  {% endif %}
                  <span class="nm-trust-text">
                    {{ b.settings.badge_text }}
                  </span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

      </aside>
      {% endif %}

    </div>
    {% endif %}

    {%- if s.show_icons_snippet -%}
      {%- render 'icons-neumorphic' -%}
    {%- endif -%}

    {% if s.show_banner %}
      {% if s.banner_img_desktop != blank or s.banner_img_mobile != blank %}
        <section class="nm-banner">
          {%- assign href = s.banner_link | default: '#' -%}
          <a href="{{ href }}" {% if s.banner_new_tab %}target="_blank" rel="noopener"{% endif %} aria-label="{{ s.banner_alt | escape }}">
            {% if s.banner_img_desktop %}
              <img class="only-desk" src="{{ s.banner_img_desktop | image_url: width: 2000 }}" alt="{{ s.banner_alt | escape }}">
            {% endif %}
            {% if s.banner_img_mobile %}
              <img class="only-mob" src="{{ s.banner_img_mobile | image_url: width: 1200 }}" alt="{{ s.banner_alt | escape }}">
            {% endif %}
          </a>
        </section>
      {% endif %}
    {% endif %}

    {%- comment -%} ── Description — always open ── {%- endcomment -%}
    {% if s.show_desc %}
    <section class="section" itemscope itemprop="description">
      <div class="card nm-desc-card">
        <div class="nm-desc-header">
          {% if s.desc_icon != blank %}
            <img src="{{ s.desc_icon | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
          {% endif %}
          <h2 style="margin:0;font-size:{{ s.desc_title_size | default: 14 }}px;line-height:1.3;font-weight:800">
            {{ s.desc_title }}
          </h2>
        </div>
        <div class="nm-desc-body rte">
          {{ product.description | default: '<p>Add your product description in Admin.</p>' }}
        </div>
      </div>
    </section>
    {% endif %}

    {%- comment -%} ── Manufacturing Details — accordion ── {%- endcomment -%}
    {% if s.show_mfg %}
    <section class="section">
      <div class="accordion">
        <div class="acc-card" data-acc>
          <div class="acc-head">
            <div class="left">
              {% if s.mfg_icon != blank %}
                <img src="{{ s.mfg_icon | image_url: width: 48 }}" alt="" width="24" height="24" loading="lazy">
              {% endif %}
              <span class="h5"
                style="margin:0;font-size:{{ s.mfg_title_size | default: 14 }}px;line-height:1.3;font-weight:800">
                {{ s.mfg_title }}
              </span>
            </div>
            <span aria-hidden="true">+</span>
          </div>
          <div class="acc-body">
            {% assign any_mfg = false %}
            {% for b in section.blocks %}
              {% if b.type == 'mfg' and b.settings.enabled %}
                {% assign any_mfg = true %}{% break %}
              {% endif %}
            {% endfor %}

            {% if s.use_mfg_fallback or any_mfg == false %}
              <div class="nm-mfg-body rte">
                {{ s.mfg_fallback_rich1 }}
                {{ s.mfg_fallback_rich2 }}
                {{ s.mfg_fallback_rich3 }}
              </div>
            {% else %}
              <div class="nm-mfg-body rte">
                <ul style="margin:0;padding-left:18px">
                {% for b in section.blocks %}
                  {% if b.type == 'mfg' and b.settings.enabled %}
                    <li><strong>{{ b.settings.title }}</strong>: {{ b.settings.text }}</li>
                  {% endif %}
                {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    {% if s.show_faqs %}
    <section class="section">
      <div class="sec-head">
        <div class="sec-title rte">{{ s.faqs_title_rich }}</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn" style="padding:8px 12px" data-expand>Expand all</button>
          <button class="btn btn-buy" style="padding:8px 12px" data-collapse>Collapse all</button>
        </div>
      </div>

      <div class="faq-accordion" itemscope itemtype="https://schema.org/FAQPage">
        {% assign any_faq = false %}
        {% for b in section.blocks %}
          {% if b.type == 'faq' and b.settings.enabled %}{% assign any_faq = true %}{% break %}{% endif %}
        {% endfor %}

        {% if any_faq %}
          {% for b in section.blocks %}
            {% if b.type == 'faq' and b.settings.enabled %}
              <div class="faq-card" {{ b.shopify_attributes }}
                itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                <div class="faq-head">
                  <span class="rte" itemprop="name">{{ b.settings.q }}</span>
                  <span aria-hidden="true">+</span>
                </div>
                <div class="faq-body rte"
                  itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                  <span itemprop="text">{{ b.settings.a }}</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="faq-card">
            <div class="faq-head"><span><strong>How do I feed this?</strong></span><span aria-hidden="true">+</span></div>
            <div class="faq-body"><p>See the feeding guide above.</p></div>
          </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <!-- Fixed Add + Buy (mobile only) -->
    <div class="nm-sticky-cta" data-sticky-bar>
      <div class="grid">
        <button id="nm-sticky-add-{{ section.id }}" class="btn" type="button" data-sticky-add
          {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
          <span class="rte-inline">{% if curr_available %}{{ add_label }}{% else %}{{ oos_label }}{% endif %}</span>
        </button>
        <button id="nm-sticky-buy-{{ section.id }}" class="btn btn-buy" type="button" data-sticky-buy
          {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
          <span class="rte-inline">{{ buy_label }}</span>
        </button>
      </div>
    </div>

    <div class="nm-toast" aria-live="polite"></div>

  </div>
</div>

{%- comment -%} ═══════════════════════════════════════════════════════════
  SEO · AEO · AIO · SXO · GEO · LLM  —  Structured Data
  All fields configurable from Theme Editor → "SEO · AEO · GEO · LLM" header.
  Outputs: Product JSON-LD (Offer per variant), BreadcrumbList, FAQPage JSON-LD.
  Consumed by: Google Rich Results, ChatGPT, Perplexity, Gemini, Bing Copilot.
{%- endcomment -%}

{%- if s.seo_enable_product_schema -%}
  {%- assign bc_collection = product.collections.first -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ product.url | prepend: request.origin | json }},
  "description": {{ product.description | strip_html | strip_newlines | strip | json }},
  "sku": {{ curr_variant.sku | default: product.id | json }}
  {%- if product.featured_media -%}
  ,"image": [
    {%- for m in product.media limit: 5 -%}
      {%- if m.media_type == 'image' -%}
        {{ m | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ]
  {%- endif -%}
  {%- if s.seo_brand != blank -%}
  ,"brand": {"@type": "Brand","name": {{ s.seo_brand | json }}}
  {%- endif -%}
  {%- if s.seo_gtin != blank -%}
  ,"gtin13": {{ s.seo_gtin | json }}
  {%- endif -%}
  {%- if s.seo_mpn != blank -%}
  ,"mpn": {{ s.seo_mpn | json }}
  {%- endif -%}
  {%- if s.seo_color != blank -%}
  ,"color": {{ s.seo_color | json }}
  {%- endif -%}
  {%- if s.seo_material != blank -%}
  ,"material": {{ s.seo_material | json }}
  {%- endif -%}
  {%- if rating_val > 0 -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating_val }},
    "reviewCount": {{ product.metafields.reviews.rating_count | default: 1 }}
  }
  {%- endif -%}
  ,"offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ shop.currency | json }},
    "lowPrice": {{ product.price_min | divided_by: 100.0 }},
    "highPrice": {{ product.price_max | divided_by: 100.0 }},
    "offerCount": {{ product.variants | size }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "offers": [
      {%- for v in product.variants -%}
      {
        "@type": "Offer",
        "name": {{ v.title | json }},
        "sku": {{ v.sku | default: v.id | json }},
        "price": {{ v.price | divided_by: 100.0 }},
        "priceCurrency": {{ shop.currency | json }},
        "availability": "{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "url": {{ product.url | prepend: request.origin | append: '?variant=' | append: v.id | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
  {%- if bc_collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem","position": 1,"name": "Home","item": {{ request.origin | json }}},
    {"@type": "ListItem","position": 2,"name": {{ bc_collection.title | json }},"item": {{ bc_collection.url | prepend: request.origin | json }}},
    {"@type": "ListItem","position": 3,"name": {{ product.title | json }},"item": {{ product.url | prepend: request.origin | json }}}
  ]
}
</script>
  {%- endif -%}
{%- endif -%}

{%- if s.seo_enable_faq_schema and s.show_faqs -%}
  {%- assign faq_ld_count = 0 -%}
  {%- for b in section.blocks -%}
    {%- if b.type == 'faq' and b.settings.enabled -%}
      {%- assign faq_ld_count = faq_ld_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if faq_ld_count > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign faq_ld_out = 0 -%}
    {%- for b in section.blocks -%}
      {%- if b.type == 'faq' and b.settings.enabled -%}
        {%- assign faq_ld_out = faq_ld_out | plus: 1 -%}
    {"@type": "Question","name": {{ b.settings.q | strip_html | strip_newlines | strip | json }},"acceptedAnswer": {"@type": "Answer","text": {{ b.settings.a | strip_html | strip_newlines | strip | json }}}}{%- if faq_ld_out < faq_ld_count -%},{%- endif -%}
      {%- endif -%}
