  {%- endif -%}
  {%- if s.seo_canonical_override != blank -%}
  (function(){var h={{ s.seo_canonical_override | escape | json }};var l=document.querySelector('link[rel="canonical"]');if(l){l.setAttribute('href',h);}else{var n=document.createElement('link');n.rel='canonical';n.href=h;document.head.appendChild(n);}})();
  {%- endif -%}
})();
