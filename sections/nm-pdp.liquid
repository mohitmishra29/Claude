{% comment %}
NM PDP v6.0 — Complete Visual Redesign
- Gallery constrained: clamp(340px,42vw,510px) height — no towering images on desktop
- Premium CTA: orange-fill Add to Cart, brand-fill Buy Now, full-width, hover glow
- 55/45 grid balance, sticky buy box, better typography hierarchy
- Variant swatches with outline-selected state; chevron accordions
- Mobile: horizontal-scroll thumb strip, improved sticky bar
- All v5.0 features kept: OOS guard, always-open description, Product/FAQPage/
  BreadcrumbList JSON-LD, meta-description & canonical override from Theme Editor
{% endcomment %}

{%- liquid
  assign s    = section.settings
  assign prod = product

  if prod == blank
    echo '<div style="padding:20px;text-align:center">Select a product to preview this section.</div>'
    break
  endif

  assign show_top = false
  if s.show_top
    assign show_top = true
  endif

  assign show_gallery = false
  if show_top and s.show_gallery
    assign show_gallery = true
  endif

  assign show_summary = false
  if show_top and s.show_summary
    assign show_summary = true
  endif

  assign two_cols = false
  if show_gallery and show_summary
    assign two_cols = true
  endif

  assign add_label = s.add_label | default: '<p>Add to cart</p>'
  assign buy_label = s.buy_label | default: '<p>Buy now</p>'
  assign oos_label = s.oos_label | default: '<p>Out of stock</p>'

  assign mf_badge_enabled = false
  if prod.metafields.custom.badge_enabled
    if prod.metafields.custom.badge_enabled == true or prod.metafields.custom.badge_enabled.value == true
      assign mf_badge_enabled = true
    endif
  endif
  assign mf_badge_text_html = ''
  if prod.metafields.custom.badge_text
    if prod.metafields.custom.badge_text.value
      assign mf_badge_text_html = prod.metafields.custom.badge_text | metafield_tag
    else
      assign mf_badge_text_html = prod.metafields.custom.badge_text
    endif
  endif
  assign show_badge = false
  assign badge_html = ''
  if mf_badge_enabled and mf_badge_text_html != blank
    assign show_badge = true
    assign badge_html = mf_badge_text_html
  elsif s.badge_show_default
    assign show_badge = true
    assign badge_html = s.badge_rich
    if badge_html == blank
      assign badge_html = '<p>Best seller</p>'
    endif
  endif

  assign benefits_html = ''
  if prod.metafields.custom and prod.metafields.custom.benefits
    if prod.metafields.custom.benefits.value
      assign benefits_html = prod.metafields.custom.benefits | metafield_tag
    else
      assign benefits_html = prod.metafields.custom.benefits
    endif
  endif
  if benefits_html == blank
    assign benefits_html = s.benefits_rich
  endif

  assign rating_val = 0
  if product.metafields.reviews.rating and product.metafields.reviews.rating.value
    assign rating_val = product.metafields.reviews.rating.value
  elsif product.metafields.reviews.rating
    assign rating_val = product.metafields.reviews.rating
  elsif product.metafields.judgeme and product.metafields.judgeme.badge_average
    assign rating_val = product.metafields.judgeme.badge_average
  elsif product.metafields.loox and product.metafields.loox.avg_rating
    assign rating_val = product.metafields.loox.avg_rating
  endif
  assign rating_pct = 0
  if rating_val
    assign rating_pct = rating_val | times: 20
  endif

  assign curr_variant    = product.selected_or_first_available_variant
  assign compare_price   = curr_variant.compare_at_price
  assign actual_price    = curr_variant.price
  assign show_save_badge = false
  assign save_pct        = 0
  if compare_price > actual_price and compare_price > 0
    assign diff     = compare_price | minus: actual_price
    assign save_pct = diff | times: 100 | divided_by: compare_price
    assign show_save_badge = true
  endif

  assign curr_available = false
  if curr_variant.available
    assign curr_available = true
  endif

  assign any_trust = false
  for b in section.blocks
    if b.type == 'trust_badge' and b.settings.enabled
      assign any_trust = true
      break
    endif
  endfor
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ section.settings.font_family | default: 'Poppins' | url_encode }}:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ─── Design tokens ─────────────────────────────────────────────────────────── */
#nm-{{ section.id }}{
  --bg:     {{ s.bg    | default: '#eef1f7' }};
  --elev:   {{ s.elev  | default: '#ffffff' }};
  --text:   {{ s.text  | default: '#0e1320' }};
  --brand:  {{ s.brand | default: '#100146' }};
  --accent: {{ s.accent| default: '#ff7a1a' }};
  --radius: {{ s.radius | default: 18 }}px;
  --sd:     {{ s.shadow_depth | default: 8 }}px;
  --page:   {{ s.max_width | default: 1600 }}px;

  --btnBg:   {{ s.btn_bg   | default: '#ff7a1a' }};
  --btnText: {{ s.btn_text | default: '#ffffff' }};
  --buyBg:   {{ s.buy_bg   | default: '#100146' }};
  --buyText: {{ s.buy_text | default: '#ffffff' }};

  --badgeBg:   {{ s.badge_bg   | default: '#fff3e6' }};
  --badgeText: {{ s.badge_text | default: '#c95900' }};

  --light: rgba(255,255,255,.9);
  --dark:  rgba(0,14,38,.12);
  --outer: var(--sd) var(--sd) calc(var(--sd)*2) var(--dark),
           calc(var(--sd)*-1) calc(var(--sd)*-1) calc(var(--sd)*2) var(--light);
  --inset: inset 5px 5px 10px rgba(0,0,0,.09),
           inset -5px -5px 10px rgba(255,255,255,.8);
  --pill:  999px;
  --card-shadow: 0 1px 4px rgba(0,0,0,.05), 0 8px 28px rgba(0,0,0,.09);

  --bodyTextDesktop: {{ s.body_font_size_desktop | default: 16 }}px;
  --bodyTextMobile:  {{ s.body_font_size_mobile  | default: 15 }}px;

  font-family:'{{ s.font_family | default: "Poppins" }}',ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial;
  color:var(--text);
  background:var(--bg);
}
#nm-{{ section.id }} *{box-sizing:border-box}

/* ─── Page wrapper ──────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .page{
  max-width:var(--page);
  margin:0 auto;
  padding:24px 16px 0;
}

/* ─── Hero grid ─────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .wrap{
  display:grid;
  gap:clamp(16px,2.4vw,32px);
  grid-template-columns:{% if two_cols %}minmax(0,55fr) minmax(0,45fr){% else %}1fr{% endif %};
  align-items:start;
}

/* ─── Cards ─────────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .card{
  background:var(--elev);
  border-radius:var(--radius);
  box-shadow:var(--card-shadow);
}

/* ─── Titles ─────────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-desk-title{
  margin:0 0 10px;
  font-size:clamp(19px,1.9vw,26px);
  line-height:1.22;
  font-weight:800;
  letter-spacing:-.3px;
}
#nm-{{ section.id }} .nm-m-title{
  display:none;
  margin:10px 0 8px;
  font-size:20px;
  line-height:1.25;
  font-weight:800;
}

/* ─── Gallery ───────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .stage{
  position:relative;
  width:100%;
  /* Stage always fills its column — aspect-ratio sets the height proportionally.
     No max-height: that was centering the stage inside a wider column and
     creating white gaps on both sides. Column width is the only size limiter. */
  aspect-ratio:{{ s.gallery_ratio | default: '1 / 1' }};
  border-radius:var(--radius);
  overflow:hidden;
  background:#fff;
  box-shadow:var(--card-shadow);
}
#nm-{{ section.id }} .slide{
  position:absolute;inset:0;
  opacity:0;transition:opacity .28s ease;
}
#nm-{{ section.id }} .slide.active{opacity:1}
#nm-{{ section.id }} .stage picture,
#nm-{{ section.id }} .stage img,
#nm-{{ section.id }} .stage video{
  display:block;width:100%!important;height:100%!important;
  object-fit:{% if s.gallery_fit == 'cover' %}cover{% else %}contain{% endif %}!important;
  object-position:center!important;
  background:#fff;
}
#nm-{{ section.id }} .navBtn{
  position:absolute;top:50%;transform:translateY(-50%);
  width:40px;height:40px;border-radius:var(--pill);
  border:1px solid rgba(255,255,255,.5);
  background:rgba(255,255,255,.75);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  box-shadow:0 4px 16px rgba(0,0,0,.16);
  z-index:2;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background .18s,transform .18s;
}
#nm-{{ section.id }} .navBtn:hover{background:rgba(255,255,255,.95);transform:translateY(-50%) scale(1.06);}
#nm-{{ section.id }} .prev{left:12px}
#nm-{{ section.id }} .next{right:12px}

/* Thumbnails — 4-col grid on desktop, horizontal scroll on mobile */
#nm-{{ section.id }} .thumbs{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;margin-top:10px;
}
#nm-{{ section.id }} .thumb{
  aspect-ratio:1/1;border-radius:12px;overflow:hidden;
  background:var(--elev);box-shadow:var(--outer);cursor:pointer;
  border:2px solid transparent;transition:border-color .18s, box-shadow .18s;
  display:flex;align-items:center;justify-content:center;
}
#nm-{{ section.id }} .thumb.active{
  border-color:var(--accent);
  box-shadow:var(--inset);
}
#nm-{{ section.id }} .thumb img{
  width:100%;height:100%;object-fit:cover;display:block;
}
#nm-{{ section.id }} .dots{display:none}

/* ─── Summary (buy box) ─────────────────────────────────────────────────────── */
#nm-{{ section.id }} .summary{
  position:sticky;top:16px;
  padding:20px 22px 18px;
  align-self:start;
}

/* ─── Badge ("Best seller") ─────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-badge{
  display:inline-flex;align-items:center;gap:5px;
  background:var(--badgeBg);color:var(--badgeText);
  border-radius:var(--pill);
  padding:3px 11px;
  font-size:11px;font-weight:800;line-height:1.3;
  vertical-align:middle;white-space:nowrap;
  letter-spacing:.3px;text-transform:uppercase;
}
#nm-{{ section.id }} .nm-badge *{all:unset;display:inline;font:inherit;color:inherit;}

/* ─── Rating row ────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-rating{
  display:flex;align-items:center;flex-wrap:wrap;
  gap:8px;margin:6px 0 12px;
}
#nm-{{ section.id }} .stars{
  position:relative;display:inline-block;
  font-size:16px;letter-spacing:1.5px;line-height:1;
  white-space:nowrap;color:var(--accent)!important;
}
#nm-{{ section.id }} .stars::before{
  content:'★★★★★';opacity:.25;color:var(--accent)!important;
}
#nm-{{ section.id }} .stars-fill{
  position:absolute;left:0;top:0;bottom:0;
  width:0;overflow:hidden;pointer-events:none;
  color:var(--accent)!important;
}
#nm-{{ section.id }} .stars-fill::before{
  content:'★★★★★';color:var(--accent)!important;
}
#nm-{{ section.id }} .nm-rev-count{
  opacity:.6;font-size:12px;font-weight:500;
}

/* ─── Price row ─────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-price-row{
  display:flex;align-items:center;flex-wrap:wrap;
  gap:8px;margin:0 0 14px;
}
/* suppress theme's first "regular" price snippet */
#nm-{{ section.id }} .nm-price-row .price__container:first-child .price__regular{display:none!important;}
#nm-{{ section.id }} .nm-price-row .price-item--regular{
  font-size:14px;color:rgba(0,0,0,.4);text-decoration:line-through;font-weight:500;
}
#nm-{{ section.id }} .nm-price-row .price-item--sale,
#nm-{{ section.id }} .nm-price-row .price-item--last{
  font-size:clamp(20px,2vw,26px);font-weight:900;color:var(--text);letter-spacing:-.4px;
}
#nm-{{ section.id }} .nm-save-pill{
  display:inline-flex;align-items:center;
  background:var(--badgeBg);color:var(--badgeText);
  border-radius:var(--pill);padding:2px 10px;
  font-size:12px;font-weight:800;letter-spacing:.2px;
}

/* ─── Divider ───────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-divider{
  border:none;border-top:1px solid rgba(0,0,0,.07);
  margin:14px 0;
}

/* ─── Option labels ─────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .option{margin-top:14px}
#nm-{{ section.id }} .nm-opt-label{
  display:flex;align-items:center;gap:6px;
  font-size:12px;font-weight:700;
  margin:0 0 8px;letter-spacing:.2px;
  text-transform:uppercase;opacity:.7;
}
#nm-{{ section.id }} .nm-opt-val{
  font-weight:800;color:var(--brand);
  text-transform:none;opacity:1;letter-spacing:0;
}
#nm-{{ section.id }} .label .currentChoice{display:none}/* legacy compat */

/* ─── Swatches ──────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .swatches{display:flex;flex-wrap:wrap;gap:8px}
#nm-{{ section.id }} .sw{
  min-width:44px;padding:7px 14px;
  border:2px solid transparent;
  background:var(--elev);
  box-shadow:var(--outer);
  border-radius:var(--pill);
  cursor:pointer;font-weight:700;font-size:13px;
  line-height:1.2;
  transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease;
}
#nm-{{ section.id }} .sw:hover:not([aria-pressed="true"]){
  transform:translateY(-2px);
  box-shadow:var(--outer), 0 4px 10px rgba(0,0,0,.08);
}
#nm-{{ section.id }} .sw[aria-pressed="true"]{
  box-shadow:var(--inset);
  border-color:var(--brand);
  color:var(--brand);
  font-weight:800;
}

/* ─── Qty + CTA ─────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-qty-row{
  display:flex;align-items:center;gap:12px;
  margin:14px 0 10px;
}
#nm-{{ section.id }} .nm-qty-lbl{
  font-size:12px;font-weight:700;
  text-transform:uppercase;letter-spacing:.2px;opacity:.65;
  white-space:nowrap;
}
#nm-{{ section.id }} .stepper{
  display:flex;align-items:center;
  border-radius:var(--pill);overflow:hidden;
  background:var(--elev);box-shadow:var(--outer);
}
#nm-{{ section.id }} .stepper button{
  border:none;background:transparent;
  padding:8px 14px;font-weight:800;cursor:pointer;
  font-size:16px;line-height:1;
  transition:background .15s;
}
#nm-{{ section.id }} .stepper button:hover{background:rgba(0,0,0,.04)}
#nm-{{ section.id }} .stepper input{
  width:42px;text-align:center;border:none;background:transparent;
  padding:8px 0;font-weight:800;font-size:14px;line-height:1;
}

/* ─── CTA buttons ───────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-cta-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
#nm-{{ section.id }} .btn{
  border:none!important;outline:none!important;
  border-radius:var(--pill);
  padding:13px 16px;
  font-weight:800;font-size:14px;line-height:1;
  text-align:center;cursor:pointer;
  transition:transform .18s ease, box-shadow .18s ease, opacity .18s;
  position:relative;overflow:hidden;
}
#nm-{{ section.id }} .nm-btn-add{
  background:var(--btnBg);color:var(--btnText);
  box-shadow:0 4px 14px rgba(0,0,0,.18), 0 1px 4px rgba(0,0,0,.1);
}
#nm-{{ section.id }} .nm-btn-add:hover:not(:disabled){
  transform:translateY(-2px);
  box-shadow:0 8px 22px rgba(0,0,0,.24), 0 2px 6px rgba(0,0,0,.1);
}
#nm-{{ section.id }} .nm-btn-buy{
  background:var(--buyBg);color:var(--buyText);
  box-shadow:0 4px 14px rgba(0,0,0,.15), 0 1px 4px rgba(0,0,0,.08);
}
#nm-{{ section.id }} .nm-btn-buy:hover:not(:disabled){
  transform:translateY(-2px);
  box-shadow:0 8px 22px rgba(0,0,0,.22), 0 2px 6px rgba(0,0,0,.08);
}
#nm-{{ section.id }} .btn:active{transform:translateY(0)!important}
#nm-{{ section.id }} .btn .rte-inline *{
  all:unset;display:inline;line-height:inherit;font:inherit;color:inherit;font-weight:inherit;
}
/* OOS disabled state */
#nm-{{ section.id }} .btn:disabled,
#nm-{{ section.id }} .btn[disabled]{
  opacity:.38;cursor:not-allowed;pointer-events:none;
  box-shadow:var(--inset)!important;transform:none!important;
}
/* OOS message */
#nm-{{ section.id }} .nm-oos-msg{
  display:none;margin:8px 0 0;
  padding:7px 14px;border-radius:10px;
  background:rgba(192,57,43,.07);
  color:#c0392b;font-size:12px;font-weight:700;line-height:1.4;
}
#nm-{{ section.id }} .nm-oos-msg.visible{display:block}

/* ─── Benefits ──────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-benefits-card{
  margin-top:14px;
  border-radius:14px;
  overflow:hidden;
  box-shadow:var(--card-shadow);
  background:var(--elev);
}
#nm-{{ section.id }} .nm-benefits-head{
  padding:10px 14px;
  background:linear-gradient(135deg,var(--brand),color-mix(in srgb,var(--brand) 60%,var(--accent)));
  color:#fff;font-size:13px;font-weight:800;letter-spacing:.3px;
}
#nm-{{ section.id }} .nm-benefits-body{
  padding:12px 14px;
  font-size:var(--bodyTextMobile);line-height:1.55;
}
@media(min-width:768px){
  #nm-{{ section.id }} .nm-benefits-body{font-size:var(--bodyTextDesktop)!important}
}

/* ─── Trust badges ──────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-trust-badges{
  margin-top:12px;
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
}
#nm-{{ section.id }} .nm-trust-badge{
  display:flex;align-items:center;gap:8px;
  border-radius:12px;padding:8px 12px;
  box-shadow:var(--outer);
  font-size:12px;font-weight:600;line-height:1.3;
  min-height:42px;word-break:break-word;
}
#nm-{{ section.id }} .nm-trust-ic{
  flex-shrink:0;width:26px;height:26px;
  border-radius:999px;overflow:hidden;
  box-shadow:var(--inset);background:rgba(255,255,255,.6);
  display:flex;align-items:center;justify-content:center;
}
#nm-{{ section.id }} .nm-trust-ic img{display:block;width:100%;height:100%;object-fit:contain;}
#nm-{{ section.id }} .nm-trust-text p{margin:0;display:inline;font-size:inherit;line-height:inherit;font-weight:inherit;color:inherit;}

/* ─── Page sections ─────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-section{margin:22px 0}

/* ─── Description (always open) ────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-desc-card{
  border-top:4px solid var(--accent);
  padding:18px 22px 20px;
}
#nm-{{ section.id }} .nm-desc-header{
  display:flex;align-items:center;gap:10px;margin:0 0 14px;
}
#nm-{{ section.id }} .nm-desc-header h2{
  margin:0;line-height:1.3;font-weight:800;
  font-size:{{ s.desc_title_size | default: 14 }}px;
}
#nm-{{ section.id }} .nm-desc-body{
  font-size:var(--bodyTextMobile);line-height:1.6;
}
@media(min-width:768px){
  #nm-{{ section.id }} .nm-desc-body{font-size:var(--bodyTextDesktop)!important}
}

/* ─── Accordion (Mfg) ───────────────────────────────────────────────────────── */
#nm-{{ section.id }} .accordion{display:grid;gap:10px}
#nm-{{ section.id }} .acc-card{
  background:var(--elev);box-shadow:var(--card-shadow);
  border-radius:14px;overflow:hidden;
  border:1px solid rgba(0,0,0,.04);
}
#nm-{{ section.id }} .acc-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 16px;cursor:pointer;
  font-weight:800;font-size:14px;line-height:1.3;
  user-select:none;
}
#nm-{{ section.id }} .acc-head .left{display:flex;align-items:center;gap:10px}
#nm-{{ section.id }} .nm-chevron{
  flex-shrink:0;transition:transform .25s ease;
  color:rgba(0,0,0,.4);
}
#nm-{{ section.id }} .acc-card.open .nm-chevron{transform:rotate(180deg)}
#nm-{{ section.id }} .acc-body{
  display:none;padding:13px 16px;
  border-top:1px solid rgba(0,0,0,.05);
}
#nm-{{ section.id }} .acc-card.open .acc-body{display:block}
#nm-{{ section.id }} .nm-mfg-body{font-size:var(--bodyTextMobile);line-height:1.6}
@media(min-width:768px){
  #nm-{{ section.id }} .nm-mfg-body{font-size:var(--bodyTextDesktop)!important}
}

/* ─── FAQ ───────────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-faq-head-row{
  display:flex;align-items:center;justify-content:space-between;
  margin:0 0 12px;flex-wrap:wrap;row-gap:8px;
}
#nm-{{ section.id }} .nm-faq-title{
  font-weight:800;font-size:16px;line-height:1.3;
}
#nm-{{ section.id }} .nm-faq-controls{display:flex;gap:8px;flex-wrap:wrap}
#nm-{{ section.id }} .nm-faq-btn{
  border:none;border-radius:var(--pill);
  padding:7px 14px;font-size:12px;font-weight:700;
  cursor:pointer;background:var(--elev);
  box-shadow:var(--outer);
  transition:box-shadow .16s;
}
#nm-{{ section.id }} .nm-faq-btn:active{box-shadow:var(--inset)}

#nm-{{ section.id }} .faq-accordion{display:grid;gap:8px}
#nm-{{ section.id }} .faq-card{
  background:var(--elev);box-shadow:var(--card-shadow);
  border-radius:14px;overflow:hidden;
  border:1px solid rgba(0,0,0,.04);
}
#nm-{{ section.id }} .faq-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:13px 16px;cursor:pointer;
  font-weight:700;font-size:14px;line-height:1.35;
  user-select:none;gap:10px;
}
#nm-{{ section.id }} .faq-head .nm-chevron{
  flex-shrink:0;transition:transform .25s ease;
  color:rgba(0,0,0,.35);
}
#nm-{{ section.id }} .faq-card.open .faq-head .nm-chevron{transform:rotate(180deg)}
#nm-{{ section.id }} .faq-body{
  display:none;padding:12px 16px;
  border-top:1px solid rgba(0,0,0,.05);
  font-size:var(--bodyTextMobile);line-height:1.6;
}
#nm-{{ section.id }} .faq-card.open .faq-body{display:block}
@media(min-width:768px){
  #nm-{{ section.id }} .faq-body{font-size:var(--bodyTextDesktop)!important}
}

/* ─── Banner ─────────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-banner{margin:20px 0}
#nm-{{ section.id }} .nm-banner a{
  display:block;border-radius:var(--radius);overflow:hidden;
  box-shadow:var(--card-shadow);
}
#nm-{{ section.id }} .nm-banner img{
  display:block;width:100%;object-fit:cover;
}
#nm-{{ section.id }} .nm-banner .only-mob{display:none}
#nm-{{ section.id }} .nm-banner .only-desk{display:block}

/* ─── Sticky mobile CTA bar ─────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-sticky-cta{
  display:none;position:fixed;left:0;right:0;bottom:0;
  padding:10px 14px;z-index:999;
  background:rgba(255,255,255,.38);
  border-top:1px solid rgba(0,0,0,.07);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  box-shadow:0 -8px 24px rgba(0,0,0,.1);
}
#nm-{{ section.id }} .nm-sticky-cta .grid{
  display:grid;grid-template-columns:1fr 1fr;gap:10px;
}
#nm-{{ section.id }} .nm-sticky-cta .btn{width:100%;padding:12px 10px;font-size:13px}

/* ─── Toast ─────────────────────────────────────────────────────────────────── */
#nm-{{ section.id }} .nm-toast{
  position:fixed;left:50%;bottom:92px;transform:translateX(-50%);
  background:var(--elev);box-shadow:var(--card-shadow);
  border-radius:12px;padding:10px 16px;
  font-weight:700;font-size:13px;z-index:1001;
  transition:opacity .25s;opacity:0;white-space:nowrap;
}

/* ─── Responsive ─────────────────────────────────────────────────────────────── */
@media(max-width:990px){
  #nm-{{ section.id }} .summary{position:static}
}
@media(max-width:768px){
  #nm-{{ section.id }} .nm-m-title{display:block}
  #nm-{{ section.id }} .nm-desk-title{display:none}
  #nm-{{ section.id }} .navBtn{display:none}
  #nm-{{ section.id }} .wrap{display:block}
  #nm-{{ section.id }} .page{padding-bottom:88px}
  #nm-{{ section.id }} .nm-sticky-cta{display:block}
  #nm-{{ section.id }} .nm-cta-grid{display:none!important}
  #nm-{{ section.id }} .nm-banner img{height:{{ s.banner_h_mobile | default: 220 }}px}
  #nm-{{ section.id }} .nm-banner .only-mob{display:block}
  #nm-{{ section.id }} .nm-banner .only-desk{display:none}
  /* Horizontal-scroll thumb strip on mobile */
  #nm-{{ section.id }} .thumbs{
    display:flex!important;
    overflow-x:auto;
    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
    gap:8px;
    grid-template-columns:unset;
    padding-bottom:4px;
  }
  #nm-{{ section.id }} .thumbs::-webkit-scrollbar{display:none}
  #nm-{{ section.id }} .thumb{
    flex-shrink:0;width:56px;height:56px;
    border-radius:10px;aspect-ratio:unset;
  }
  #nm-{{ section.id }} .summary{padding:14px 16px}
}
@media(min-width:769px){
  #nm-{{ section.id }} .nm-banner img{height:{{ s.banner_h_desktop | default: 360 }}px}
}
</style>

<div id="nm-{{ section.id }}">
  <div class="page">

    <h1 class="nm-m-title">{{ product.title }}</h1>

    {% if show_top %}
    <div class="wrap">

      {% if show_gallery %}
      <section>
        <div class="stage" data-stage>
          {% for m in product.media limit: 12 %}
            <div class="slide {% if forloop.first %}active{% endif %}">
              {% if m.media_type == 'image' %}
                {{ m | image_url: width: 1400 | image_tag: widths: '360,540,720,960,1200,1400', sizes: '(max-width:768px) 100vw, (max-width:1200px) 50vw, 560px', loading: 'lazy', alt: m.alt | escape }}
              {% else %}
                {{ m | media_tag: image_size: '1400x', autoplay: false, loop: false, controls: true }}
              {% endif %}
            </div>
          {% endfor %}
          <button class="navBtn prev" data-prev aria-label="Previous">
            <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd"/></svg>
          </button>
          <button class="navBtn next" data-next aria-label="Next">
            <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>
          </button>
        </div>
        <div class="thumbs">
          {% for m in product.media limit: 12 %}
            <button class="thumb {% if forloop.first %}active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}">
              {{ m | image_url: width: 240 | image_tag: widths: '120,180,240', sizes: '60px', loading: 'lazy', alt: m.alt | escape }}
            </button>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if show_summary %}
      <aside class="card summary">
        <h1 class="nm-desk-title">{{ product.title }}</h1>

        <div class="nm-rating">
          <span class="stars" aria-label="{{ rating_val }} out of 5 stars">
            <span class="stars-fill" style="width:{{ rating_pct }}%" data-rating-pct="{{ rating_pct }}"></span>
          </span>
          {% if product.metafields.reviews.rating_count %}
            <span class="nm-rev-count">{{ product.metafields.reviews.rating_count }} reviews</span>
          {% endif %}
          {% if show_badge %}
            <span class="nm-badge">{{ badge_html }}</span>
          {% endif %}
        </div>

        <div class="nm-price-row">
          {% render 'price', product: product, use_variant: true, price_class: 'price--large' %}
          {% if show_save_badge %}
            <span class="nm-save-pill">-{{ save_pct }}%</span>
          {% endif %}
        </div>

        <hr class="nm-divider">

        {% form 'product', product, id: 'nm-form-{{ section.id }}', class: 'product-form', novalidate: 'novalidate' %}
          {% if product.has_only_default_variant == false %}
            {% for opt in product.options_with_values %}
              {%- assign opt_index0 = forloop.index0 -%}
              <div class="option">
                <div class="nm-opt-label" data-opt-label="{{ opt_index0 }}">
                  {{ opt.name }}:&nbsp;<span class="nm-opt-val" data-current-choice="{{ opt_index0 }}">{{ opt.selected_value }}</span>
                  <span class="label" style="display:none"><span class="currentChoice" data-current-choice="{{ opt_index0 }}"></span></span>
                </div>
                <div class="swatches" data-opt="{{ opt_index0 }}">
                  {% for val in opt.values %}
                    <button type="button" class="sw"
                      aria-pressed="{% if opt.selected_value == val %}true{% else %}false{% endif %}"
                      data-value="{{ val | escape }}">{{ val }}</button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
            <select name="id" id="nm-variant-{{ section.id }}" hidden>
              {% for v in product.variants %}
                <option value="{{ v.id }}"
                  {% if v == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless v.available %}disabled{% endunless %}>{{ v.title }}</option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <hr class="nm-divider">

          <div class="nm-qty-row">
            <span class="nm-qty-lbl">Qty</span>
            <div class="stepper" data-stepper>
              <button type="button" aria-label="Decrease">−</button>
              <input name="quantity" value="1" inputmode="numeric" pattern="[0-9]*" aria-label="Quantity">
              <button type="button" aria-label="Increase">+</button>
            </div>
          </div>

          <div class="nm-cta-grid">
            <button class="btn nm-btn-add" type="submit" name="add"
              {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
              <span class="rte-inline">{% if curr_available %}{{ add_label }}{% else %}{{ oos_label }}{% endif %}</span>
            </button>
            <button class="btn nm-btn-buy" type="button" data-buy
              {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
              <span class="rte-inline">{{ buy_label }}</span>
            </button>
          </div>

          <div class="nm-oos-msg {% unless curr_available %}visible{% endunless %}" role="alert">
            {{ s.oos_message | default: 'Currently out of stock — please check back soon.' }}
          </div>
        {% endform %}

        {% if s.show_benefits and benefits_html != blank %}
          <div class="nm-benefits-card">
            <div class="nm-benefits-head">{{ s.benefits_title | default: 'Benefits' }}</div>
            <div class="nm-benefits-body rte">{{ benefits_html }}</div>
          </div>
        {% endif %}

        {% if any_trust %}
          <div class="nm-trust-badges">
            {% for b in section.blocks %}
              {% if b.type == 'trust_badge' and b.settings.enabled %}
                <div class="nm-trust-badge"
                  style="background:{{ b.settings.badge_bg | default: s.elev }};color:{{ b.settings.badge_text_color | default: s.text }};">
                  {% if b.settings.badge_icon != blank %}
                    <span class="nm-trust-ic">
                      <img src="{{ b.settings.badge_icon | image_url: width: 64 }}" alt="" width="26" height="26" loading="lazy">
                    </span>
                  {% endif %}
                  <span class="nm-trust-text">{{ b.settings.badge_text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </aside>
      {% endif %}

    </div>
    {% endif %}

    {%- if s.show_icons_snippet -%}{%- render 'icons-neumorphic' -%}{%- endif -%}

    {% if s.show_banner %}{% if s.banner_img_desktop != blank or s.banner_img_mobile != blank %}
      <section class="nm-banner">
        <a href="{{ s.banner_link | default: '#' }}"
          {% if s.banner_new_tab %}target="_blank" rel="noopener"{% endif %}
          aria-label="{{ s.banner_alt | escape }}">
          {% if s.banner_img_desktop %}
            <img class="only-desk" src="{{ s.banner_img_desktop | image_url: width: 2000 }}" alt="{{ s.banner_alt | escape }}">
          {% endif %}
          {% if s.banner_img_mobile %}
            <img class="only-mob" src="{{ s.banner_img_mobile | image_url: width: 1200 }}" alt="{{ s.banner_alt | escape }}">
          {% endif %}
        </a>
      </section>
    {% endif %}{% endif %}

    {%- comment -%}── Description — always open ──{%- endcomment -%}
    {% if s.show_desc %}
    <section class="nm-section" itemscope itemprop="description">
      <div class="card nm-desc-card">
        <div class="nm-desc-header">
          {% if s.desc_icon != blank %}
            <img src="{{ s.desc_icon | image_url: width: 48 }}" alt="" width="22" height="22" loading="lazy">
          {% endif %}
          <h2>{{ s.desc_title | default: 'Product Description' }}</h2>
        </div>
        <div class="nm-desc-body rte">
          {{ product.description | default: '<p>Add your product description in Admin.</p>' }}
        </div>
      </div>
    </section>
    {% endif %}

    {%- comment -%}── Manufacturing Details — accordion ──{%- endcomment -%}
    {% if s.show_mfg %}
    <section class="nm-section">
      <div class="accordion">
        <div class="acc-card" data-acc>
          <div class="acc-head">
            <div class="left">
              {% if s.mfg_icon != blank %}
                <img src="{{ s.mfg_icon | image_url: width: 48 }}" alt="" width="22" height="22" loading="lazy">
              {% endif %}
              <span style="font-size:{{ s.mfg_title_size | default: 14 }}px;font-weight:800;line-height:1.3">
                {{ s.mfg_title | default: 'Manufacturing Details' }}
              </span>
            </div>
            <svg class="nm-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
          </div>
          <div class="acc-body">
            {%- assign any_mfg = false -%}
            {%- for b in section.blocks -%}
              {%- if b.type == 'mfg' and b.settings.enabled -%}{%- assign any_mfg = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {% if s.use_mfg_fallback or any_mfg == false %}
              <div class="nm-mfg-body rte">
                {{ s.mfg_fallback_rich1 }}{{ s.mfg_fallback_rich2 }}{{ s.mfg_fallback_rich3 }}
              </div>
            {% else %}
              <div class="nm-mfg-body rte">
                <ul style="margin:0;padding-left:18px">
                  {% for b in section.blocks %}
                    {% if b.type == 'mfg' and b.settings.enabled %}
                      <li><strong>{{ b.settings.title }}</strong>: {{ b.settings.text }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
    {% endif %}

    {% if s.show_faqs %}
    <section class="nm-section">
      <div class="nm-faq-head-row">
        <div class="nm-faq-title rte">{{ s.faqs_title_rich }}</div>
        <div class="nm-faq-controls">
          <button class="nm-faq-btn" data-expand>Expand all</button>
          <button class="nm-faq-btn" data-collapse>Collapse all</button>
        </div>
      </div>
      <div class="faq-accordion" itemscope itemtype="https://schema.org/FAQPage">
        {%- assign any_faq = false -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'faq' and b.settings.enabled -%}{%- assign any_faq = true -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {% if any_faq %}
          {% for b in section.blocks %}
            {% if b.type == 'faq' and b.settings.enabled %}
              <div class="faq-card" {{ b.shopify_attributes }}
                itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                <div class="faq-head">
                  <span class="rte" itemprop="name">{{ b.settings.q }}</span>
                  <svg class="nm-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
                </div>
                <div class="faq-body rte" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                  <span itemprop="text">{{ b.settings.a }}</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="faq-card">
            <div class="faq-head">
              <span><strong>How do I use this product?</strong></span>
              <svg class="nm-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
            </div>
            <div class="faq-body"><p>See the feeding guide included on the packaging.</p></div>
          </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <!-- Sticky mobile CTA bar -->
    <div class="nm-sticky-cta" data-sticky-bar>
      <div class="grid">
        <button id="nm-sticky-add-{{ section.id }}" class="btn nm-btn-add" type="button" data-sticky-add
          {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
          <span class="rte-inline">{% if curr_available %}{{ add_label }}{% else %}{{ oos_label }}{% endif %}</span>
        </button>
        <button id="nm-sticky-buy-{{ section.id }}" class="btn nm-btn-buy" type="button" data-sticky-buy
          {% unless curr_available %}disabled aria-disabled="true"{% endunless %}>
          <span class="rte-inline">{{ buy_label }}</span>
        </button>
      </div>
    </div>

    <div class="nm-toast" aria-live="polite"></div>

  </div><!-- /.page -->
</div><!-- /#nm-section -->

{%- comment -%}── SEO · AEO · GEO · LLM Structured Data ──{%- endcomment -%}
