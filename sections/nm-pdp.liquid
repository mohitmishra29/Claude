<script>
(function(){
  const root=document.querySelector('#nm-{{ section.id }}');
  if(!root||root.dataset.nmInit==='1') return;
  root.dataset.nmInit='1';

  /* ── Gallery ── */
  const stage=root.querySelector('[data-stage]');
  const slides=[...root.querySelectorAll('.stage .slide')];
  const thumbs=[...root.querySelectorAll('.thumbs .thumb')];
  const prev=root.querySelector('[data-prev]');
  const next=root.querySelector('[data-next]');
  let idx=0;
  const show=(n)=>{
    if(!slides.length) return;
    idx=(n+slides.length)%slides.length;
    slides.forEach((s,i)=>s.classList.toggle('active',i===idx));
    thumbs.forEach((t,i)=>t?.classList.toggle('active',i===idx));
  };
  thumbs.forEach((t,i)=>t.addEventListener('click',()=>show(i)));
  prev?.addEventListener('click',()=>show(idx-1));
  next?.addEventListener('click',()=>show(idx+1));
  if(stage){
    let sx=0,dx=0,drag=false;
    const gx=e=>e.touches?e.touches[0].clientX:e.clientX;
    stage.addEventListener('touchstart',e=>{drag=true;sx=gx(e);},{passive:true});
    stage.addEventListener('touchmove',e=>{if(drag)dx=gx(e)-sx;},{passive:true});
    stage.addEventListener('touchend',()=>{if(drag&&Math.abs(dx)>40)show(idx+(dx<0?1:-1));drag=false;dx=0;});
    stage.addEventListener('mousedown',e=>{drag=true;sx=gx(e);});
    window.addEventListener('mousemove',e=>{if(drag)dx=gx(e)-sx;});
    window.addEventListener('mouseup',()=>{if(drag&&Math.abs(dx)>40)show(idx+(dx<0?1:-1));drag=false;dx=0;});
  }

  /* ── Variants ── */
  const select=root.querySelector('#nm-variant-{{ section.id }}');
  const variants={{ product.variants | json }};
  const groups=[...root.querySelectorAll('.swatches')];
  const ADD_LABEL={{ add_label | json }};
  const OOS_LABEL={{ oos_label | json }};

  function currentChoice(){
    return groups.map(g=>{
      const on=g.querySelector('.sw[aria-pressed="true"]');
      return on?(on.dataset.value||on.textContent.trim()):'';
    });
  }

  function updateLabels(){
    groups.forEach(g=>{
      const i=g.dataset.opt;
      const sel=g.querySelector('.sw[aria-pressed="true"]');
      const txt=sel?(sel.dataset.value||sel.textContent.trim()):'';
      root.querySelectorAll(`[data-current-choice="${i}"]`).forEach(el=>{if(txt)el.textContent=txt;});
    });
  }

  function updateAvailability(avail){
    const msg=root.querySelector('.nm-oos-msg');
    const adds=[...root.querySelectorAll('button[name="add"],#nm-sticky-add-{{ section.id }}')];
    const buys=[...root.querySelectorAll('[data-buy],#nm-sticky-buy-{{ section.id }}')];
    adds.forEach(b=>{
      b.disabled=!avail;b.setAttribute('aria-disabled',avail?'false':'true');
      const inner=b.querySelector('.rte-inline');
      if(inner) inner.innerHTML=avail?ADD_LABEL:OOS_LABEL;
    });
    buys.forEach(b=>{b.disabled=!avail;b.setAttribute('aria-disabled',avail?'false':'true');});
    if(msg) msg.classList.toggle('visible',!avail);
  }

  function setVariant(){
    if(!select) return;
    const choice=currentChoice();
    let match=variants.find(v=>(v.options||[]).every((o,i)=>
      String(o||'').toLowerCase().trim()===String(choice[i]||'').toLowerCase().trim()
    ));
    if(!match&&variants.length) match=variants[0];
    if(match){
      select.value=String(match.id);
      select.dispatchEvent(new Event('change',{bubbles:true}));
      updateAvailability(!!match.available);
    }
    updateLabels();
  }

  groups.forEach(g=>g.addEventListener('click',e=>{
    const b=e.target.closest('.sw');if(!b)return;
    g.querySelectorAll('.sw').forEach(x=>x.setAttribute('aria-pressed','false'));
    b.setAttribute('aria-pressed','true');
    setVariant();
  }));

  /* ── Qty stepper ── */
  const stepper=root.querySelector('.stepper');
  if(stepper){
    const inp=stepper.querySelector('input[name="quantity"]');
    const [dec,inc]=stepper.querySelectorAll('button');
    const clamp=n=>Math.max(1,Math.min(99,n|0||1));
    dec.addEventListener('click',()=>inp.value=clamp(+inp.value-1));
    inc.addEventListener('click',()=>inp.value=clamp(+inp.value+1));
    inp.addEventListener('input',()=>inp.value=inp.value.replace(/[^0-9]/g,''));
    inp.addEventListener('blur',()=>inp.value=clamp(+inp.value));
  }

  /* ── Toast ── */
  function toast(msg){
    let t=root.querySelector('.nm-toast');
    if(!t){t=document.createElement('div');t.className='nm-toast';root.appendChild(t);}
    t.textContent=msg;t.style.opacity='1';
    clearTimeout(t._h);t._h=setTimeout(()=>t.style.opacity='0',1700);
  }

  function safeRenderCart(state){
    const sec=state&&state.sections?state.sections:state;
    const drawer=document.querySelector('cart-drawer');
    const notif=document.querySelector('cart-notification');
    if(drawer&&typeof drawer.renderContents==='function'){try{drawer.renderContents(state);drawer.open&&drawer.open();return;}catch(_){}}
    if(notif&&typeof notif.renderContents==='function'){try{notif.renderContents(state);notif.open&&notif.open();return;}catch(_){}}
    if(drawer&&sec&&sec['cart-drawer']){drawer.innerHTML=sec['cart-drawer'];drawer.open&&drawer.open();return;}
    if(notif&&sec&&sec['cart-notification']){notif.innerHTML=sec['cart-notification'];notif.open&&notif.open();return;}
    toast('Added to cart');
  }

  async function addToCartWithSections(vid,qty){
    const fd=new FormData();
    fd.append('id',String(vid));fd.append('quantity',String(Math.max(1,Number(qty)||1)));
    fd.append('form_type','product');
    fd.append('sections','cart-drawer,cart-icon-bubble,cart-notification');
    fd.append('sections_url',window.location.pathname);
    const res=await fetch('/cart/add.js',{method:'POST',body:fd,credentials:'same-origin',headers:{'Accept':'application/json'}});
    let data=null;try{data=await res.json();}catch(_){}
    if(!res.ok) throw new Error((data&&(data.message||data.description))||'Add to cart failed');
    if(!data||!data.sections){
      try{const r=await fetch('/?sections=cart-drawer,cart-icon-bubble,cart-notification',{credentials:'same-origin'});data={sections:await r.json()};}catch(_){}
    }
    return data;
  }

  /* ── Add to cart ── */
  const form=root.querySelector('#nm-form-{{ section.id }}');
  const addBtn=form?.querySelector('button[type="submit"][name="add"]');
  const buyBtn=form?.querySelector('[data-buy]');

  async function handleAjaxAdd(e){
    e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
    if(addBtn&&addBtn.disabled) return false;
    try{
      const sel=root.querySelector('#nm-variant-{{ section.id }}');
      const qtyInp=root.querySelector('input[name="quantity"]');
      const vid=sel?.value||String({{ product.selected_or_first_available_variant.id }});
      const qty=qtyInp?Math.max(1,parseInt(qtyInp.value||'1',10)):1;
      safeRenderCart(await addToCartWithSections(vid,qty));
    }catch(err){console.error(err);toast(err.message||'Couldn\'t add. Try again.');}
    return false;
  }
  if(form&&!form.dataset.nmAjax){form.dataset.nmAjax='1';form.addEventListener('submit',handleAjaxAdd,{capture:true});}
  if(addBtn&&!addBtn.dataset.nmAjax){addBtn.dataset.nmAjax='1';addBtn.addEventListener('click',handleAjaxAdd,{capture:true});}
  document.addEventListener('submit',e=>{
    const t=e.target;if(!t)return;
    if(t.closest&&(t.closest('#nm-{{ section.id }} #nm-form-{{ section.id }}')||t.closest('#nm-{{ section.id }} button[name="add"]'))) handleAjaxAdd(e);
  },true);

  /* ── Buy now ── */
  async function doBuyNow(e){
    e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();
    if(buyBtn&&buyBtn.disabled) return false;
    try{
      const sel=root.querySelector('#nm-variant-{{ section.id }}');
      const qtyInp=root.querySelector('input[name="quantity"]');
      const vid=sel?.value||String({{ product.selected_or_first_available_variant.id }});
      const qty=qtyInp?Math.max(1,parseInt(qtyInp.value||'1',10)):1;
      await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},credentials:'same-origin',body:JSON.stringify({id:Number(vid),quantity:Number(qty)})});
      window.location.href='/checkout';
    }catch(err){console.error(err);toast('Buy now failed');}
    return false;
  }
  if(buyBtn&&!buyBtn.dataset.nmBound){
    buyBtn.dataset.nmBound='1';
    buyBtn.addEventListener('click',doBuyNow,{capture:true});
    buyBtn.addEventListener('pointerup',doBuyNow,{capture:true});
  }
  document.addEventListener('click',e=>{
    const t=e.target;if(!t)return;
    if(t.closest&&t.closest('#nm-{{ section.id }} [data-buy]')) doBuyNow(e);
  },true);
  document.addEventListener('pointerup',e=>{
    const t=e.target;if(!t)return;
    if(t.closest&&t.closest('#nm-{{ section.id }} [data-buy]')) doBuyNow(e);
  },true);

  /* ── Sticky bar lift ── */
  const bar=root.querySelector('[data-sticky-bar]');
  const footer=document.querySelector('#shopify-section-footer')||document.querySelector('footer');
  if(bar&&'IntersectionObserver'in window&&footer){
    new IntersectionObserver(entries=>entries.forEach(en=>bar.style.bottom=(en.isIntersecting?(en.target.getBoundingClientRect().height||0):0)+'px'),{rootMargin:'0px',threshold:0}).observe(footer);
  }

  /* ── Sticky add ── */
  const stickyAdd=root.querySelector('#nm-sticky-add-{{ section.id }}');
  const stickyBuy=root.querySelector('#nm-sticky-buy-{{ section.id }}');

  if(stickyAdd&&!stickyAdd.dataset.nmBound){
    stickyAdd.dataset.nmBound='1';
    window.__NM_ADD_LOCK=window.__NM_ADD_LOCK||false;
    window.__NM_LAST_ADD=window.__NM_LAST_ADD||{id:null,t:0};
    let adding=false;
    const shield=e=>{if(window.__NM_ADD_LOCK){e.stopPropagation();e.stopImmediatePropagation();e.preventDefault();}};
    const handleAdd=async evt=>{
      evt.preventDefault();evt.stopPropagation();evt.stopImmediatePropagation();
      if(stickyAdd.disabled||window.__NM_ADD_LOCK||adding) return;
      window.__NM_ADD_LOCK=true;adding=true;stickyAdd.disabled=true;
      document.addEventListener('click',shield,true);document.addEventListener('submit',shield,true);document.addEventListener('touchend',shield,true);
      try{
        const sel=root.querySelector('#nm-variant-{{ section.id }}');
        const qtyInp=root.querySelector('input[name="quantity"]');
        let vid=sel?.value;
        if(!vid&&sel){const f=sel.querySelector('option:not([disabled])');if(f){vid=f.value;sel.value=f.value;}}
        if(!vid) vid=String({{ product.selected_or_first_available_variant.id }});
        const qty=qtyInp?Math.max(1,parseInt(qtyInp.value||'1',10)):1;
        const now=Date.now();
        if(window.__NM_LAST_ADD.id===vid&&(now-window.__NM_LAST_ADD.t)<1200) return;
        safeRenderCart(await addToCartWithSections(vid,qty));
        window.__NM_LAST_ADD={id:vid,t:now};
      }catch(e){console.error(e);toast(e.message||'Couldn\'t add. Try again.');}
      finally{
        setTimeout(()=>window.__NM_ADD_LOCK=false,600);
        const curEl=root.querySelector('#nm-variant-{{ section.id }}');
        const curId=curEl?String(curEl.value):null;
        const curV=curId?variants.find(v=>String(v.id)===curId):null;
        adding=false;
        if(curV&&curV.available) stickyAdd.disabled=false;
        document.removeEventListener('click',shield,true);document.removeEventListener('submit',shield,true);document.removeEventListener('touchend',shield,true);
      }
    };
    stickyAdd.addEventListener('pointerup',handleAdd,{capture:true});
    const sup=e=>{e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();};
    stickyAdd.addEventListener('click',sup,{capture:true});
    stickyAdd.addEventListener('touchend',sup,{capture:true});
    stickyAdd.addEventListener('pointerdown',sup,{capture:true});
  }

  if(stickyBuy&&!stickyBuy.dataset.nmBound){
    stickyBuy.dataset.nmBound='1';
    const goCheckout=async evt=>{
      evt.preventDefault();evt.stopPropagation();evt.stopImmediatePropagation();
      if(stickyBuy.disabled) return;
      try{
        const sel=root.querySelector('#nm-variant-{{ section.id }}');
        const qtyInp=root.querySelector('input[name="quantity"]');
        const vid=sel?.value||String({{ product.selected_or_first_available_variant.id }});
        const qty=qtyInp?Math.max(1,parseInt(qtyInp.value||'1',10)):1;
        await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},credentials:'same-origin',body:JSON.stringify({id:Number(vid),quantity:Number(qty)})});
        window.location.href='/checkout';
      }catch(e){console.error(e);toast('Buy now failed');}
    };
    stickyBuy.addEventListener('pointerup',goCheckout,{capture:true});
    const sup=e=>{e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();};
    stickyBuy.addEventListener('click',sup,{capture:true});
    stickyBuy.addEventListener('touchend',sup,{capture:true});
    stickyBuy.addEventListener('pointerdown',sup,{capture:true});
  }

  /* ── Star fill fallback ── */
  const sf=root.querySelector('.stars-fill');
  if(sf){
    let pct=parseFloat(sf.getAttribute('data-rating-pct')||'0');
    if(!isFinite(pct)||pct<=0){const n=parseFloat('{{ rating_val }}');if(isFinite(n))pct=Math.max(0,Math.min(100,n*20));}
    sf.style.width=(pct||0)+'%';
  }

  /* ── Accordions ── */
  root.querySelectorAll('[data-acc]').forEach(acc=>
    acc.querySelector('.acc-head')?.addEventListener('click',()=>acc.classList.toggle('open'))
  );

  /* ── FAQs ── */
  const faqContainer=root.querySelector('.faq-accordion');
  root.querySelectorAll('.faq-accordion .faq-head').forEach(h=>
    h.addEventListener('click',()=>h.closest('.faq-card').classList.toggle('open'))
  );
  const faqBar=root.querySelector('.nm-faq-head-row');
  faqBar?.querySelector('[data-expand]')?.addEventListener('click',()=>faqContainer?.querySelectorAll('.faq-card').forEach(c=>c.classList.add('open')));
  faqBar?.querySelector('[data-collapse]')?.addEventListener('click',()=>faqContainer?.querySelectorAll('.faq-card').forEach(c=>c.classList.remove('open')));
})();
</script>

