<script>
/* Meta description / canonical override — update head tags set by theme.liquid */
(function(){
  {%- if s.seo_meta_description != blank -%}
  (function(){
    var c = {{ s.seo_meta_description | strip_html | strip_newlines | strip | truncate: 160 | json }};
    var m = document.querySelector('meta[name="description"]');
    if(m){ m.setAttribute('content', c); }
    else { var n=document.createElement('meta'); n.name='description'; n.content=c; document.head.appendChild(n); }
  })();
  {%- endif -%}
  {%- if s.seo_canonical_override != blank -%}
  (function(){
    var h = {{ s.seo_canonical_override | escape | json }};
    var l = document.querySelector('link[rel="canonical"]');
    if(l){ l.setAttribute('href', h); }
    else { var n=document.createElement('link'); n.rel='canonical'; n.href=h; document.head.appendChild(n); }
  })();
  {%- endif -%}
})();
</script>

<script>
(function(){
  const root = document.querySelector('#nm-{{ section.id }}');
  if (!root || root.dataset.nmInit === '1') return;
  root.dataset.nmInit = '1';

  /* Gallery */
  const stage=root.querySelector('[data-stage]');
  const slides=[...root.querySelectorAll('.stage .slide')];
  const thumbs=[...root.querySelectorAll('.thumbs .thumb')];
  const dots=[...root.querySelectorAll('.dots .dot')];
  const prev=root.querySelector('[data-prev]');
  const next=root.querySelector('[data-next]');
  let i=0;
  const show=(n)=>{ if(!slides.length) return; i=(n+slides.length)%slides.length;
    slides.forEach((s,idx)=>s.classList.toggle('active',idx===i));
    thumbs.forEach((t,idx)=>t?.classList.toggle('active',idx===i));
    dots.forEach((d,idx)=>d?.classList.toggle('active',idx===i));
  };
  thumbs.forEach((t,idx)=>t.addEventListener('click',()=>show(idx)));
  dots.forEach((d,idx)=>d.addEventListener('click',()=>show(idx)));
  prev?.addEventListener('click',()=>show(i-1));
  next?.addEventListener('click',()=>show(i+1));
  if(stage){
    let startX=0, dx=0, dragging=false;
    const getX=(e)=> (e.touches ? e.touches[0].clientX : e.clientX);
    const onStart=(e)=>{dragging=true; startX=getX(e); dx=0;};
    const onMove =(e)=>{ if(!dragging) return; dx=getX(e)-startX; };
    const onEnd  =()=>{ if(!dragging) return; if(Math.abs(dx)>40){ show(i + (dx<0?1:-1)); } dragging=false; dx=0; };
    stage.addEventListener('touchstart', onStart, {passive:true});
    stage.addEventListener('touchmove',  onMove,  {passive:true});
    stage.addEventListener('touchend',   onEnd);
    stage.addEventListener('mousedown', onStart);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup',   onEnd);
  }

  /* Variants & Qty */
  const select=root.querySelector('#nm-variant-{{ section.id }}');
  const variants={{ product.variants | json }};
  const groups=[...root.querySelectorAll('.swatches')];

  function currentChoice(){
    const picks=[];
    groups.forEach(g=>{
      const on=g.querySelector('.sw[aria-pressed="true"]');
      if(on) picks.push(on.dataset.value||on.textContent.trim());
    });
    return picks;
  }

  function updateLabels(){
    groups.forEach(g=>{
      const idx=g.getAttribute('data-opt');
      const selected=g.querySelector('.sw[aria-pressed="true"]');
      const txt=selected ? (selected.dataset.value||selected.textContent.trim()) : '';
      const target=root.querySelector('.currentChoice[data-current-choice="'+idx+'"]');
      if(target && txt){ target.textContent = txt; }
    });
  }

  /* Disable / enable all CTA buttons based on variant availability */
  const ADD_LABEL = {{ add_label | json }};
  const OOS_LABEL = {{ oos_label | json }};

  function updateAvailability(avail){
    const oosMsg  = root.querySelector('.nm-oos-msg');
    const addBtns = [...root.querySelectorAll(
      'button[name="add"], #nm-sticky-add-{{ section.id }}'
    )];
    const buyBtns = [...root.querySelectorAll(
      '[data-buy], #nm-sticky-buy-{{ section.id }}'
    )];
    addBtns.forEach(b=>{
      b.disabled = !avail;
      b.setAttribute('aria-disabled', avail ? 'false' : 'true');
      const inner = b.querySelector('.rte-inline');
      if(inner){
        /* Swap label text; preserve any rich-text wrapper tags */
        inner.innerHTML = avail ? ADD_LABEL : OOS_LABEL;
      }
    });
    buyBtns.forEach(b=>{
      b.disabled = !avail;
      b.setAttribute('aria-disabled', avail ? 'false' : 'true');
    });
    if(oosMsg) oosMsg.classList.toggle('visible', !avail);
  }

  function setVariant(){
    if(!select) return;
    const choice=currentChoice();
    let match=variants.find(v=>{
      return (v.options||[]).every((opt,ix)=>{
        return String(opt||'').toLowerCase().trim()===String(choice[ix]||'').toLowerCase().trim();
      });
    });
    if(!match && variants.length) match=variants[0];
    if(match){
      select.value=String(match.id);
      select.dispatchEvent(new Event('change',{bubbles:true}));
      updateAvailability(!!match.available);
    }
    updateLabels();
  }

  groups.forEach(g=>{
    g.addEventListener('click',e=>{
      const b=e.target.closest('.sw'); if(!b) return;
      g.querySelectorAll('.sw').forEach(x=>x.setAttribute('aria-pressed','false'));
      b.setAttribute('aria-pressed','true');
      setVariant();
    });
  });

  /* Qty stepper */
  const stepper=root.querySelector('.stepper');
  if(stepper){
    const input=stepper.querySelector('input[name="quantity"]');
    const [dec,inc]=stepper.querySelectorAll('button');
    const clamp=n=>Math.max(1,Math.min(99,n|0||1));
    dec.addEventListener('click',()=>input.value=clamp(+input.value-1));
    inc.addEventListener('click',()=>input.value=clamp(+input.value+1));
    input.addEventListener('input',()=>input.value=input.value.replace(/[^0-9]/g,''));
    input.addEventListener('blur',()=>input.value=clamp(+input.value));
  }

  /* Toast helper */
  function toast(msg){
    let t = root.querySelector('.nm-toast');
    if(!t){
      t = document.createElement('div');
      t.className = 'nm-toast';
      root.appendChild(t);
    }
    t.textContent = msg;
    t.style.opacity = '1';
    clearTimeout(t._h);
    t._h = setTimeout(()=>{ t.style.opacity='0'; }, 1700);
  }

  function safeRenderCart(state){
    const sections = state && state.sections ? state.sections : state;
    const drawer = document.querySelector('cart-drawer');
    const notif  = document.querySelector('cart-notification');
    if (drawer && typeof drawer.renderContents === 'function') {
      try { drawer.renderContents(state); drawer.open && drawer.open(); return; } catch(e){}
    }
    if (notif && typeof notif.renderContents === 'function') {
      try { notif.renderContents(state); notif.open && notif.open(); return; } catch(e){}
    }
    if (drawer && sections && sections['cart-drawer']) {
      drawer.innerHTML = sections['cart-drawer']; drawer.open && drawer.open(); return;
    }
    if (notif && sections && sections['cart-notification']) {
      notif.innerHTML = sections['cart-notification']; notif.open && notif.open(); return;
    }
    toast('Added to cart');
  }

  async function addToCartWithSections(variantId, quantity){
    const fd = new FormData();
    fd.append('id', String(variantId));
    fd.append('quantity', String(Math.max(1, Number(quantity)||1)));
    fd.append('form_type', 'product');
    fd.append('sections', 'cart-drawer,cart-icon-bubble,cart-notification');
    fd.append('sections_url', window.location.pathname);

    const res = await fetch('/cart/add.js', {
      method:'POST',
      body: fd,
      credentials:'same-origin',
      headers:{ 'Accept':'application/json' }
    });
    let data=null;
    try{ data=await res.json(); }catch(_){}
    if(!res.ok){
      const msg=(data && (data.message||data.description)) || 'Add to cart failed';
      throw new Error(msg);
    }
    if(!data || !data.sections){
      try{
        const r=await fetch('/?sections=cart-drawer,cart-icon-bubble,cart-notification',{credentials:'same-origin'});
        const j=await r.json();
        data={sections:j};
      }catch(_){}
    }
    return data;
  }

  /* Add to Cart main */
  const form   = root.querySelector('#nm-form-{{ section.id }}');
  const addBtn = form?.querySelector('button[type="submit"][name="add"]');
  const buyBtn = form?.querySelector('[data-buy]');

  async function handleAjaxAdd(e){
    e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
    if (addBtn && addBtn.disabled) return false;
    try{
      const sel = root.querySelector('#nm-variant-{{ section.id }}');
      const qtyInp = root.querySelector('input[name="quantity"]');
      const vid = sel?.value || String({{ product.selected_or_first_available_variant.id }});
      const qty = qtyInp ? Math.max(1, parseInt(qtyInp.value||'1',10)) : 1;
      const state = await addToCartWithSections(vid, qty);
      safeRenderCart(state);
    }catch(err){
      console.error(err);
      toast(err.message || 'Couldn\'t add. Try again.');
    }
    return false;
  }
  if (form && !form.dataset.nmAjax){
    form.dataset.nmAjax='1';
    form.addEventListener('submit', handleAjaxAdd, { capture:true });
  }
  if (addBtn && !addBtn.dataset.nmAjax){
    addBtn.dataset.nmAjax='1';
    addBtn.addEventListener('click', handleAjaxAdd, { capture:true });
  }

  function guardAdd(e){
    const t=e.target;
    if(!t) return;
    const isOurForm = t.closest ? !!t.closest('#nm-{{ section.id }} #nm-form-{{ section.id }}') : false;
    const isOurAdd  = t.closest ? !!t.closest('#nm-{{ section.id }} button[name="add"]') : false;
    if(isOurForm || isOurAdd){ handleAjaxAdd(e); }
  }
  document.addEventListener('submit', guardAdd, true);
  document.addEventListener('click', guardAdd, true);

  /* Buy Now main */
  async function doBuyNow(e){
    e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
    if (buyBtn && buyBtn.disabled) return false;
    try{
      const sel = root.querySelector('#nm-variant-{{ section.id }}');
      const qtyInp = root.querySelector('input[name="quantity"]');
      const vid = sel?.value || String({{ product.selected_or_first_available_variant.id }});
      const qty = qtyInp ? Math.max(1, parseInt(qtyInp.value||'1',10)) : 1;
      await fetch('/cart/add.js', {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        credentials:'same-origin',
        body: JSON.stringify({ id: Number(vid), quantity: Number(qty) })
      });
      window.location.href='/checkout';
    }catch(err){
      console.error('Buy now failed', err);
      toast('Buy now failed');
    }
    return false;
  }
  if (buyBtn && !buyBtn.dataset.nmBound){
    buyBtn.dataset.nmBound='1';
    buyBtn.addEventListener('click', doBuyNow, { capture:true });
    buyBtn.addEventListener('pointerup', doBuyNow, { capture:true });
  }
  function guardBuy(e){
    const t=e.target;
    if(!t) return;
    const isOurBuy = t.closest ? !!t.closest('#nm-{{ section.id }} [data-buy]') : false;
    if(isOurBuy){ doBuyNow(e); }
  }
  document.addEventListener('click', guardBuy, true);
  document.addEventListener('pointerup', guardBuy, true);

  /* Sticky CTA lift above footer */
  const bar = root.querySelector('[data-sticky-bar]');
  const footer = document.querySelector('#shopify-section-footer') || document.querySelector('footer');
  function liftBar(liftPx){ if (bar) bar.style.bottom = (liftPx||0) + 'px'; }
  if (bar && 'IntersectionObserver' in window && footer){
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        if (entry.isIntersecting){
          const h = entry.target.getBoundingClientRect().height || 0;
          liftBar(h);
        }else{
          liftBar(0);
        }
      });
    }, { rootMargin: '0px', threshold: 0 });
    io.observe(footer);
  }

  /* Sticky CTA buttons */
  const stickyAdd = root.querySelector('#nm-sticky-add-{{ section.id }}');
  const stickyBuy = root.querySelector('#nm-sticky-buy-{{ section.id }}');

  if (stickyAdd && !stickyAdd.dataset.nmBound) {
    stickyAdd.dataset.nmBound='1';
    window.__NM_ADD_LOCK = window.__NM_ADD_LOCK || false;
    window.__NM_LAST_ADD = window.__NM_LAST_ADD || { id:null, t:0 };
    let adding=false;
    const captureShield = (e)=>{ if (window.__NM_ADD_LOCK) { e.stopPropagation(); e.stopImmediatePropagation(); e.preventDefault(); } };
    const handleAdd = async (evt)=>{
      evt.preventDefault(); evt.stopPropagation(); evt.stopImmediatePropagation();
      if (stickyAdd.disabled || window.__NM_ADD_LOCK || adding) return;
      window.__NM_ADD_LOCK = true; adding=true; stickyAdd.disabled=true;
      document.addEventListener('click', captureShield, true);
      document.addEventListener('submit', captureShield, true);
      document.addEventListener('touchend', captureShield, true);
      try{
        const sel = root.querySelector('#nm-variant-{{ section.id }}');
        const qtyInp = root.querySelector('input[name="quantity"]');
        let vid = sel?.value;
        if (!vid && sel){
          const first=sel.querySelector('option:not([disabled])');
          if(first){ vid=first.value; sel.value=first.value; }
        }
        if (!vid) vid = String({{ product.selected_or_first_available_variant.id }});
        const qty = qtyInp ? Math.max(1, parseInt(qtyInp.value||'1',10)) : 1;
        const now=Date.now();
        if (window.__NM_LAST_ADD.id===vid && (now-window.__NM_LAST_ADD.t)<1200) return;
        const state = await addToCartWithSections(vid, qty);
        window.__NM_LAST_ADD = { id: vid, t: now };
        safeRenderCart(state);
      }catch(e){
        console.error(e);
        toast(e.message || 'Couldn\'t add. Try again.');
      }
      finally{
        setTimeout(()=>{ window.__NM_ADD_LOCK=false; }, 600);
        /* Re-evaluate real availability instead of blindly re-enabling */
        const currentVariantEl = root.querySelector('#nm-variant-{{ section.id }}');
        const currentId = currentVariantEl ? String(currentVariantEl.value) : null;
        const currentVariant = currentId ? variants.find(v=>String(v.id)===currentId) : null;
        const stillAvailable = currentVariant ? !!currentVariant.available : false;
        adding=false;
        if(stillAvailable) stickyAdd.disabled=false;
        document.removeEventListener('click', captureShield, true);
        document.removeEventListener('submit', captureShield, true);
        document.removeEventListener('touchend', captureShield, true);
      }
    };
    stickyAdd.addEventListener('pointerup', handleAdd, { capture:true });
    const suppress = e => { e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation(); };
    stickyAdd.addEventListener('click', suppress, { capture:true });
    stickyAdd.addEventListener('touchend', suppress, { capture:true });
    stickyAdd.addEventListener('pointerdown', suppress, { capture:true });
  }

  if (stickyBuy && !stickyBuy.dataset.nmBound){
    stickyBuy.dataset.nmBound='1';
    const goCheckout = async (evt)=>{
      evt.preventDefault(); evt.stopPropagation(); evt.stopImmediatePropagation();
      if (stickyBuy.disabled) return;
      try{
        const sel = root.querySelector('#nm-variant-{{ section.id }}');
        const qtyInp = root.querySelector('input[name="quantity"]');
        const vid = sel?.value || String({{ product.selected_or_first_available_variant.id }});
        const qty = qtyInp ? Math.max(1, parseInt(qtyInp.value||'1',10)) : 1;
        await fetch('/cart/add.js',{
          method:'POST',
          headers:{'Content-Type':'application/json','Accept':'application/json'},
          credentials:'same-origin',
          body:JSON.stringify({ id:Number(vid), quantity:Number(qty) })
        });
        window.location.href='/checkout';
      }catch(e){
        console.error('Sticky buy failed', e);
        toast('Buy now failed');
      }
    };
    stickyBuy.addEventListener('pointerup', goCheckout, { capture:true });
    const suppress = e => { e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation(); };
    stickyBuy.addEventListener('click', suppress, { capture:true });
    stickyBuy.addEventListener('touchend', suppress, { capture:true });
    stickyBuy.addEventListener('pointerdown', suppress, { capture:true });
  }

  /* Star % fallback */
  const sf = root.querySelector('.stars-fill');
  if (sf){
    const pctAttr = parseFloat(sf.getAttribute('data-rating-pct') || '0');
    let pct = pctAttr;
    if (!isFinite(pctAttr) || pctAttr <= 0){
      const text = '{{ rating_val }}';
      const n = parseFloat(text);
      if (isFinite(n)) pct = Math.max(0, Math.min(100, n*20));
    }
    sf.style.width = (pct||0) + '%';
  }

  /* Accordions */
  root.querySelectorAll('[data-acc]').forEach(acc=>{
    acc.querySelector('.acc-head')?.addEventListener('click', ()=> acc.classList.toggle('open'));
  });

  /* FAQ controls */
  const faqsContainer=root.querySelector('.faq-accordion');
  root.querySelectorAll('.faq-accordion .faq-head').forEach(h=>{
    h.addEventListener('click',()=>h.closest('.faq-card').classList.toggle('open'));
  });
  const headBar=root.querySelector('.section .sec-head');
  headBar?.querySelector('[data-expand]')?.addEventListener('click',()=>faqsContainer?.querySelectorAll('.faq-card').forEach(d=>d.classList.add('open')));
  headBar?.querySelector('[data-collapse]')?.addEventListener('click',()=>faqsContainer?.querySelectorAll('.faq-card').forEach(d=>d.classList.remove('open')));
})();
</script>

