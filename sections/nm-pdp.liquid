  ,"offers":{"@type":"AggregateOffer","priceCurrency":{{ shop.currency | json }},"lowPrice":{{ product.price_min | divided_by: 100.0 }},"highPrice":{{ product.price_max | divided_by: 100.0 }},"offerCount":{{ product.variants | size }},"availability":"{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}","offers":[{%- for v in product.variants -%}{"@type":"Offer","name":{{ v.title | json }},"sku":{{ v.sku | default: v.id | json }},"price":{{ v.price | divided_by: 100.0 }},"priceCurrency":{{ shop.currency | json }},"availability":"{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}","itemCondition":"https://schema.org/NewCondition","url":{{ product.url | prepend: request.origin | append: '?variant=' | append: v.id | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
