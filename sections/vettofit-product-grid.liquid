      { "value": "1", "label": "1" },
      { "value": "1.5", "label": "1.5" },
      { "value": "2", "label": "2" }
    ] },

    { "type": "checkbox", "id": "enable_hover_image", "label": "Enable hover 2nd image", "default": true },

    { "type": "checkbox", "id": "full_width", "label": "Make section full width", "default": false },

    { "type": "range", "id": "radius", "label": "Card radius (px)", "min": 8, "max": 28, "step": 1, "default": 16 },
    { "type": "range", "id": "pad", "label": "Card padding (px)", "min": 8, "max": 22, "step": 1, "default": 14 },
    { "type": "range", "id": "gap", "label": "Grid gap (px)", "min": 8, "max": 28, "step": 1, "default": 16 },
    { "type": "range", "id": "title_size", "label": "Title font size (px)", "min": 14, "max": 24, "step": 1, "default": 18 },
