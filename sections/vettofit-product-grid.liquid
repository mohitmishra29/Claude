    { "type": "color", "id": "ghost", "label": "Secondary (ghost)", "default": "#100146" },
    { "type": "color", "id": "chip_bg", "label": "Chip background", "default": "#ffffff" },
    { "type": "color", "id": "chip_bd", "label": "Chip border", "default": "#e6e6e6" },

    { "type": "checkbox", "id": "enable_sale_badge", "label": "Show Sale % badge", "default": true },
    { "type": "checkbox", "id": "enable_lowstock_badge", "label": "Show Low stock badge", "default": true },
    { "type": "checkbox", "id": "enable_new_badge", "label": "Show New badge", "default": true },

    { "type": "checkbox", "id": "enable_bestseller_badge", "label": "Show Bestseller badge (by handles/tags)", "default": true },
    { "type": "text", "id": "bestseller_handles", "label": "Bestseller handles (comma-separated)" },
    { "type": "text", "id": "bestseller_tags", "label": "Bestseller tags (comma-separated)", "default": "bestseller" },
    { "type": "text", "id": "new_badge_tag", "label": "Optional New tag (overrides days when present)" },
    { "type": "range", "id": "new_badge_days", "label": "New badge window (days)", "min": 3, "max": 60, "step": 1, "default": 21 },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold (qty)", "min": 1, "max": 50, "step": 1, "default": 5 },

