    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 50, "step": 1, "default": 12 },

    { "type": "checkbox", "id": "show_rating", "label": "Show rating (if available)", "default": true },
    { "type": "checkbox", "id": "show_compare", "label": "Show compare-at price", "default": true },

    { "type": "select", "id": "img_ratio", "label": "Image ratio", "default": "1-1", "options": [
      { "value": "1-1", "label": "1:1" },
      { "value": "4-5", "label": "4:5" },
      { "value": "3-4", "label": "3:4" }
    ] },

    { "type": "select", "id": "depth", "label": "Neumorphism depth", "default": "1", "options": [
