{
  "name": "VF Article Modern",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Header elements" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "home_label", "label": "Home crumb label", "default": "Home" },
    { "type": "text", "id": "blog_crumb_label", "label": "Blog crumb label", "default": "Blogs" },
    { "type": "checkbox", "id": "show_progress", "label": "Show reading progress bar", "default": true },
    { "type": "checkbox", "id": "show_hero_image", "label": "Show hero image", "default": true },
    { "type": "checkbox", "id": "show_reading_time", "label": "Show reading time", "default": true },
    { "type": "checkbox", "id": "show_updated", "label": "Show last updated date", "default": true },
    { "type": "header", "content": "Author & reviewer (E-E-A-T)" },
    { "type": "checkbox", "id": "show_author", "label": "Show author byline", "default": true },
    { "type": "checkbox", "id": "show_reviewer", "label": "Show vet reviewer", "default": true },
    { "type": "text", "id": "default_author", "label": "Default author name (or set per-article metafield custom.author_name)" },
    { "type": "text", "id": "default_reviewer", "label": "Default reviewer (or set per-article metafield custom.reviewer)", "default": "Dr. Anjali Rao, BVSc & AH" },
    { "type": "checkbox", "id": "show_author_box", "label": "Show author box at end", "default": true },
    { "type": "textarea", "id": "author_bio", "label": "Author bio", "default": "The Vettofit editorial team writes practical, vet-reviewed guides on nutrition and wellness for Indian pets. Every article is reviewed by a licensed veterinarian before publishing." },
    { "type": "header", "content": "Table of contents" },
    { "type": "checkbox", "id": "enable_toc", "label": "Enable table of contents (built from H2 headings)", "default": true },
    { "type": "text", "id": "toc_heading", "label": "TOC heading", "default": "On this page" },
    { "type": "header", "content": "Sharing & tags" },
    { "type": "checkbox", "id": "show_share", "label": "Show share buttons", "default": true },
    { "type": "checkbox", "id": "show_tags", "label": "Show tags", "default": true },
    { "type": "header", "content": "Product promotion" },
