    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Better pet parenting, in your inbox." },
    { "type": "textarea", "id": "newsletter_text", "label": "Text", "default": "One vet-reviewed guide a month. No spam, no fluff — unsubscribe anytime." }
  ],
  "presets": [{ "name": "VF Article Modern" }]
}
