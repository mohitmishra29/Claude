{%- comment -%}
  Vettofit header — sections/vf-header.liquid
  Built from "Vettofit Landing Page — Shopify Section Technical Guide", section 1 (Header).

  Desktop: logo left, menu centre, search / account / cart right. 72px tall, 60px when sticky.
  Mobile:  menu button left, logo centre, cart right. 56px tall.
           Menu opens as a full-height sheet: Dogs / Cats shortcuts, the menu, search,
           account, then support and WhatsApp links.

  Brand rules built in (owners can't break them from the editor):
  - Only the four brand colour schemes. No free colour picker.
  - Fonts and text sizes are fixed. Sentence case is never forced to capitals.
  - Logo is never re-coloured, stretched or cropped.
  - Flat surfaces, no neumorphism, no gradients. Teal is used only as the 2px "Signal Line"
    under the active menu item and for the Dogs / Cats selection.
  - Every tap target is at least 44×44px. Motion 160–280ms, switched off under reduced motion.
  - Native <details>/<summary> menus and <dialog> drawer, light JavaScript, no apps.
{%- endcomment -%}

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign feature_cards = section.blocks | where: 'type', 'feature_card'

  assign overlay = false
  if section.settings.transparent
    if section.settings.transparent_scope == 'all' or template.name == 'index'
      assign overlay = true
    endif
  endif

  assign wa_number = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign dark_scheme = false
  if section.settings.color_scheme == 'plum' or section.settings.color_scheme == 'carbon'
    assign dark_scheme = true
  endif
  assign has_light_logo = false
  if section.settings.logo_light != blank
    if overlay or dark_scheme
      assign has_light_logo = true
    endif
  endif
-%}

<vf-header
  id="vf-header-{{ section.id }}"
  class="vf-hdr vf-scheme--{{ section.settings.color_scheme }} vf-logo--{{ section.settings.logo_size }}{% if overlay %} vf-hdr--overlay{% endif %}{% if dark_scheme %} vf-hdr--dark{% endif %}{% if section.settings.show_border %} vf-hdr--border{% endif %}"
  data-sticky="{{ section.settings.sticky }}"
  data-cart-action="{{ section.settings.cart_action }}"
  data-cart-url="{{ routes.cart_url }}"
>
  <div class="vf-hdr__bar" data-bar>
    <div class="vf-hdr__inner{% if section.settings.header_width == 'full' %} vf-hdr__inner--full{% endif %}">

      {%- comment -%} Mobile: menu button (left) {%- endcomment -%}
      <button
        class="vf-hdr__icon vf-hdr__burger"
        type="button"
        aria-label="{{ section.settings.drawer_heading | default: 'Menu' | escape }}"
        aria-controls="vf-drawer-{{ section.id }}"
        aria-expanded="false"
        data-open-drawer
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
      </button>

      {%- comment -%} Logo {%- endcomment -%}
      <a class="vf-hdr__logo{% if has_light_logo %} has-light{% endif %}" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag:
              widths: '160, 240, 320, 480, 600',
              sizes: '(min-width: 990px) 240px, 180px',
              class: 'vf-hdr__logo-img vf-hdr__logo-img--main',
              alt: shop.name,
              loading: 'eager',
              fetchpriority: 'high'
          }}
          {%- if has_light_logo -%}
            {{
              section.settings.logo_light
              | image_url: width: 600
              | image_tag:
                widths: '160, 240, 320, 480, 600',
                sizes: '(min-width: 990px) 240px, 180px',
                class: 'vf-hdr__logo-img vf-hdr__logo-img--light',
                alt: shop.name,
                loading: 'eager'
            }}
          {%- endif -%}
        {%- else -%}
          <span class="vf-hdr__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- comment -%} Desktop: main menu (centre) {%- endcomment -%}
      <nav class="vf-hdr__nav" aria-label="Main">
        {%- if menu.links.size > 0 -%}
          <ul class="vf-nav" role="list">
            {%- for link in menu.links -%}
              {%- liquid
                assign card_found = false
                assign this_title = link.title | strip | downcase
                for b in feature_cards
                  assign wanted = b.settings.menu_item | strip | downcase
                  if card_found == false and wanted != blank and wanted == this_title
                    assign card = b
                    assign card_found = true
                  endif
                endfor
                assign is_active = false
                if link.active or link.child_active
                  assign is_active = true
                endif
              -%}
              <li class="vf-nav__item">
                {%- if link.links.size > 0 or card_found -%}
                  <details class="vf-nav__details" data-dropdown data-href="{{ link.url }}">
                    <summary class="vf-nav__link{% if is_active %} is-active{% endif %}">
                      <span>{{ link.title }}</span>
                      <svg class="vf-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="vf-nav__panel{% if card_found %} has-card{% endif %}">
                      <div class="vf-nav__cols">
                        {%- if link.url != '#' -%}
                          <a class="vf-nav__panel-title" href="{{ link.url }}">{{ link.title }}</a>
                        {%- endif -%}
                        {%- if link.links.size > 0 -%}
                          <ul class="vf-nav__sub" role="list">
                            {%- for child in link.links -%}
                              <li>
                                <a class="vf-nav__sublink{% if child.active %} is-active{% endif %}" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
                                {%- if child.links.size > 0 -%}
                                  <ul class="vf-nav__sub vf-nav__sub--deep" role="list">
                                    {%- for grandchild in child.links -%}
                                      <li><a class="vf-nav__sublink vf-nav__sublink--deep" href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                      {%- if card_found -%}
                        {%- assign card_alt = card.settings.heading | escape -%}
                        <a class="vf-card" href="{{ card.settings.link | default: link.url }}" data-block-id="{{ card.id }}" {{ card.shopify_attributes }}>
                          {%- if card.settings.image != blank -%}
                            {{ card.settings.image | image_url: width: 640 | image_tag: widths: '320, 480, 640', sizes: '260px', class: 'vf-card__img', loading: 'lazy', alt: card_alt }}
                          {%- endif -%}
                          {%- if card.settings.heading != blank -%}<span class="vf-card__heading">{{ card.settings.heading }}</span>{%- endif -%}
                          {%- if card.settings.text != blank -%}<span class="vf-card__text">{{ card.settings.text }}</span>{%- endif -%}
                        </a>
                      {%- endif -%}
                    </div>
                  </details>
                {%- else -%}
                  <a class="vf-nav__link{% if is_active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                    <span>{{ link.title }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>

      {%- comment -%} Right: search / account / cart {%- endcomment -%}
      <div class="vf-hdr__actions">
        {%- if section.settings.show_search -%}
          <a class="vf-hdr__icon vf-hide-mobile" href="{{ routes.search_url }}" aria-label="{{ section.settings.search_placeholder | default: 'Search' | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><line x1="20" y1="20" x2="15.8" y2="15.8"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a class="vf-hdr__icon vf-hide-mobile" href="{{ routes.account_url }}" aria-label="{{ section.settings.account_label | default: 'Account' | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
          </a>
        {%- endif -%}
        <a class="vf-hdr__icon vf-hdr__cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items" data-cart-link>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.1a1.6 1.6 0 0 1-1.6 1.4H7.8a1.6 1.6 0 0 1-1.6-1.4L5 8z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg>
          {%- if section.settings.show_cart_count -%}
            <span class="vf-hdr__count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    {%- if request.design_mode -%}
      {%- if section.settings.logo == blank or menu.links.size == 0 -%}
        <p class="vf-hdr__note">
          {%- if section.settings.logo == blank -%}Add the approved Vettofit logo under Logo. {% endif -%}
          {%- if menu.links.size == 0 -%}Pick a menu under Menu.{%- endif -%}
          <span> (Only you see this note.)</span>
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Mobile menu sheet ---------- {%- endcomment -%}
  <dialog class="vf-drawer" id="vf-drawer-{{ section.id }}" aria-label="{{ section.settings.drawer_heading | default: 'Menu' | escape }}" data-drawer>
    <div class="vf-drawer__sheet">
      <div class="vf-drawer__top">
        <span class="vf-drawer__title">{{ section.settings.drawer_heading }}</span>
        <button class="vf-hdr__icon" type="button" aria-label="Close" data-close-drawer>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
        </button>
      </div>

      <div class="vf-drawer__body">
        {%- if section.settings.show_species -%}
          {%- if section.settings.dogs_link != blank or section.settings.cats_link != blank -%}
            <div class="vf-species">
              {%- if section.settings.dogs_link != blank -%}
                <a class="vf-species__chip{% if request.path == section.settings.dogs_link %} is-current{% endif %}" href="{{ section.settings.dogs_link }}">{{ section.settings.dogs_label }}</a>
              {%- endif -%}
              {%- if section.settings.cats_link != blank -%}
                <a class="vf-species__chip{% if request.path == section.settings.cats_link %} is-current{% endif %}" href="{{ section.settings.cats_link }}">{{ section.settings.cats_label }}</a>
              {%- endif -%}
            </div>
          {%- elsif request.design_mode -%}
            <p class="vf-hdr__note vf-hdr__note--inline">Add links for the Dogs and Cats buttons under "Mobile menu". (Only you see this note.)</p>
          {%- endif -%}
        {%- endif -%}

        {%- if menu.links.size > 0 -%}
          <ul class="vf-mnav" role="list">
            {%- for link in menu.links -%}
              {%- liquid
                assign card_found = false
                assign this_title = link.title | strip | downcase
                for b in feature_cards
                  assign wanted = b.settings.menu_item | strip | downcase
                  if card_found == false and wanted != blank and wanted == this_title
                    assign card = b
                    assign card_found = true
                  endif
                endfor
              -%}
              <li class="vf-mnav__item">
                {%- if link.links.size > 0 or card_found -%}
                  <details class="vf-mnav__details"{% if link.child_active %} open{% endif %}>
                    <summary class="vf-mnav__link">
                      <span>{{ link.title }}</span>
                      <svg class="vf-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <ul class="vf-mnav__sub" role="list">
                      {%- if link.url != '#' -%}
                        <li><a class="vf-mnav__sublink vf-mnav__sublink--strong" href="{{ link.url }}">{{ link.title }}</a></li>
                      {%- endif -%}
                      {%- for child in link.links -%}
                        <li>
                          <a class="vf-mnav__sublink" href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="vf-mnav__deep" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a class="vf-mnav__sublink vf-mnav__sublink--deep" href="{{ grandchild.url }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                      {%- if card_found -%}
                        {%- assign card_alt = card.settings.heading | escape -%}
                        <li>
                          <a class="vf-card vf-card--mobile" href="{{ card.settings.link | default: link.url }}" data-block-id="{{ card.id }}">
                            {%- if card.settings.image != blank -%}
                              {{ card.settings.image | image_url: width: 640 | image_tag: widths: '320, 480, 640', sizes: '100px', class: 'vf-card__img', loading: 'lazy', alt: card_alt }}
                            {%- endif -%}
                            <span class="vf-card__copy">
                              {%- if card.settings.heading != blank -%}<span class="vf-card__heading">{{ card.settings.heading }}</span>{%- endif -%}
                              {%- if card.settings.text != blank -%}<span class="vf-card__text">{{ card.settings.text }}</span>{%- endif -%}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a class="vf-mnav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                    <span>{{ link.title }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_search -%}
          <form class="vf-msearch" action="{{ routes.search_url }}" method="get" role="search">
            <label class="vf-visually-hidden" for="vf-msearch-{{ section.id }}">{{ section.settings.search_placeholder }}</label>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><line x1="20" y1="20" x2="15.8" y2="15.8"/></svg>
            <input id="vf-msearch-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
          </form>
        {%- endif -%}
      </div>

      <div class="vf-drawer__foot">
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a class="vf-drawer__row" href="{{ routes.account_url }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/></svg>
            <span>{{ section.settings.account_label }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.support_link != blank and section.settings.support_label != blank -%}
          <a class="vf-drawer__row" href="{{ section.settings.support_link }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.5a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2.2-2.4 3.6"/><line x1="12" y1="17" x2="12" y2="17.01"/></svg>
            <span>{{ section.settings.support_label }}</span>
          </a>
        {%- endif -%}
        {%- if wa_number != blank -%}
          <a class="vf-drawer__row" href="https://wa.me/{{ wa_number }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5z"/></svg>
            <span>{{ section.settings.whatsapp_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </dialog>
</vf-header>

<style>
  /* ---------- Brand colour schemes (the only four allowed) ---------- */
  .vf-hdr {
    --vf-signal: var(--vf-teal, #09D1C7);
    --vf-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .vf-scheme--chalk {
    --vf-bg: var(--vf-chalk, #F7F5EF);
    --vf-surface: var(--vf-white, #FFFFFF);
    --vf-fg: var(--vf-carbon, #111111);
    --vf-fg-muted: rgba(17, 17, 17, 0.72);
    --vf-line: rgba(17, 17, 17, 0.12);
    --vf-hover: rgba(17, 17, 17, 0.06);
    --vf-badge-bg: var(--vf-carbon, #111111);
    --vf-badge-fg: #FFFFFF;
    --vf-focus: var(--vf-carbon, #111111);
  }
  .vf-scheme--white {
    --vf-bg: var(--vf-white, #FFFFFF);
    --vf-surface: var(--vf-white, #FFFFFF);
    --vf-fg: var(--vf-carbon, #111111);
    --vf-fg-muted: rgba(17, 17, 17, 0.72);
    --vf-line: rgba(17, 17, 17, 0.12);
    --vf-hover: rgba(17, 17, 17, 0.06);
    --vf-badge-bg: var(--vf-carbon, #111111);
    --vf-badge-fg: #FFFFFF;
    --vf-focus: var(--vf-carbon, #111111);
  }
  .vf-scheme--plum {
    --vf-bg: var(--vf-plum, #2B1B3A);
    --vf-surface: var(--vf-plum, #2B1B3A);
    --vf-fg: #FFFFFF;
    --vf-fg-muted: rgba(255, 255, 255, 0.78);
    --vf-line: rgba(255, 255, 255, 0.16);
    --vf-hover: rgba(255, 255, 255, 0.1);
    --vf-badge-bg: var(--vf-teal, #09D1C7);
    --vf-badge-fg: var(--vf-carbon, #111111);
    --vf-focus: var(--vf-teal, #09D1C7);
  }
  .vf-scheme--carbon {
    --vf-bg: var(--vf-carbon, #111111);
    --vf-surface: var(--vf-carbon, #111111);
    --vf-fg: var(--vf-chalk, #F7F5EF);
    --vf-fg-muted: rgba(247, 245, 239, 0.76);
    --vf-line: rgba(247, 245, 239, 0.14);
    --vf-hover: rgba(247, 245, 239, 0.1);
    --vf-badge-bg: var(--vf-teal, #09D1C7);
    --vf-badge-fg: var(--vf-carbon, #111111);
    --vf-focus: var(--vf-teal, #09D1C7);
  }

  /* ---------- Sizes (locked) ---------- */
  .vf-hdr {
    --vf-h: 56px;
    --vf-h-stuck: 56px;
    --vf-cur-h: var(--vf-h);
    --vf-logo-h: 28px;
    position: relative;
    display: block;
    height: var(--vf-h);
    z-index: 60;
    font-family: var(--vf-font-body, "Inter", var(--font-body-family, system-ui, -apple-system, "Segoe UI", sans-serif));
    -webkit-font-smoothing: antialiased;
  }
  .vf-hdr.vf-logo--small  { --vf-logo-h: 24px; }
  .vf-hdr.vf-logo--large  { --vf-logo-h: 34px; }
  .vf-hdr *, .vf-hdr *::before, .vf-hdr *::after { box-sizing: border-box; }
  .vf-hdr--overlay { height: 0; }
  .vf-hdr.is-stuck { --vf-cur-h: var(--vf-h-stuck); }

  @media (min-width: 990px) {
    .vf-hdr { --vf-h: 72px; --vf-h-stuck: 60px; --vf-logo-h: 36px; }
    .vf-hdr.vf-logo--small { --vf-logo-h: 30px; }
    .vf-hdr.vf-logo--large { --vf-logo-h: 44px; }
    .vf-hdr.is-stuck { --vf-logo-h: 30px; }
    .vf-hdr.is-stuck.vf-logo--small { --vf-logo-h: 26px; }
    .vf-hdr.is-stuck.vf-logo--large { --vf-logo-h: 36px; }
  }

  /* ---------- The bar ---------- */
  .vf-hdr__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--vf-cur-h);
    background: var(--vf-bg);
    color: var(--vf-fg);
    border-bottom: 1px solid transparent;
    transition:
      height 220ms var(--vf-ease),
      transform 260ms var(--vf-ease),
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }
  .vf-hdr--border .vf-hdr__bar { border-bottom-color: var(--vf-line); }
  .vf-hdr.is-stuck .vf-hdr__bar {
    position: fixed;
    box-shadow: 0 10px 24px -18px rgba(17, 17, 17, 0.35);
  }
  .vf-hdr.is-hidden .vf-hdr__bar { transform: translateY(-101%); box-shadow: none; }
  .vf-hdr.is-instant .vf-hdr__bar { transition: none; }

  /* See-through over a dark banner (until the shopper scrolls or opens a menu) */
  .vf-hdr--overlay:not(.is-stuck):not(.is-panel-open) .vf-hdr__bar {
    --vf-fg: #FFFFFF;
    --vf-fg-muted: rgba(255, 255, 255, 0.88);
    --vf-hover: rgba(255, 255, 255, 0.14);
    --vf-badge-bg: var(--vf-teal, #09D1C7);
    --vf-badge-fg: var(--vf-carbon, #111111);
    --vf-focus: #FFFFFF;
    background: transparent;
    border-bottom-color: transparent;
  }
  .vf-hdr__logo-img--light { display: none; }
  .vf-hdr--dark .has-light .vf-hdr__logo-img--main,
  .vf-hdr--overlay:not(.is-stuck):not(.is-panel-open) .has-light .vf-hdr__logo-img--main { display: none; }
  .vf-hdr--dark .has-light .vf-hdr__logo-img--light { display: block; }
  .vf-hdr--overlay:not(.is-stuck):not(.is-panel-open) .has-light .vf-hdr__logo-img--light { display: block; }

  .vf-hdr__inner {
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 max(8px, env(safe-area-inset-left)) 0 max(8px, env(safe-area-inset-right));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: "menu logo actions";
    align-items: center;
    column-gap: 8px;
  }
