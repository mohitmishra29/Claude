        clearTimeout(this._countTimer);
        this._countTimer = setTimeout(function () {
          var url = (self.dataset.cartUrl || '/cart') + '.js';
          fetch(url, { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (cart) {
              if (!cart) return;
              var n = cart.item_count || 0;
              self.querySelectorAll('[data-cart-count]').forEach(function (el) {
                el.textContent = n;
                el.classList.toggle('is-empty', n === 0);
              });
              var link = self.querySelector('[data-cart-link]');
              if (link) link.setAttribute('aria-label', 'Cart, ' + n + ' items');
            })
            .catch(function () {});
        }, 150);
      }

      /* ---------- Theme editor: show the feature card you're editing ---------- */
      onBlockSelect(e) {
        var id = e.detail && e.detail.blockId;
        if (!id) return;
        if (this.desktopMq.matches) {
          var el = this.querySelector('.vf-nav [data-block-id="' + id + '"]');
          var d = el && el.closest('details');
          if (d) d.open = true;
        } else {
          var m = this.drawer && this.drawer.querySelector('[data-block-id="' + id + '"]');
          if (m) {
            this.openDrawer();
            var md = m.closest('details');
            if (md) md.open = true;
          }
        }
      }

      onBlockDeselect() {
        this.closeDropdowns(false);
        this.closeDrawer(true);
      }
    }

    customElements.define('vf-header', VfHeader);
  })();
</script>

