{%- comment -%}
  Vettofit PDP · v1.0 (replaces "NM PDP v6.1")
  Brand book v4.0 · Ch. 5 (claims), Ch. 6 (visual identity), Ch. 9 (Shopify system) — binding.
  Client overrides: Helvetica family; Razorpay checkout hand-off; Judge.me reviews.

  Files:  sections/vf-pdp.liquid
          snippets/vf-icon, vf-fonts, vf-pdp-gallery, vf-pdp-buybox, vf-pdp-story,
                   vf-pdp-proof, vf-pdp-faq, vf-pdp-pairs, vf-pdp-schema
          assets/vf-tokens.css (shared token layer), vf-pdp.css, vf-pdp.js (deferred)

  Preserved from v6.1: variant picker + OOS guard, AJAX add-to-cart with section rendering
  (cart-drawer / cart-icon-bubble / cart-notification), quantity control + per-variant cap,
  badge metafields (custom.badge_enabled / custom.badge_text), rating fallbacks (reviews.rating,
  Judge.me, Loox), trust badge / FAQ / Mfg blocks, banner, Product / Offer / AggregateRating /
  BreadcrumbList / FAQPage JSON-LD, meta description + canonical overrides, Theme Editor toggles.
  See docs/02-code-audit.md for what changed and why.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}

{%- if product != blank -%}
  {%- liquid
    assign current = product.selected_or_first_available_variant
    assign mf = product.metafields.vf

    assign show_gallery = false
    if s.show_top and s.show_gallery
      assign show_gallery = true
    endif
    assign show_summary = false
    if s.show_top and s.show_summary
      assign show_summary = true
    endif
    assign two_cols = false
    if show_gallery and show_summary
      assign two_cols = true
    endif

    # ── Badge (preserved logic: metafield first, then section default) ──
    assign mf_badge_enabled = false
    if product.metafields.custom.badge_enabled
      if product.metafields.custom.badge_enabled == true or product.metafields.custom.badge_enabled.value == true
        assign mf_badge_enabled = true
      endif
    endif
    assign mf_badge_text_html = ''
    if product.metafields.custom.badge_text
      if product.metafields.custom.badge_text.value
        assign mf_badge_text_html = product.metafields.custom.badge_text | metafield_tag
      else
        assign mf_badge_text_html = product.metafields.custom.badge_text
      endif
    endif
    assign show_badge = false
    assign badge_html = ''
    if mf_badge_enabled and mf_badge_text_html != blank
      assign show_badge = true
      assign badge_html = mf_badge_text_html
    elsif s.badge_show_default and s.badge_rich != blank
      assign show_badge = true
      assign badge_html = s.badge_rich
    endif

    # ── Rating (preserved fallbacks: reviews.rating → Judge.me → Loox) ──
    assign rating_val = 0
    assign rating_count = 0
    assign r_mf = product.metafields.reviews.rating
    if r_mf != blank
      assign r_obj = r_mf.value
      if r_obj.rating != blank
        assign rating_val = r_obj.rating | times: 1.0
        assign r_max = r_obj.scale_max | times: 1.0
        if r_max > 0 and r_max != 5
          assign rating_val = rating_val | times: 5 | divided_by: r_max
        endif
      else
        assign rating_val = r_mf.value | times: 1.0
      endif
      assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
    endif
    if rating_val == 0
      assign jm_badge = product.metafields.judgeme.badge | append: '' | replace: '"', "'"
      if jm_badge contains 'data-average-rating'
        assign rating_val = jm_badge | split: "data-average-rating='" | last | split: "'" | first | times: 1.0
        assign rating_count = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
      elsif product.metafields.judgeme.badge_average
        assign rating_val = product.metafields.judgeme.badge_average | times: 1.0
      elsif product.metafields.loox.avg_rating
        assign rating_val = product.metafields.loox.avg_rating | times: 1.0
        assign rating_count = product.metafields.loox.num_reviews | plus: 0
      endif
    endif
    assign rating_pct = rating_val | times: 20 | at_most: 100
    assign rating_display = rating_val | round: 1

    # ── Species (dogs + cats by default, Ch. 2.1) ──
    assign species_raw = mf.species.value | join: ',' | downcase
    assign has_dog = false
    assign has_cat = false
    if species_raw contains 'dog'
      assign has_dog = true
    endif
    if species_raw contains 'cat'
      assign has_cat = true
    endif
    assign species_label = ''
    assign species_words = ''
    if has_dog and has_cat
      assign species_label = 'For dogs and cats'
      assign species_words = 'Dogs and cats'
    elsif has_dog
      assign species_label = 'For dogs'
      assign species_words = 'Dogs'
    elsif has_cat
      assign species_label = 'For cats'
      assign species_words = 'Cats'
    elsif species_raw contains 'multi'
      assign species_label = 'For pets'
      assign species_words = 'Dogs, cats and other companions'
    endif

    # ── Need → one category accent (Ch. 6.3–6.4) ──
    assign need_label = mf.need_primary.value | default: ''
    assign accent_key = s.accent_override
    if accent_key == 'auto' or accent_key == blank
      assign need_key = need_label | handleize
      assign accent_key = ''
      if need_key contains 'skin' or need_key contains 'coat'
        assign accent_key = 'skin-coat'
      elsif need_key contains 'gut' or need_key contains 'digest'
        assign accent_key = 'gut'
      elsif need_key contains 'daily' or need_key contains 'vital'
        assign accent_key = 'daily'
      elsif need_key contains 'calm'
        assign accent_key = 'calm'
      elsif need_key contains 'dental'
        assign accent_key = 'dental'
      elsif need_key contains 'joint' or need_key contains 'mobility'
        assign accent_key = 'joints'
      elsif need_key contains 'immun'
        assign accent_key = 'immunity'
      elsif need_key contains 'groom'
        assign accent_key = 'grooming'
      endif
    elsif accent_key == 'none'
      assign accent_key = ''
    endif

    # ── Evidence present? (drives the "See the evidence" link) ──
    assign has_evidence = false
    if s.show_evidence
      if mf.vet_reviewer.value != blank or mf.evidence.value != blank
        assign has_evidence = true
      endif
    endif

    # ── Reviews zone content ──
    assign app_block_count = 0
    for b in section.blocks
      if b.type == '@app'
        assign app_block_count = app_block_count | plus: 1
      endif
    endfor
    assign jm_widget = product.metafields.judgeme.widget
  -%}

  {{ 'vf-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'vf-pdp.css' | asset_url | stylesheet_tag }}
  {%- if s.use_webfont -%}{%- render 'vf-fonts' -%}{%- endif -%}
  <script src="{{ 'vf-pdp.js' | asset_url }}" defer></script>

  <div
    id="VfPdp-{{ sid }}"
    class="vf-pdp{% if accent_key != blank %} vf-accent--{{ accent_key }}{% endif %}"
    data-vf-pdp
    data-section-id="{{ sid }}"
    style="--vf-ratio: {{ s.gallery_ratio | default: '1 / 1' }}; --vf-fit: {{ s.gallery_fit | default: 'contain' }}; --vf-sticky-top: {{ s.sticky_offset }}px; --vf-banner-h-d: {{ s.banner_h_desktop }}px; --vf-banner-h-m: {{ s.banner_h_mobile }}px;"
  >
    {%- comment -%} ── 1 · Breadcrumb ── {%- endcomment -%}
    {%- if s.show_breadcrumb -%}
      {%- assign bc_collection = collection | default: product.collections.first -%}
      <nav class="vf-container vf-crumbs" aria-label="Breadcrumb">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          {%- if bc_collection -%}<li><a href="{{ bc_collection.url }}">{{ bc_collection.title }}</a></li>{%- endif -%}
          <li><span aria-current="page">{{ product.title }}</span></li>
        </ol>
      </nav>
    {%- endif -%}

    {%- comment -%} ── 2 · Above the fold ── {%- endcomment -%}
    {%- if s.show_top -%}
      <div class="vf-container">
        <div class="vf-hero{% unless two_cols %} vf-hero--single{% endunless %}">
          {%- if show_gallery -%}
            <div class="vf-hero__media">
              {%- render 'vf-pdp-gallery', product: product, sid: sid, s: s -%}
            </div>
          {%- endif -%}
          {%- if show_summary -%}
            <div class="vf-hero__buy" data-vf-buybox>
              {%- render 'vf-pdp-buybox',
                product: product,
                sid: sid,
                s: s,
                blocks: section.blocks,
                current: current,
                rating_val: rating_val,
                rating_count: rating_count,
                rating_pct: rating_pct,
                rating_display: rating_display,
                show_badge: show_badge,
                badge_html: badge_html,
                species_label: species_label,
                need_label: need_label,
                show_evidence_link: has_evidence
              -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- unless show_summary -%}
      <div class="vf-container"><h1 class="vf-buy__title vf-title-standalone">{{ product.title }}</h1></div>
    {%- endunless -%}

    {%- comment -%} ── 3–5 · Quick fit, Benefits, About, Why it works ── {%- endcomment -%}
    {%- render 'vf-pdp-story', product: product, sid: sid, s: s, species_words: species_words, need_label: need_label -%}

    {%- comment -%} ── 6–8 · Evidence, How to use, What to expect ── {%- endcomment -%}
    {%- render 'vf-pdp-proof', product: product, sid: sid, s: s, species_words: species_words -%}

    {%- comment -%} ── 9 · Reviews (Judge.me app block renders here) ── {%- endcomment -%}
    {%- if s.show_reviews -%}
      {%- if app_block_count > 0 or jm_widget != blank or rating_val > 0 or request.design_mode -%}
        <section class="vf-zone vf-zone--white vf-reviews" id="VfReviews-{{ sid }}" aria-labelledby="VfRevH-{{ sid }}" tabindex="-1">
          <div class="vf-container">
            <header class="vf-zone__head vf-reviews__head">
              <p class="vf-eyebrow">From pet parents</p>
              <h2 class="vf-h2" id="VfRevH-{{ sid }}">{{ s.reviews_title | default: 'Reviews' }}</h2>
              {%- if rating_val > 0 -%}
                <p class="vf-reviews__summary">
                  <span class="vf-reviews__score">{{ rating_display }}</span>
                  <span class="vf-stars vf-stars--lg" style="--vf-rating: {{ rating_pct }}%;" aria-hidden="true">
                    <span class="vf-stars__base">{%- for i in (1..5) -%}{%- render 'vf-icon', name: 'star', size: 20 -%}{%- endfor -%}</span>
                    <span class="vf-stars__fill">{%- for i in (1..5) -%}{%- render 'vf-icon', name: 'star', size: 20 -%}{%- endfor -%}</span>
                  </span>
                  <span class="vf-reviews__count">
                    <span class="vf-sr">Rated {{ rating_display }} out of 5. </span>
                    {%- if rating_count > 0 -%}Based on {{ rating_count }} reviews{%- endif -%}
                  </span>
                </p>
              {%- endif -%}
            </header>
            <div class="vf-reviews__widget">
              {%- for block in section.blocks -%}
                {%- if block.type == '@app' -%}
                  {% render block %}
                {%- endif -%}
              {%- endfor -%}
              {%- if app_block_count == 0 -%}
                {%- if jm_widget != blank -%}
                  <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">{{ jm_widget }}</div>
                {%- elsif request.design_mode -%}
                  <p class="vf-ph">[PLACEHOLDER] Add the Judge.me "Review widget" app block to this section. Filters and photo reviews are configured in Judge.me.</p>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </section>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ── 10 · FAQ ── {%- endcomment -%}
    {%- render 'vf-pdp-faq', product: product, sid: sid, s: s, blocks: section.blocks -%}

    {%- comment -%} ── 11 · Pairs well with ── {%- endcomment -%}
    {%- render 'vf-pdp-pairs', product: product, sid: sid, s: s, current: current -%}

    {%- comment -%} ── 12a · Manufacturing details (preserved: blocks + fallback; adds vf.mfg_details) ── {%- endcomment -%}
    {%- liquid
      assign mfg_mf = mf.mfg_details
      assign any_mfg = false
      for b in section.blocks
        if b.type == 'mfg' and b.settings.enabled
          assign any_mfg = true
          break
        endif
      endfor
      assign mfg_fb = s.mfg_fallback_rich1 | append: s.mfg_fallback_rich2 | append: s.mfg_fallback_rich3 | strip_html | strip
      assign mfg_mode = ''
      if mfg_mf != blank
        assign mfg_mode = 'metafield'
      elsif s.use_mfg_fallback and mfg_fb != blank
        assign mfg_mode = 'fallback'
      elsif any_mfg
        assign mfg_mode = 'blocks'
      elsif mfg_fb != blank
        assign mfg_mode = 'fallback'
      endif
    -%}
    {%- if s.show_mfg -%}
      {%- if mfg_mode != blank or request.design_mode -%}
        <section class="vf-zone vf-mfg" aria-label="{{ s.mfg_title | default: 'Manufacturing details' | escape }}">
          <div class="vf-container">
            <details class="vf-mfg__card">
              <summary class="vf-acc__q">
                <span class="vf-mfg__title">
                  {%- if s.mfg_icon != blank -%}
                    {{ s.mfg_icon | image_url: width: 64 | image_tag: width: 24, height: 24, alt: '', loading: 'lazy' }}
                  {%- else -%}
                    {%- render 'vf-icon', name: 'box', size: 22 -%}
                  {%- endif -%}
                  {{ s.mfg_title | default: 'Manufacturing details' }}
                </span>
                {%- render 'vf-icon', name: 'chevron-down', size: 20 -%}
              </summary>
              <div class="vf-acc__a">
                {%- case mfg_mode -%}
                  {%- when 'metafield' -%}
                    <div class="vf-rte">
                      {%- if mfg_mf.type == 'rich_text_field' -%}{{ mfg_mf | metafield_tag }}{%- else -%}{{ mfg_mf.value | escape | newline_to_br }}{%- endif -%}
                    </div>
                  {%- when 'blocks' -%}
                    <dl class="vf-mfg__list">
                      {%- for b in section.blocks -%}
                        {%- if b.type == 'mfg' and b.settings.enabled -%}
                          <div class="vf-mfg__row" {{ b.shopify_attributes }}>
                            <dt>{{ b.settings.title }}</dt>
                            <dd class="vf-rte">{{ b.settings.text }}</dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  {%- when 'fallback' -%}
                    <div class="vf-rte">{{ s.mfg_fallback_rich1 }}{{ s.mfg_fallback_rich2 }}{{ s.mfg_fallback_rich3 }}</div>
                  {%- else -%}
                    <p class="vf-ph">[PLACEHOLDER] Manufacturing details · vf.mfg_details, Mfg blocks or fallback text. Only list certifications you can document.</p>
                {%- endcase -%}
              </div>
            </details>
          </div>
        </section>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ── 12b · Banner (preserved) ── {%- endcomment -%}
    {%- if s.show_banner -%}
      {%- if s.banner_img_desktop != blank or s.banner_img_mobile != blank -%}
        {%- liquid
          assign banner_main = s.banner_img_desktop | default: s.banner_img_mobile
          assign banner_alt = s.banner_alt | default: ''
        -%}
        <section class="vf-banner">
          <div class="vf-container">
            {%- if s.banner_link != blank -%}
              <a class="vf-banner__frame" href="{{ s.banner_link }}"{% if s.banner_new_tab %} target="_blank" rel="noopener"{% endif %}>
            {%- else -%}
              <div class="vf-banner__frame">
            {%- endif -%}
              <picture>
                {%- if s.banner_img_mobile != blank and s.banner_img_desktop != blank -%}
                  <source
                    media="(max-width: 767px)"
                    srcset="{{ s.banner_img_mobile | image_url: width: 750 }} 750w, {{ s.banner_img_mobile | image_url: width: 1100 }} 1100w"
                    sizes="100vw"
                    width="{{ s.banner_img_mobile.width }}"
                    height="{{ s.banner_img_mobile.height }}"
                  >
                {%- endif -%}
                {{ banner_main | image_url: width: 2000 | image_tag: widths: '750,1100,1600,2000', sizes: '(min-width: 1440px) 1300px, 100vw', loading: 'lazy', alt: banner_alt, class: 'vf-banner__img' }}
              </picture>
              {%- if s.banner_new_tab and s.banner_link != blank -%}<span class="vf-sr"> (opens in a new tab)</span>{%- endif -%}
            {%- if s.banner_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </div>
        </section>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ── 13 · Mobile/tablet sticky purchase bar (shown after the main CTA scrolls away) ── {%- endcomment -%}
    {%- if show_summary and s.show_sticky -%}
      {%- assign sticky_variant = current.title -%}
      {%- if product.has_only_default_variant -%}{%- assign sticky_variant = '' -%}{%- endif -%}
      <div class="vf-sticky" data-vf-sticky inert aria-hidden="true">
        <div class="vf-sticky__inner">
          <div class="vf-sticky__info">
            <p class="vf-sticky__title">{{ product.title }}</p>
            <p class="vf-sticky__meta">
              <span data-vf-sticky-variant>{{ sticky_variant }}</span>
              <span class="vf-sticky__price" data-vf-sticky-price>{{ current.price | money }}</span>
            </p>
          </div>
          {%- if s.sticky_show_buy and s.show_buy_now -%}
            <button type="button" class="vf-btn vf-btn--secondary vf-btn--compact" data-vf-sticky-buy{% unless current.available %} hidden{% endunless %}>{{ s.buy_label | default: 'Buy now' }}</button>
          {%- endif -%}
          <button type="button" class="vf-btn vf-btn--primary vf-btn--compact" data-vf-sticky-add{% unless current.available %} disabled{% endunless %}>
            <span data-vf-add-label>{% if current.available %}{{ s.add_label | default: 'Add to cart' }}{% else %}{{ s.oos_label | default: 'Back soon' }}{% endif %}</span>
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Checkout hand-off for Buy now. Third-party checkouts (Razorpay Magic Checkout,
      GoKwik, Shiprocket) intercept the theme's [name="checkout"] submit; with no interceptor the
      form posts to /cart and Shopify redirects to its native checkout. {%- endcomment -%}
    <form action="{{ routes.cart_url }}" method="post" hidden data-vf-checkout-form>
      <button type="submit" name="checkout" value="1" tabindex="-1" data-vf-checkout-submit>Checkout</button>
    </form>

    <p class="vf-sr" data-vf-live aria-live="polite" aria-atomic="true"></p>
    <div class="vf-toast" data-vf-toast aria-hidden="true"></div>

    <script type="application/json" data-vf-data>
      {
        "sectionId": {{ sid | json }},
        "productId": {{ product.id }},
        "title": {{ product.title | json }},
        "brand": {{ s.seo_brand | default: product.vendor | json }},
        "type": {{ product.type | json }},
        "currency": {{ cart.currency.iso_code | json }},
        "optionCount": {% if product.has_only_default_variant %}0{% else %}{{ product.options.size }}{% endif %},
        "rootUrl": {{ routes.root_url | json }},
        "cartUrl": {{ routes.cart_url | json }},
        "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
        "cartJsUrl": {{ routes.cart_url | append: '.js' | json }},
        "recsUrl": {{ routes.product_recommendations_url | append: '.json' | json }},
        "maxPerVariant": {{ s.max_per_variant | default: 0 }},
        "checkoutMode": {{ s.checkout_mode | default: 'cart_form' | json }},
        "analytics": {{ s.analytics_datalayer | json }},
        "labels": {
          "add": {{ s.add_label | default: 'Add to cart' | json }},
          "oos": {{ s.oos_label | default: 'Back soon' | json }},
          "unavailable": "Choose another option",
          "limitButton": "Limit reached",
          "adding": "Adding to your cart",
          "added": "Added to your cart.",
          "addedBoth": "Both added to your cart.",
          "error": "Something went wrong. Your cart is safe. Try again.",
          "optionOos": " — back soon",
          "optionNone": " — unavailable",
          "save": "Save",
          "salePrice": "Sale price",
          "price": "Price",
          "dosePrefix": "Daily amount for",
          "doseNone": "That weight isn’t in the table. Check with your vet.",
          "pinInvalid": "Enter a 6-digit pincode.",
          "pinChecking": "Checking…",
          "pinOk": "We deliver to this pincode.",
          "pinNo": "We can’t deliver to this pincode yet.",
          "pinError": "We couldn’t check right now. Try again, or continue to checkout to confirm."
        }
      }
    </script>
  </div>

  {%- render 'vf-pdp-schema', product: product, s: s, blocks: section.blocks, current: current, rating_val: rating_val, rating_count: rating_count -%}

  {%- comment -%} Meta description + canonical overrides (preserved). Prefer Shopify's SEO fields;
    see docs/08 for a head-level alternative that crawlers read without JavaScript. {%- endcomment -%}
  {%- if s.seo_meta_description != blank or s.seo_canonical_override != blank -%}
    <script>
      (function () {
        {%- if s.seo_meta_description != blank -%}
          var c = {{ s.seo_meta_description | strip_html | strip_newlines | strip | truncate: 160 | json }};
          var m = document.querySelector('meta[name="description"]');
          if (m) { m.setAttribute('content', c); } else { m = document.createElement('meta'); m.name = 'description'; m.content = c; document.head.appendChild(m); }
        {%- endif -%}
        {%- if s.seo_canonical_override != blank -%}
          var h = {{ s.seo_canonical_override | strip | json }};
          var l = document.querySelector('link[rel="canonical"]');
          if (l) { l.setAttribute('href', h); } else { l = document.createElement('link'); l.rel = 'canonical'; l.href = h; document.head.appendChild(l); }
        {%- endif -%}
      })();
    </script>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="vf-pdp-empty">Select a product to preview this section.</div>
{%- endif -%}

{% schema %}
{
  "name": "Vettofit PDP",
  "tag": "section",
  "class": "vf-pdp-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_top", "label": "Show top area (gallery + buy box)", "default": true },
    { "type": "checkbox", "id": "show_gallery", "label": "Show gallery", "default": true },
    { "type": "checkbox", "id": "show_summary", "label": "Show buy box", "default": true },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": false, "info": "Leave off if your theme already shows one." },
    { "type": "range", "id": "sticky_offset", "label": "Sticky buy box top offset (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24, "info": "Increase if your header is sticky." },
    {
      "type": "select",
      "id": "accent_override",
      "label": "Category accent",
      "options": [
        { "value": "auto", "label": "Automatic from vf.need_primary" },
        { "value": "skin-coat", "label": "Skin & Coat" },
        { "value": "gut", "label": "Gut" },
        { "value": "daily", "label": "Daily" },
        { "value": "calm", "label": "Calm" },
        { "value": "dental", "label": "Dental" },
