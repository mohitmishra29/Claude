{%- comment -%}
  Vettofit pets wall ("Pets, not models") — sections/vf-pet-stories.liquid
  Built from "Vettofit Landing Page — Shopify Section Technical Guide", section 5 (Pets wall)
  and the Landing Page Guidelines, moment 6 (Real pets, not models).

  Each card: photo or short muted video (tap to play), pet name, species, city,
  "X weeks with Vettofit", a short quote (max 140 characters) and the product they use.

  CONSENT RULE: a story without "Consent confirmed" ticked NEVER shows on the live store.
  In the theme editor it shows with a yellow note so you can see what's missing.

  Where stories come from (setting "Which stories"):
  - Add them in this section (Story blocks)          ← easiest, works on day one
  - Automatically from my pet-story library        ← Content → Metaobjects → vf_pet_story
  - Pick them from my pet-story library
  Library fields used: pet_name, species, city, weeks_of_use, photo, video, quote, product,
  consent_confirmed.

  One single line on every device (Ghia-style): 4 cards on large desktops, 3 on small desktops,
  2 on tablets, 85% cards on phones. Arrows + a teal Signal Line progress bar. Never wraps.
  Dog / Cat filter, and it follows the page's Dog / Cat switch (event vf:species-change).
  Experience language only: there is no star-rating override and no medical-claim field.
{%- endcomment -%}

{%- liquid
  assign ss = section.settings
  assign source = ss.source
  if source == 'picked'
    assign items = ss.stories
  elsif source == 'auto'
    assign items = shop.metaobjects.vf_pet_story.values
  else
    assign items = section.blocks | where: 'type', 'story'
  endif
  assign max_show = ss.count | default: 8
  assign shown = 0
  assign heading_id = 'vf-pets-h-' | append: section.id
-%}

{%- capture play_svg -%}<svg class="vf-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg><svg class="vf-i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="5.5" width="3.5" height="13" rx="1"/><rect x="13.5" y="5.5" width="3.5" height="13" rx="1"/></svg>{%- endcapture -%}

<vf-pet-stories
  id="vf-pets-{{ section.id }}"
  class="vf-pets vf-scheme--{{ ss.color_scheme }} vf-space-below--{{ ss.space_below }}"
  data-follow="{{ ss.follow_switch }}"
>
  <section class="vf-pets__inner" aria-labelledby="{{ heading_id }}">
    <header class="vf-pets__head">
      <div class="vf-pets__titles">
        <h2 class="vf-pets__heading" id="{{ heading_id }}">{{ ss.heading | default: 'Pets, not models.' }}</h2>
        <span class="vf-pets__signal" aria-hidden="true"></span>
        {%- if ss.intro != blank -%}<p class="vf-pets__intro">{{ ss.intro }}</p>{%- endif -%}
      </div>

      {%- if ss.show_filter -%}
        <fieldset class="vf-pets__filter">
          <legend class="vf-vh">{{ ss.filter_label }}</legend>
          {%- for opt in (1..3) -%}
            {%- liquid
              case opt
                when 1
                  assign v = 'all'
                  assign l = ss.all_label
                when 2
                  assign v = 'dog'
                  assign l = ss.dogs_label
                when 3
                  assign v = 'cat'
                  assign l = ss.cats_label
              endcase
            -%}
            <label class="vf-pets__chip">
              <input type="radio" name="pets-{{ section.id }}" value="{{ v }}"{% if v == 'all' %} checked{% endif %} data-filter>
              <span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="5 12.5 10 17 19 7"/></svg>
                {{ l }}
              </span>
            </label>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}
    </header>

    <div class="vf-pets__viewport">

      <div class="vf-pets__wall" role="list" data-wall>
        {%- for item in items -%}
          {%- if shown >= max_show -%}{%- break -%}{%- endif -%}
          {%- liquid
            if source == 'blocks'
              assign s_img = item.settings.image
              assign s_video = item.settings.video
              assign s_name = item.settings.pet_name
              assign s_species = item.settings.species
              assign s_city = item.settings.city
              assign s_weeks = item.settings.weeks
              assign s_quote = item.settings.quote
              assign s_product = item.settings.product
              assign s_consent = item.settings.consent
            else
              assign s_img = item.photo.value
              assign s_video = item.video.value
              assign s_name = item.pet_name.value
              assign s_species = item.species.value
              assign s_city = item.city.value
              assign s_weeks = item.weeks_of_use.value
              assign s_quote = item.quote.value
              assign s_product = item.product.value
              assign s_consent = item.consent_confirmed.value
            endif

            comment
              Consent rule: no consent, no card (the editor still shows it, with a note).
            endcomment
            assign ok = false
            if s_consent == true
              assign ok = true
            endif
            if ok == false and request.design_mode == false
              continue
            endif

            assign sp_raw = s_species | downcase
            assign sp = 'any'
            assign sp_word = ''
            if sp_raw contains 'dog'
              assign sp = 'dog'
              assign sp_word = ss.dog_word
            elsif sp_raw contains 'cat'
              assign sp = 'cat'
              assign sp_word = ss.cat_word
            endif

            assign weeks_num = s_weeks | plus: 0
            assign weeks_line = ''
            if weeks_num > 0
              if weeks_num == 1
                assign weeks_line = ss.weeks_text_one | replace: '[weeks]', weeks_num
              else
                assign weeks_line = ss.weeks_text | replace: '[weeks]', weeks_num
              endif
            endif

            assign quote_raw = s_quote | strip_html | strip
            assign quote = quote_raw
            if quote_raw.size > 140
              assign quote = ''
              assign q_words = quote_raw | split: ' '
              for qw in q_words
                assign q_try = quote | append: ' ' | append: qw | strip
                if q_try.size > 138
                  break
                endif
                assign quote = q_try
              endfor
              assign quote = quote | append: '…'
            endif

            comment
              Short product name: the part before "|", without the brand name in front.
            endcomment
            assign p_short = ''
            if s_product != blank
              assign p_short = s_product.title | split: '|' | first | strip
              if s_product.vendor != blank
                assign v_len = s_product.vendor.size | plus: 1
                assign v_head = p_short | slice: 0, v_len | downcase
                assign v_want = s_product.vendor | downcase | append: ' '
                if v_head == v_want
                  assign p_short = p_short | slice: v_len, 300 | strip
                endif
              endif
              assign p_short = p_short | truncate: 48
            endif
            assign shown = shown | plus: 1
            assign alt = ''
            if s_img != blank
              assign alt = s_img.alt
            endif
            if alt == blank
              assign alt = s_name | append: ', ' | append: sp_word | append: ' from ' | append: s_city
            endif
            assign alt = alt | escape
          -%}

          <div class="vf-story-wrap" role="listitem" data-story data-species="{{ sp }}" {% if source == 'blocks' %}data-block-id="{{ item.id }}" {{ item.shopify_attributes }}{% endif %}>
            <figure class="vf-story">
              <div class="vf-story__media">
                {%- if s_video != blank -%}
                  {{ s_video | video_tag: muted: true, loop: true, playsinline: true, autoplay: false, controls: false, preload: 'none', class: 'vf-story__video', image_size: '800x' }}
                  <button class="vf-story__play" type="button" aria-label="Play {{ s_name | escape }}'s clip" aria-pressed="false" data-play>{{ play_svg }}</button>
                {%- elsif s_img != blank -%}
                  {{ s_img | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 1200px) 24vw, (min-width: 990px) 31vw, (min-width: 750px) 46vw, 85vw', loading: 'lazy', class: 'vf-story__img', alt: alt }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'vf-story__ph' }}
                {%- endif -%}
                {%- if weeks_line != '' -%}<span class="vf-story__weeks">{{ weeks_line }}</span>{%- endif -%}
              </div>

              <figcaption class="vf-story__body">
                {%- if request.design_mode and ok == false -%}
                  <p class="vf-pets__note">Hidden on your live store until "Consent confirmed" is ticked. Tick it only with the owner's written permission. (Only you see this note.)</p>
                {%- endif -%}
                {%- if quote != blank -%}
                  <blockquote class="vf-story__quote"><p>“{{ quote }}”</p></blockquote>
                {%- endif -%}
                <p class="vf-story__who">
                  {%- if s_name != blank -%}<span class="vf-story__name">{{ s_name }}</span>{%- endif -%}
                  {%- if sp_word != '' or s_city != blank -%}
                    <span class="vf-story__meta">{% if sp_word != '' %}{{ sp_word | capitalize }}{% endif %}{% if sp_word != '' and s_city != blank %} · {% endif %}{{ s_city }}</span>
                  {%- endif -%}
                </p>
                {%- if s_product != blank and ss.show_product -%}
                  <a class="vf-story__product" href="{{ s_product.url }}">{{ ss.uses_text | replace: '[product]', p_short }}</a>
                {%- endif -%}
              </figcaption>
            </figure>
          </div>
        {%- endfor -%}
      </div>

      <div class="vf-pets__nav" data-nav>
        <div class="vf-pets__progress" aria-hidden="true"><span data-progress></span></div>
        <div class="vf-pets__arrows">
          <button type="button" class="vf-pets__arrow" data-prev aria-label="Previous stories"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="11 6 5 12 11 18"/></svg></button>
          <button type="button" class="vf-pets__arrow" data-next aria-label="Next stories"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></button>
        </div>
      </div>

      <p class="vf-pets__empty" data-empty hidden>{{ ss.empty_text }}</p>

      {%- if shown == 0 and request.design_mode -%}
        <p class="vf-pets__note">
          {%- case source -%}
            {%- when 'blocks' -%}Add a "Pet story" block on the left to start your wall.
            {%- when 'picked' -%}Pick stories from your pet-story library under "Picked stories".
            {%- else -%}No stories found in Content → Metaobjects → Pet story (vf_pet_story), or none have "Consent confirmed" ticked.
          {%- endcase -%}
          (Only you see this note.)
        </p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="vf-pets__app" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endif -%}
    {%- endfor -%}

    {%- if ss.button_label != blank and ss.button_link != blank -%}
      <div class="vf-pets__more">
        <a class="vf-pets__btn" href="{{ ss.button_link }}">{{ ss.button_label }}</a>
      </div>
    {%- endif -%}
  </section>
</vf-pet-stories>

{%- capture s -%}#vf-pets-{{ section.id }}{%- endcapture -%}
{% style %}
  {{ s }}.vf-scheme--chalk  { --t-bg: var(--vf-chalk, #F7F5EF); --t-card: var(--vf-white, #FFFFFF); --t-fg: var(--vf-carbon, #111111); --t-muted: rgba(17,17,17,.64); --t-line: rgba(17,17,17,.14); --t-sel-bg: var(--vf-carbon, #111111); --t-sel-fg: #FFFFFF; }
  {{ s }}.vf-scheme--white  { --t-bg: var(--vf-white, #FFFFFF); --t-card: var(--vf-chalk, #F7F5EF); --t-fg: var(--vf-carbon, #111111); --t-muted: rgba(17,17,17,.64); --t-line: rgba(17,17,17,.14); --t-sel-bg: var(--vf-carbon, #111111); --t-sel-fg: #FFFFFF; }
  {{ s }}.vf-scheme--plum   { --t-bg: var(--vf-plum, #2B1B3A); --t-card: rgba(255,255,255,.06); --t-fg: #FFFFFF; --t-muted: rgba(255,255,255,.74); --t-line: rgba(255,255,255,.2); --t-sel-bg: var(--vf-chalk, #F7F5EF); --t-sel-fg: var(--vf-carbon, #111111); }
  {{ s }}.vf-scheme--carbon { --t-bg: var(--vf-carbon, #111111); --t-card: rgba(255,255,255,.06); --t-fg: var(--vf-chalk, #F7F5EF); --t-muted: rgba(247,245,239,.72); --t-line: rgba(247,245,239,.18); --t-sel-bg: var(--vf-chalk, #F7F5EF); --t-sel-fg: var(--vf-carbon, #111111); }

  {{ s }} {
    --t-signal: var(--vf-teal, #09D1C7);
    --t-ink: var(--vf-carbon, #111111);
    --t-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --t-gutter: 16px;
    --t-font: var(--vf-font-body, "Inter", var(--font-body-family, system-ui, -apple-system, "Segoe UI", sans-serif));
    --t-font-display: var(--vf-font-display, "Inter Display", "Inter", var(--font-heading-family, system-ui, sans-serif));
    --t-font-accent: var(--vf-font-accent, "EB Garamond", "Iowan Old Style", Georgia, "Times New Roman", serif);
    display: block;
    background: var(--t-bg);
    color: var(--t-fg);
    font-family: var(--t-font);
    letter-spacing: 0;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  {{ s }} *, {{ s }} *::before, {{ s }} *::after { box-sizing: border-box; }
  {{ s }} h2, {{ s }} p, {{ s }} ul, {{ s }} li, {{ s }} figure, {{ s }} figcaption, {{ s }} blockquote, {{ s }} fieldset, {{ s }} legend {
    margin: 0; padding: 0; border: 0; letter-spacing: 0; text-transform: none; list-style: none;
  }
  {{ s }} li::before, {{ s }} li::marker { content: none; }
  {{ s }} [hidden] { display: none !important; }
  {{ s }}.vf-space-below--none   { padding-bottom: 0; }
  {{ s }}.vf-space-below--small  { padding-bottom: 24px; }
  {{ s }}.vf-space-below--medium { padding-bottom: 48px; }
  {{ s }}.vf-space-below--large  { padding-bottom: 80px; }

  {{ s }} .vf-pets__inner { max-width: 1440px; margin: 0 auto; padding: 56px var(--t-gutter) 8px; }

  /* ---------- Heading + filter ---------- */
  {{ s }} .vf-pets__head { display: flex; flex-direction: column; gap: 20px; margin-bottom: 24px; }
  {{ s }} .vf-pets__heading { font-family: var(--t-font-display); font-weight: 700; font-size: 32px; line-height: 1.05; letter-spacing: -0.02em; color: var(--t-fg); text-wrap: balance; }
  {{ s }} .vf-pets__signal { display: block; width: 48px; height: 2px; margin-top: 16px; border-radius: 2px; background: var(--t-signal); }
  {{ s }} .vf-pets__intro { margin-top: 14px; max-width: 46ch; font-size: 17px; line-height: 1.5; color: var(--t-muted); }

  {{ s }} .vf-pets__filter { display: flex; gap: 8px; flex-wrap: wrap; }
  {{ s }} .vf-pets__chip { position: relative; }
  {{ s }} .vf-pets__chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  {{ s }} .vf-pets__chip span {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 44px; padding: 0 18px; border-radius: 999px;
    border: 1px solid var(--t-line); color: var(--t-fg);
    font-size: 15px; font-weight: 500;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  {{ s }} .vf-pets__chip svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; display: none; }
  {{ s }} .vf-pets__chip input:checked + span { background: var(--t-sel-bg); color: var(--t-sel-fg); border-color: var(--t-sel-bg); font-weight: 700; }
  {{ s }} .vf-pets__chip input:checked + span svg { display: block; }
  {{ s }} .vf-pets__chip input:focus-visible + span { outline: 2px solid var(--t-fg); outline-offset: 2px; }

  /* ---------- Wall: mobile swipe (85% cards) ---------- */
  {{ s }} .vf-pets__viewport { position: relative; }
  {{ s }} .vf-pets__wall {
    display: flex; gap: 12px; align-items: flex-start;
    margin: 0 calc(-1 * var(--t-gutter)); padding: 0 var(--t-gutter) 8px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 var(--t-gutter);
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  {{ s }} .vf-pets__wall::-webkit-scrollbar { display: none; }
  {{ s }} .vf-pets__wall { align-items: stretch; }
  {{ s }} .vf-story-wrap { position: relative; flex: 0 0 85%; min-width: 0; scroll-snap-align: start; display: flex; }

  /* ---------- Card ---------- */
  {{ s }} .vf-story { display: flex; flex-direction: column; width: 100%; min-width: 0; background: var(--t-card); border-radius: 24px; overflow: hidden; }
  {{ s }} .vf-story__body { min-width: 0; }
  {{ s }} .vf-story__media { position: relative; background: var(--t-line); }
  /* Equal cards: every photo / clip is 4:5 */
  {{ s }} .vf-story__media { aspect-ratio: 4 / 5; overflow: hidden; }
  {{ s }} .vf-story__img, {{ s }} .vf-story__video, {{ s }} .vf-story__media video, {{ s }} .vf-story__ph { display: block; width: 100%; height: 100%; object-fit: cover; }
  {{ s }} .vf-story__ph { fill: var(--t-muted); background: var(--t-line); }
  {{ s }} .vf-story__weeks {
    position: absolute; left: 12px; bottom: 12px;
    padding: 6px 12px; border-radius: 999px;
    background: var(--vf-chalk, #F7F5EF); color: var(--t-ink);
    font-size: 12px; font-weight: 700; line-height: 1.2;
  }
  {{ s }} .vf-story__play {
    position: absolute; right: 12px; bottom: 12px; width: 48px; height: 48px; border: 0; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(17,17,17,.72); color: #FFFFFF; cursor: pointer; -webkit-tap-highlight-color: transparent;
  }
  {{ s }} .vf-story__play svg { width: 20px; height: 20px; fill: currentColor; }
  {{ s }} .vf-story__play .vf-i-pause { display: none; }
  {{ s }} .vf-story__play[aria-pressed="true"] .vf-i-play { display: none; }
  {{ s }} .vf-story__play[aria-pressed="true"] .vf-i-pause { display: block; }

  {{ s }} .vf-story__body { flex: 1 1 auto; display: flex; flex-direction: column; gap: 12px; padding: 18px 18px 20px; }
  {{ s }} .vf-story__who { margin-top: auto; }
  {{ s }} .vf-story__quote { position: relative; padding-top: 14px; }
  {{ s }} .vf-story__quote::before { content: ""; position: absolute; top: 0; left: 0; width: 28px; height: 2px; border-radius: 2px; background: var(--t-signal); }
  {{ s }} .vf-story__quote p { font-family: var(--t-font-accent); font-style: italic; font-size: 19px; line-height: 1.38; color: var(--t-fg); }
  {{ s }} .vf-story__who { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
  {{ s }} .vf-story__name { font-family: var(--t-font-display); font-size: 17px; font-weight: 700; color: var(--t-fg); }
  {{ s }} .vf-story__meta { font-size: 14px; color: var(--t-muted); }
  {{ s }} .vf-story__product { display: block; max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 13px; font-weight: 600; color: var(--t-muted); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  {{ s }} .vf-story__product:hover { color: var(--t-fg); }

  {{ s }} .vf-pets__empty { padding: 24px 0; color: var(--t-muted); font-size: 15px; }
  {{ s }} .vf-pets__app { margin-top: 32px; }
  {{ s }} .vf-pets__more { display: flex; justify-content: center; margin-top: 28px; }
  {{ s }} .vf-pets__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 0 24px; border-radius: 14px;
    border: 1px solid var(--t-fg); color: var(--t-fg); background: transparent;
    font-size: 16px; font-weight: 600; text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }
  @media (hover: hover) { {{ s }} .vf-pets__btn:hover { background: var(--t-fg); color: var(--t-bg); } }

  /* Navigation: teal Signal Line progress + arrows */
  {{ s }} .vf-pets__nav { display: flex; align-items: center; gap: 20px; margin-top: 20px; }
  {{ s }} .vf-pets__nav[hidden] { display: none !important; }
  {{ s }} .vf-pets__progress { position: relative; flex: 1 1 auto; height: 2px; border-radius: 2px; background: var(--t-line); overflow: hidden; }
  {{ s }} .vf-pets__progress span { position: absolute; top: 0; left: 0; height: 100%; width: 30%; border-radius: 2px; background: var(--t-signal); transition: transform 120ms linear; }
  {{ s }} .vf-pets__arrows { display: none; flex-shrink: 0; }
  {{ s }} .vf-pets__arrow {
    width: 52px; height: 44px; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--t-fg); background: transparent; color: var(--t-fg); cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
  }
  {{ s }} .vf-pets__arrow[data-prev] { border-radius: 999px 0 0 999px; }
  {{ s }} .vf-pets__arrow[data-next] { border-radius: 0 999px 999px 0; margin-left: -1px; }
  {{ s }} .vf-pets__arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) { {{ s }} .vf-pets__arrow:not(:disabled):hover { background: var(--t-fg); color: var(--t-bg); } }
  {{ s }} .vf-pets__arrow:disabled { opacity: .3; cursor: default; }

  {{ s }} a:focus-visible, {{ s }} button:focus-visible { outline: 2px solid var(--t-fg); outline-offset: 3px; }
  {{ s }} .vf-vh { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  {{ s }} .vf-pets__note { padding: 8px 12px; background: #FFF4B8; color: #111111; font-size: 13px; line-height: 1.4; border-radius: 10px; }

  /* Phones: each card snaps to the centre with an equal peek on both sides */
  @media (max-width: 749px) {
    {{ s }} .vf-pets__wall { padding: 0 0 8px; scroll-padding: 0; gap: 12px; }
    {{ s }} .vf-pets__wall::before,
    {{ s }} .vf-pets__wall::after { content: ""; flex: 0 0 calc(7.5% - 12px); }
    {{ s }} .vf-story-wrap { scroll-snap-align: center; }
  }

  /* ---------- Tablet & desktop ---------- */
  @media (min-width: 750px) {
    {{ s }} { --t-gutter: clamp(24px, 4vw, 64px); }
    {{ s }} .vf-pets__inner { padding-top: 88px; }
    {{ s }} .vf-pets__head { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 40px; }
    {{ s }} .vf-pets__heading { font-size: clamp(36px, 2.2vw + 16px, 48px); }

    /* One line: 2 cards on tablets */
    {{ s }} .vf-pets__wall { gap: 20px; margin: 0; padding: 0 0 4px; scroll-padding: 0; }
    {{ s }} .vf-story-wrap { flex: 0 0 calc((100% - 20px) / 2); }
    {{ s }} .vf-pets__arrows { display: inline-flex; }
  }
  @media (min-width: 990px) {
    {{ s }} .vf-story-wrap { flex-basis: calc((100% - 40px) / 3); }
  }
  @media (min-width: 1200px) {
    {{ s }} .vf-story-wrap { flex-basis: calc((100% - 60px) / 4); }
  }

  @media (prefers-reduced-motion: reduce) {
    {{ s }} *, {{ s }} *::before, {{ s }} *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
{% endstyle %}

<script>
  (function () {
    if (customElements.get('vf-pet-stories')) return;

    class VfPetStories extends HTMLElement {
      connectedCallback() {
        var self = this;
        this.wall = this.querySelector('[data-wall]');
        this.cards = Array.prototype.slice.call(this.querySelectorAll('[data-story]'));
        this.empty = this.querySelector('[data-empty]');
        this.radios = Array.prototype.slice.call(this.querySelectorAll('[data-filter]'));
        this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.nav = this.querySelector('[data-nav]');
        this.bar = this.querySelector('[data-progress]');
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.onScroll = function () {
          if (self._raf) return;
          self._raf = requestAnimationFrame(function () { self._raf = null; self.updateNav(); });
        };
        if (this.wall) this.wall.addEventListener('scroll', this.onScroll, { passive: true });
        this.onResize = function () { self.updateNav(); };
        window.addEventListener('resize', this.onResize);

        this.radios.forEach(function (r) { r.addEventListener('change', function () { self.apply(r.value); }); });

        /* Follow the page's Dog / Cat switch */
        this.onSpecies = function (e) {
          if (self.dataset.follow !== 'true') return;
          var d = (e && e.detail) || {};
          var sp = d.species || d.pet || d.value;
          if (sp === 'dog' || sp === 'cat') self.select(sp);
        };
        document.addEventListener('vf:species-change', this.onSpecies);
        if (this.dataset.follow === 'true') {
          var s = null;
          try { s = new URLSearchParams(window.location.search).get('pet'); } catch (e) {}
          if (s !== 'dog' && s !== 'cat') { try { s = localStorage.getItem('vf_pet'); } catch (e) {} }
          if (s === 'dog' || s === 'cat') this.select(s);
        }

        /* Videos: tap to play, pause when scrolled away */
        this.querySelectorAll('[data-play]').forEach(function (btn) {
          var video = btn.parentElement.querySelector('video');
          if (!video) return;
          var set = function (on) { btn.setAttribute('aria-pressed', on ? 'true' : 'false'); };
          btn.addEventListener('click', function () {
            if (video.paused) { var p = video.play(); if (p && p.catch) p.catch(function () {}); set(true); }
            else { video.pause(); set(false); }
          });
          new IntersectionObserver(function (en) { if (!en[0].isIntersecting) { video.pause(); set(false); } }).observe(video);
        });

        /* Arrows move one card at a time */
        var step = function (dir) {
          if (!self.wall) return;
          var card = self.cards.filter(function (c) { return !c.hidden; })[0];
          var gap = parseFloat(getComputedStyle(self.wall).columnGap) || 20;
          var w = card ? card.getBoundingClientRect().width + gap : 320;
          self.wall.scrollBy({ left: dir * w, behavior: self.reduce.matches ? 'auto' : 'smooth' });
        };
        if (this.prevBtn) this.prevBtn.addEventListener('click', function () { step(-1); });
        if (this.nextBtn) this.nextBtn.addEventListener('click', function () { step(1); });

        /* Theme editor: scroll to the story being edited */
        this.onBlockSelect = function (e) {
          var id = e.detail && e.detail.blockId;
          var card = id && self.querySelector('[data-story][data-block-id="' + id + '"]');
          if (!card) return;
          self.select('all');
          if (self.wall && self.wall.scrollWidth > self.wall.clientWidth) {
            self.wall.scrollTo({ left: card.offsetLeft - self.wall.offsetLeft - 16, behavior: 'smooth' });
          }
        };
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        this.updateNav();
      }

      /* Progress line + arrow states; hide the nav when everything already fits */
      updateNav() {
        if (!this.wall) return;
        var max = this.wall.scrollWidth - this.wall.clientWidth;
        var fits = max <= 2;
        if (this.nav) this.nav.hidden = fits;
        if (fits) return;
        var x = this.wall.scrollLeft;
        if (this.bar) {
          var frac = this.wall.clientWidth / this.wall.scrollWidth;
          this.bar.style.width = (frac * 100).toFixed(2) + '%';
          this.bar.style.transform = 'translateX(' + ((x / max) * (1 / frac - 1) * 100).toFixed(2) + '%)';
        }
        if (this.prevBtn) this.prevBtn.disabled = x <= 2;
        if (this.nextBtn) this.nextBtn.disabled = x >= max - 2;
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.onResize);
        document.removeEventListener('vf:species-change', this.onSpecies);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      select(value) {
        this.radios.forEach(function (r) { r.checked = r.value === value; });
        this.apply(value);
      }

      apply(value) {
        var visible = 0;
        this.cards.forEach(function (c) {
          var sp = c.dataset.species;
          var ok = value === 'all' || !value || sp === value || sp === 'any';
          c.hidden = !ok;
          if (ok) visible++;
        });
        if (this.empty) this.empty.hidden = visible > 0 || !this.cards.length;
        if (this.wall) this.wall.scrollLeft = 0;
        this.updateNav();
      }
    }

    customElements.define('vf-pet-stories', VfPetStories);
  })();
</script>

