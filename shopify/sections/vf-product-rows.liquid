{%- comment -%}
  Vettofit product rows — sections/vf-product-rows.liquid  (v2, editorial split)
  Built from "Vettofit Landing Page — Shopify Section Technical Guide", section 3 (Product rows)
  and the Landing Page Guidelines. Visual direction borrowed from Graza's discipline:
  one bold colour panel, one big product photo, one huge name, one button.

  Desktop / tablet: 50 / 50 split bands. Colour panel on one side, photo on the other,
  alternating. Optional "Slider" layout shows one product at a time with arrows.
  Mobile: swipeable cards at 88% width with a peek of the next card.

  Search & AI friendly:
  - Product + ItemList structured data (JSON-LD) with the REAL product name, price,
    availability, brand, SKU / barcode and rating (only when the rating is visible).
  - A "Product facts" list (<dl>) with pack size, daily amount, days per bottle and cost per
    day, so answer engines and AI assistants can quote clear facts.
  - Semantic headings (h2 → h3), descriptive links and image alt text.
  - "Name on this page" changes only the visible name. Search data keeps the real name.

  Health facts come from product data, never typed into the section:
  vf.benefits, vf.feeding_guide, vf.ml_per_pump, vf.volume_ml, vf.species, reviews.rating.
{%- endcomment -%}

{%- liquid
  assign ss = section.settings
  assign row_blocks = section.blocks | where: 'type', 'product_row'
  assign real_count = 0
  for b in row_blocks
    if b.settings.product != blank
      assign real_count = real_count | plus: 1
    endif
  endfor
  assign heading_id = 'vf-rows-h-' | append: section.id
  assign ld_items = ''
  assign ld_pos = 0
-%}

{%- capture star_svg -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.6l2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.5l-5.1 2.8 1.1-5.7-4.3-4 5.8-.7z"/></svg>{%- endcapture -%}

<vf-product-rows
  id="vf-rows-{{ section.id }}"
  class="vf-rows vf-scheme--{{ ss.color_scheme }} vf-rows--{{ ss.layout }} vf-rows--{{ ss.width }} vf-rows--{{ ss.row_style }} vf-align--{{ ss.text_align }} vf-space-below--{{ ss.space_below }}"
  data-action="{{ ss.button_action }}"
  data-cart-add="{{ routes.cart_add_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-design="{{ request.design_mode }}"
  data-added-text="{{ ss.added_note | escape }}"
  data-view-cart="{{ ss.view_cart_label | escape }}"
  data-layout="{{ ss.layout }}"
>
  <section class="vf-rows__inner" aria-labelledby="{{ heading_id }}">
    <header class="vf-rows__head{% if ss.heading == blank and ss.intro == blank %} vf-vh{% endif %}">
      <h2 class="vf-rows__heading" id="{{ heading_id }}">{{ ss.heading | default: shop.name }}</h2>
      {%- if ss.heading != blank -%}<span class="vf-rows__signal" aria-hidden="true"></span>{%- endif -%}
      {%- if ss.intro != blank -%}<p class="vf-rows__intro">{{ ss.intro }}</p>{%- endif -%}
    </header>

    <div class="vf-rows__track" data-list role="list">
      {%- for block in row_blocks -%}
        {%- assign product = block.settings.product -%}
        {%- assign uid = section.id | append: '-' | append: block.id -%}
        {%- assign panel = block.settings.panel_color -%}

        {%- if product == blank -%}
          {%- if request.design_mode -%}
            <article class="vf-row vf-panel--{{ panel }}{% cycle '', ' is-flip' %}" data-row data-show="always" role="listitem" {{ block.shopify_attributes }}>
              <div class="vf-row__media vf-row__media--contain">{{ 'product-1' | placeholder_svg_tag: 'vf-row__ph' }}</div>
              <div class="vf-row__panel"><div class="vf-row__content">
                <p class="vf-row__eyebrow"><span>Product row</span></p>
                <h3 class="vf-row__title">Pick a product</h3>
                <p class="vf-rows__note">Choose a product for this row in the sidebar. (Only you see this note.)</p>
              </div></div>
            </article>
          {%- endif -%}
          {%- continue -%}
        {%- endif -%}

        {%- liquid
          assign variant = product.selected_or_first_available_variant

          assign species_raw = product.metafields.vf.species.value | downcase
          assign show_for = block.settings.show_for
          if show_for == 'auto'
            if species_raw contains 'dog'
              assign show_for = 'dog'
            elsif species_raw contains 'cat'
              assign show_for = 'cat'
            else
              assign show_for = 'always'
            endif
          endif

          assign pet_word = ss.pet_word_any
          assign pet_plural = ss.pet_plural_any
          assign weight = ss.cost_weight_dog
          if species_raw contains 'cat'
            assign pet_word = ss.pet_word_cat
            assign pet_plural = ss.pet_plural_cat
            assign weight = ss.cost_weight_cat
          elsif species_raw contains 'dog'
            assign pet_word = ss.pet_word_dog
            assign pet_plural = ss.pet_plural_dog
          endif

          comment
            Display name: the landing-page override, else the product's own title.
          endcomment
          assign display_name = block.settings.display_name | default: product.title
          assign name_class = ''
          if display_name.size > 34
            assign name_class = ' is-long'
          endif

          assign eyebrow = block.settings.eyebrow
          if eyebrow == blank and species_raw != blank
            assign eyebrow = ss.eyebrow_auto | replace: '[pets]', pet_plural
          endif

          comment
            Pumps per day for the example weight, from the feeding guide rows.
          endcomment
          assign pumps = 0
          assign w = weight | times: 1.0
          for r in product.metafields.vf.feeding_guide.value
            assign mn = r.min_kg.value | times: 1.0
            assign mx = r.max_kg.value | times: 1.0
            if w >= mn and w <= mx and pumps == 0
              assign pumps = r.pumps_per_day.value | default: r.pumps.value | default: 0 | times: 1.0
            endif
          endfor
          assign ml_pp = product.metafields.vf.ml_per_pump.value | default: 0 | times: 1.0
          assign daily_ml = ml_pp | times: pumps
          assign pumps_int = pumps | round

          assign has_plans = false
          if ss.show_subscribe and product.selling_plan_groups.size > 0
            assign has_plans = true
          endif
          assign first_group = product.selling_plan_groups.first
          assign save_text = ''
          if has_plans
            assign adj = first_group.selling_plans.first.price_adjustments.first
            if adj.value_type == 'percentage' and adj.value > 0
              assign save_text = adj.value | append: '%'
            endif
          endif

          assign media_fit = 'contain'
          if block.settings.image != blank
            assign media_fit = 'cover'
          endif
          assign video = block.settings.video
          if video == blank
            assign video = product.metafields.vf.ritual_video.value
          endif
          if video != blank
            assign media_fit = 'cover'
          endif

          assign vol0 = variant.metafields.vf.volume_ml.value | default: product.metafields.vf.volume_ml.value | default: 0 | times: 1.0
          assign days0 = 0
          if vol0 > 0 and daily_ml > 0
            assign days0 = vol0 | divided_by: daily_ml | floor
          endif
          assign per_day0 = ''
          if days0 > 0
            assign per_day_cents = variant.price | divided_by: days0 | divided_by: 100.0 | round | times: 100
            assign per_day0 = per_day_cents | money_without_trailing_zeros
          endif
          assign size0 = variant.title
          if product.has_only_default_variant
            assign size0 = ''
            if vol0 > 0
              assign size0 = vol0 | round | append: ' ml'
            endif
          endif

          assign mrp0 = variant.compare_at_price | default: 0
          assign off0 = 0
          if mrp0 > variant.price
            assign off0 = mrp0 | minus: variant.price | times: 100.0 | divided_by: mrp0 | round
          endif

          assign rating = product.metafields.reviews.rating.value
          assign rating_count = product.metafields.reviews.rating_count.value | default: 0
          assign show_stars = false
          if ss.show_rating and rating != blank and rating_count > 0
            assign show_stars = true
          endif
        -%}

        {%- comment -%} Per-variant data for live price / facts updates {%- endcomment -%}
        {%- capture row_json -%}
          {"variants":[
            {%- for v in product.variants -%}
              {%- liquid
                assign vol = v.metafields.vf.volume_ml.value | default: product.metafields.vf.volume_ml.value | default: 0 | times: 1.0
                assign days = 0
                if vol > 0 and daily_ml > 0
                  assign days = vol | divided_by: daily_ml | floor
                endif
                assign v_size = v.title
                if product.has_only_default_variant
                  assign v_size = ''
                  if vol > 0
                    assign v_size = vol | round | append: ' ml'
                  endif
                endif
              -%}
              {"id":{{ v.id }},"available":{{ v.available | json }},"price":{{ v.price }},"compare":{{ v.compare_at_price | default: 0 }},"days":{{ days }},"size":{{ v_size | json }},"plans":{
                {%- for a in v.selling_plan_allocations -%}"{{ a.selling_plan.id }}":{{ a.price }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
              }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]}
        {%- endcapture -%}

        {%- comment -%} ---------- Structured data for this product (search engines & AI) ---------- {%- endcomment -%}
        {%- liquid
          assign ld_pos = ld_pos | plus: 1
          assign ld_url = shop.url | append: product.url
          assign ld_img = ''
          if product.featured_image != blank
            assign ld_img = product.featured_image | image_url: width: 1200 | prepend: 'https:'
          endif
          assign ld_desc = product.description | strip_html | strip_newlines | truncate: 300
          if ld_desc == blank
            assign ld_desc = block.settings.short_line | strip_html
          endif
        -%}
        {%- capture ld_one -%}
          {"@type":"ListItem","position":{{ ld_pos }},"item":{
            "@type":"Product",
            "name":{{ product.title | json }},
            "url":{{ ld_url | json }},
            {%- if ld_img != '' -%}"image":{{ ld_img | json }},{%- endif -%}
            {%- if ld_desc != blank -%}"description":{{ ld_desc | json }},{%- endif -%}
            {%- if product.vendor != blank -%}"brand":{"@type":"Brand","name":{{ product.vendor | json }}},{%- endif -%}
            {%- if variant.sku != blank -%}"sku":{{ variant.sku | json }},{%- endif -%}
            {%- if variant.barcode != blank -%}"gtin":{{ variant.barcode | json }},{%- endif -%}
            {%- if product.type != blank -%}"category":{{ product.type | json }},{%- endif -%}
            {%- if show_stars -%}"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ rating.rating | json }},"bestRating":{{ rating.scale_max | default: 5 | json }},"ratingCount":{{ rating_count | json }}},{%- endif -%}
            {%- if product.variants.size > 1 -%}
              "offers":{"@type":"AggregateOffer","priceCurrency":{{ cart.currency.iso_code | json }},"lowPrice":{{ product.price_min | money_without_currency | remove: ',' | json }},"highPrice":{{ product.price_max | money_without_currency | remove: ',' | json }},"offerCount":{{ product.variants.size }},"availability":"https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"}
            {%- else -%}
              "offers":{"@type":"Offer","url":{{ ld_url | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"price":{{ variant.price | money_without_currency | remove: ',' | json }},"availability":"https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}","itemCondition":"https://schema.org/NewCondition"{% if mrp0 > variant.price %},"priceSpecification":{"@type":"UnitPriceSpecification","priceType":"https://schema.org/StrikethroughPrice","price":{{ mrp0 | money_without_currency | remove: ',' | json }},"priceCurrency":{{ cart.currency.iso_code | json }}}{% endif %}}
            {%- endif -%}
          }}
        {%- endcapture -%}
        {%- liquid
          if ld_items != ''
            assign ld_items = ld_items | append: ','
          endif
          assign ld_items = ld_items | append: ld_one
        -%}

        <article
          class="vf-row vf-panel--{{ panel }}{% cycle '', ' is-flip' %}"
          role="listitem"
          aria-labelledby="vf-name-{{ uid }}"
          data-row
          data-index="{{ forloop.index }}"
          data-show="{{ show_for }}"
          data-species="{{ show_for }}"
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} ---------- Photo / video side ---------- {%- endcomment -%}
          <div class="vf-row__media vf-row__media--{{ media_fit }}">
            {%- if video != blank -%}
              {{ video | video_tag: muted: true, loop: true, playsinline: true, autoplay: false, controls: false, preload: 'none', class: 'vf-row__video', image_size: '1200x' }}
              <button class="vf-row__play" type="button" aria-label="Play video" aria-pressed="false" data-play>
                <svg class="vf-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
                <svg class="vf-i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="5.5" width="3.5" height="13" rx="1"/><rect x="13.5" y="5.5" width="3.5" height="13" rx="1"/></svg>
              </button>
            {%- else -%}
              {%- liquid
                assign img = block.settings.image
                if img == blank
                  assign img = product.featured_image
                endif
                assign alt = img.alt
                if alt == blank
                  assign alt = product.title
                endif
                assign alt = alt | escape
              -%}
              <a href="{{ product.url }}" class="vf-row__media-link" tabindex="-1" aria-hidden="true">
                {%- if img != blank -%}
                  {{ img | image_url: width: 1600 | image_tag: widths: '430, 600, 860, 1100, 1600', sizes: '(min-width: 750px) 50vw, 88vw', loading: 'lazy', class: 'vf-row__img', alt: alt }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'vf-row__ph' }}
                {%- endif -%}
              </a>
            {%- endif -%}
            {%- if block.settings.label != 'none' -%}
              <span class="vf-row__label">
                {%- case block.settings.label -%}
                  {%- when 'bestseller' -%}{{ ss.label_bestseller }}
                  {%- when 'new' -%}{{ ss.label_new }}
                  {%- when 'back' -%}{{ ss.label_back }}
                {%- endcase -%}
              </span>
            {%- endif -%}
          </div>

          {%- comment -%} ---------- Colour panel ---------- {%- endcomment -%}
          <div class="vf-row__panel">
            <div class="vf-row__content">
              {%- if request.design_mode and show_for != 'always' -%}
                <p class="vf-rows__note">Shows when {{ show_for | capitalize }} is selected. (Only you see this.)</p>
              {%- endif -%}

              {%- if eyebrow != blank -%}
                <p class="vf-row__eyebrow"><span>{{ eyebrow }}</span></p>
              {%- endif -%}

              <h3 class="vf-row__title{{ name_class }}" id="vf-name-{{ uid }}">
                <a href="{{ product.url }}" title="{{ product.title | escape }}">{{ display_name }}</a>
              </h3>

              {%- if block.settings.short_line != blank -%}
                <p class="vf-row__line">{{ block.settings.short_line }}</p>
              {%- endif -%}

              {%- if show_stars -%}
                {%- liquid
                  assign r_val = rating.rating | times: 1.0
                  assign r_max = rating.scale_max | default: 5 | times: 1.0
                  assign r_pct = r_val | divided_by: r_max | times: 100 | round
                -%}
                <p class="vf-row__rating">
                  <span class="vf-stars" aria-hidden="true">
                    <span class="vf-stars__base">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</span>
                    <span class="vf-stars__fill" style="width: {{ r_pct }}%;">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</span>
                  </span>
                  <span class="vf-row__rating-text">{{ r_val | round: 1 }}<span class="vf-vh"> out of {{ r_max | round }} stars from</span> <span class="vf-row__rating-count">({{ rating_count }}<span class="vf-vh"> reviews</span>)</span></span>
                </p>
              {%- endif -%}

              {%- comment -%} Benefits from the product's vf.benefits metafield {%- endcomment -%}
              {%- assign benefits = product.metafields.vf.benefits.value -%}
              {%- assign benefits_limit = block.settings.benefits_count | default: 3 | plus: 0 -%}
              {%- if benefits != blank -%}
                <ul class="vf-benefits" role="list" aria-label="Benefits">
                  {%- for bnf in benefits limit: benefits_limit -%}
                    {%- assign icon = bnf.icon.value | downcase -%}
                    <li class="vf-benefit" {% if bnf.support_line.value != blank %}title="{{ bnf.support_line.value | escape }}"{% endif %}>
                      <span class="vf-benefit__icon" aria-hidden="true">
                        {%- if icon contains 'coat' or icon contains 'skin' or icon contains 'shine' -%}
                          <svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
                        {%- elsif icon contains 'heart' -%}
                          <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
                        {%- elsif icon contains 'joint' or icon contains 'mobil' -%}
                          <svg viewBox="0 0 24 24"><path d="M13 3L6 13h5l-1 8 7-10h-5z"/></svg>
                        {%- elsif icon contains 'gut' or icon contains 'digest' -%}
                          <svg viewBox="0 0 24 24"><path d="M8 4v5a4 4 0 0 0 8 0M16 4v3M12 13v7"/></svg>
                        {%- elsif icon contains 'calm' or icon contains 'sleep' -%}
                          <svg viewBox="0 0 24 24"><path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5z"/></svg>
                        {%- elsif icon contains 'dental' or icon contains 'teeth' or icon contains 'tooth' -%}
                          <svg viewBox="0 0 24 24"><path d="M7 4c-2 0-3 2-3 4 0 4 2 5 2.5 9 .3 2 2.3 2 2.6 0L10 13h4l.9 4c.3 2 2.3 2 2.6 0 .5-4 2.5-5 2.5-9 0-2-1-4-3-4-2 0-3 1-5 1S9 4 7 4z"/></svg>
                        {%- elsif icon contains 'immun' or icon contains 'shield' -%}
                          <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 24 24"><polyline points="5 12.5 10 17 19 7"/></svg>
                        {%- endif -%}
                      </span>
                      <span>{{ bnf.title.value }}</span>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif request.design_mode -%}
                <p class="vf-rows__note">Benefits come from this product's "benefits" metafield (vf.benefits). (Only you see this note.)</p>
              {%- endif -%}

              {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
              <form class="vf-buy" action="{{ routes.cart_add_url }}" method="post" data-buy novalidate>
                <input type="hidden" name="id" value="{{ variant.id }}" data-variant-input>
                <input type="hidden" name="quantity" value="1">
                {%- if has_plans -%}<input type="hidden" name="selling_plan" value="{% if product.requires_selling_plan %}{{ first_group.selling_plans.first.id }}{% endif %}" data-plan-input>{%- endif -%}
                <script type="application/json" data-row-json>{{ row_json | strip_newlines }}</script>

                {%- unless product.has_only_default_variant -%}
                  <fieldset class="vf-sizes">
                    <legend class="vf-vh">{{ ss.size_label | default: product.options.first }}</legend>
                    <div class="vf-sizes__chips">
                      {%- for v in product.variants -%}
                        <label class="vf-chip{% unless v.available %} is-soldout{% endunless %}">
                          <input type="radio" name="size-{{ uid }}" value="{{ v.id }}"{% if v.id == variant.id %} checked{% endif %} data-size>
                          <span>{{ v.title }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endunless -%}

                {%- if has_plans -%}
                  <fieldset class="vf-po">
                    <legend class="vf-vh">Purchase option</legend>
                    <div class="vf-po__seg">
                      {%- unless product.requires_selling_plan -%}
                        <label class="vf-po__opt">
                          <input type="radio" name="po-{{ uid }}" value="once" checked data-po>
                          <span>{{ ss.one_time_label }}</span>
                        </label>
                      {%- endunless -%}
                      <label class="vf-po__opt">
                        <input type="radio" name="po-{{ uid }}" value="sub"{% if product.requires_selling_plan %} checked{% endif %} data-po>
                        <span>{{ ss.subscribe_label }}{% if save_text != '' %} <b class="vf-po__save">−{{ save_text }}</b>{% endif %}</span>
                      </label>
                    </div>
                    <div class="vf-po__freq" data-freq{% unless product.requires_selling_plan %} hidden{% endunless %}>
                      {%- if ss.subscribe_note != blank -%}<p class="vf-po__note">{{ ss.subscribe_note }}</p>{%- endif -%}
                      <div class="vf-select">
                        <select id="plan-{{ uid }}" data-plan aria-label="{{ ss.frequency_label | escape }}">
                          {%- for group in product.selling_plan_groups -%}
                            {%- for plan in group.selling_plans -%}
                              <option value="{{ plan.id }}">{{ plan.name }}</option>
                            {%- endfor -%}
                          {%- endfor -%}
                        </select>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                      </div>
                    </div>
                  </fieldset>
                {%- endif -%}

                <div class="vf-price" aria-live="polite">
                  <p class="vf-price__row">
                    {%- if ss.show_mrp -%}
                      <span class="vf-price__mrp" data-compare{% unless mrp0 > variant.price %} hidden{% endunless %}><span class="vf-price__mrp-label" data-mrp-label>{{ ss.mrp_label }}</span> <s data-compare-amount>{{ mrp0 | money }}</s></span>
                    {%- endif -%}
                    <span class="vf-price__now" data-price>{{ variant.price | money }}</span>
                    {%- if ss.show_mrp and ss.show_discount_badge -%}
                      <span class="vf-price__off" data-off{% unless off0 > 0 %} hidden{% endunless %}>−<span data-off-pct>{{ off0 }}</span>%</span>
                    {%- endif -%}
                  </p>
                  {%- if ss.tax_note != blank -%}<p class="vf-price__tax">{{ ss.tax_note }}</p>{%- endif -%}
                </div>

                {%- if ss.button_action == 'product' -%}
                  <a class="vf-btn" href="{{ product.url }}">{{ ss.product_button_label }}</a>
                {%- else -%}
                  <button class="vf-btn" type="submit" data-atc data-sold-out="{{ ss.sold_out_label | escape }}"{% unless variant.available %} disabled{% endunless %}>
                    <span class="vf-btn__label">
                      <span data-atc-label>{% if variant.available %}{{ ss.button_label }}{% else %}{{ ss.sold_out_label }}{% endif %}</span>
                    </span>
                    <span class="vf-btn__done" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><polyline points="5 12.5 10 17 19 7"/></svg>
                      <span>{{ ss.added_label }}</span>
                    </span>
                  </button>
                {%- endif -%}

                {%- if ss.show_cost and ss.cost_text != blank -%}
                  {%- capture cost_html -%}{{ ss.cost_text | replace: '[price]', '<b data-per-day>PERDAY</b>' | replace: '[weight]', weight | replace: '[pet]', pet_word }}{%- endcapture -%}
                  <p class="vf-row__perday" data-perday-line{% if per_day0 == '' %} hidden{% endif %}>{{ cost_html | replace: 'PERDAY', per_day0 }}</p>
                {%- endif -%}
                <p class="vf-buy__status" role="status" aria-live="polite" data-status></p>
                {%- if ss.payment_note != blank -%}<p class="vf-buy__note">{{ ss.payment_note }}</p>{%- endif -%}
              </form>

              {%- comment -%} ---------- Product facts: clear, quotable facts for shoppers, search and AI ---------- {%- endcomment -%}
              {%- if ss.show_facts -%}
                <details class="vf-facts"{% if ss.facts_open %} open{% endif %}>
                  <summary>
                    <span>{{ ss.facts_title }}</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </summary>
                  <dl class="vf-facts__list">
                    {%- if pet_plural != blank -%}
                      <div><dt>{{ ss.facts_for }}</dt><dd>{{ pet_plural | capitalize }}</dd></div>
                    {%- endif -%}
                    <div data-fact-size-row{% if size0 == '' %} hidden{% endif %}><dt>{{ ss.facts_size }}</dt><dd data-fact-size>{{ size0 }}</dd></div>
                    {%- if pumps_int > 0 -%}
                      {%- liquid
                        assign pump_word = ss.pump_word_many
                        if pumps_int == 1
                          assign pump_word = ss.pump_word_one
                        endif
                        assign pumps_text = pumps_int | append: ' ' | append: pump_word
                      -%}
                      <div><dt>{{ ss.facts_daily }}</dt><dd>{{ ss.facts_daily_value | replace: '[pumps]', pumps_text | replace: '[weight]', weight | replace: '[pet]', pet_word }}</dd></div>
                    {%- endif -%}
                    <div data-fact-days-row{% if days0 == 0 %} hidden{% endif %}><dt>{{ ss.facts_lasts }}</dt><dd>{{ ss.facts_lasts_value | replace: '[days]', '<span data-fact-days>DAYS</span>' | replace: 'DAYS', days0 }}</dd></div>
                    <div data-fact-cost-row{% if per_day0 == '' %} hidden{% endif %}><dt>{{ ss.facts_cost }}</dt><dd data-fact-cost>{{ per_day0 }}</dd></div>
                    <div><dt>{{ ss.facts_price }}</dt><dd data-fact-price>{{ variant.price | money }}</dd></div>
                    {%- if ss.show_mrp -%}
                      <div data-fact-mrp-row{% unless mrp0 > variant.price %} hidden{% endunless %}><dt>{{ ss.mrp_label }}</dt><dd data-fact-mrp>{{ mrp0 | money }}</dd></div>
                    {%- endif -%}
                  </dl>
                  <a class="vf-facts__more" href="{{ product.url }}">{{ ss.details_link_label }}<span class="vf-vh">: {{ product.title }}</span> →</a>
                </details>
              {%- endif -%}

              {%- if ss.layout == 'slider' and real_count > 1 -%}
                <div class="vf-arrows" role="group" aria-label="More products">
                  <button type="button" class="vf-arrow" data-prev aria-label="Previous product"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="11 6 5 12 11 18"/></svg></button>
                  <button type="button" class="vf-arrow" data-next aria-label="Next product"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></button>
                  <span class="vf-arrows__count" aria-hidden="true"><span data-count-now>{{ forloop.index }}</span> / <span data-count-all>{{ real_count }}</span></span>
                </div>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if real_count == 0 and request.design_mode -%}
      <p class="vf-rows__note">Add a "Product row" block and pick a product. (Only you see this note.)</p>
    {%- endif -%}
  </section>

  {%- if ld_items != '' -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"ItemList","name":{{ ss.heading | default: shop.name | strip_html | json }},"numberOfItems":{{ ld_pos }},"itemListElement":[{{ ld_items | strip_newlines }}]}
    </script>
  {%- endif -%}

  <script type="application/json" data-money>{{ shop.money_format | json }}</script>
  <script type="application/json" data-labels>{{ ss.button_label | json }}</script>
</vf-product-rows>

{%- capture s -%}#vf-rows-{{ section.id }}{%- endcapture -%}
{% style %}
  /* ---------- Section background (heading area and gaps) ---------- */
  {{ s }}.vf-scheme--white  { --r-bg: var(--vf-white, #FFFFFF); --r-fg: var(--vf-carbon, #111111); --r-muted: rgba(17,17,17,.66); }
  {{ s }}.vf-scheme--chalk  { --r-bg: var(--vf-chalk, #F7F5EF); --r-fg: var(--vf-carbon, #111111); --r-muted: rgba(17,17,17,.66); }
  {{ s }}.vf-scheme--plum   { --r-bg: var(--vf-plum, #2B1B3A); --r-fg: #FFFFFF; --r-muted: rgba(255,255,255,.76); }
  {{ s }}.vf-scheme--carbon { --r-bg: var(--vf-carbon, #111111); --r-fg: var(--vf-chalk, #F7F5EF); --r-muted: rgba(247,245,239,.74); }

  /* ---------- Panel colours (brand surfaces only) ---------- */
  {{ s }} .vf-panel--accent { --p-bg: var(--vf-accent, #FF8A74); --p-fg: var(--vf-carbon, #111111); --p-muted: rgba(17,17,17,.76); --p-line: rgba(17,17,17,.3); --p-chip: rgba(255,255,255,.34); --p-btn-bg: var(--vf-carbon, #111111); --p-btn-fg: #FFFFFF; --p-sel-bg: var(--vf-carbon, #111111); --p-sel-fg: #FFFFFF; }
  {{ s }} .vf-panel--chalk  { --p-bg: var(--vf-chalk, #F7F5EF); --p-fg: var(--vf-carbon, #111111); --p-muted: rgba(17,17,17,.68); --p-line: rgba(17,17,17,.18); --p-chip: #FFFFFF; --p-btn-bg: var(--vf-carbon, #111111); --p-btn-fg: #FFFFFF; --p-sel-bg: var(--vf-carbon, #111111); --p-sel-fg: #FFFFFF; }
  {{ s }} .vf-panel--white  { --p-bg: var(--vf-white, #FFFFFF); --p-fg: var(--vf-carbon, #111111); --p-muted: rgba(17,17,17,.68); --p-line: rgba(17,17,17,.16); --p-chip: var(--vf-chalk, #F7F5EF); --p-btn-bg: var(--vf-carbon, #111111); --p-btn-fg: #FFFFFF; --p-sel-bg: var(--vf-carbon, #111111); --p-sel-fg: #FFFFFF; }
  {{ s }} .vf-panel--plum   { --p-bg: var(--vf-plum, #2B1B3A); --p-fg: #FFFFFF; --p-muted: rgba(255,255,255,.78); --p-line: rgba(255,255,255,.26); --p-chip: rgba(255,255,255,.08); --p-btn-bg: var(--vf-chalk, #F7F5EF); --p-btn-fg: var(--vf-carbon, #111111); --p-sel-bg: var(--vf-chalk, #F7F5EF); --p-sel-fg: var(--vf-carbon, #111111); }
  {{ s }} .vf-panel--carbon { --p-bg: var(--vf-carbon, #111111); --p-fg: var(--vf-chalk, #F7F5EF); --p-muted: rgba(247,245,239,.76); --p-line: rgba(247,245,239,.24); --p-chip: rgba(255,255,255,.07); --p-btn-bg: var(--vf-teal, #09D1C7); --p-btn-fg: var(--vf-carbon, #111111); --p-sel-bg: var(--vf-chalk, #F7F5EF); --p-sel-fg: var(--vf-carbon, #111111); }

  {{ s }} {
    --r-signal: var(--vf-teal, #09D1C7);
    --r-ink: var(--vf-carbon, #111111);
    --r-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --r-gutter: 16px;
    --r-font: var(--vf-font-body, "Inter", var(--font-body-family, system-ui, -apple-system, "Segoe UI", sans-serif));
    --r-font-display: var(--vf-font-display, "Inter Display", "Inter", var(--font-heading-family, system-ui, -apple-system, "Segoe UI", sans-serif));
    display: block;
    background: var(--r-bg);
    color: var(--r-fg);
    font-family: var(--r-font);
    letter-spacing: 0;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  {{ s }} *, {{ s }} *::before, {{ s }} *::after { box-sizing: border-box; }
  {{ s }} h2, {{ s }} h3, {{ s }} p, {{ s }} ul, {{ s }} li, {{ s }} dl, {{ s }} dt, {{ s }} dd, {{ s }} fieldset, {{ s }} legend {
    margin: 0; padding: 0; border: 0; letter-spacing: 0; text-transform: none; font-style: normal; list-style: none;
  }
  {{ s }} li::before, {{ s }} li::marker { content: none; }
  {{ s }} [hidden] { display: none !important; }
  {{ s }}.vf-space-below--none   { padding-bottom: 0; }
  {{ s }}.vf-space-below--small  { padding-bottom: 24px; }
  {{ s }}.vf-space-below--medium { padding-bottom: 48px; }
  {{ s }}.vf-space-below--large  { padding-bottom: 80px; }

  /* ---------- Heading ---------- */
  {{ s }} .vf-rows__head { max-width: 1440px; margin: 0 auto; padding: 48px var(--r-gutter) 24px; }
  {{ s }}.vf-align--center .vf-rows__head { text-align: center; }
  {{ s }} .vf-rows__heading { font-family: var(--r-font-display); font-weight: 700; font-size: 30px; line-height: 1.08; letter-spacing: -0.02em; color: var(--r-fg); text-wrap: balance; }
  {{ s }} .vf-rows__signal { display: block; width: 48px; height: 2px; margin-top: 16px; border-radius: 2px; background: var(--r-signal); }
  {{ s }}.vf-align--center .vf-rows__signal { margin-left: auto; margin-right: auto; }
  {{ s }} .vf-rows__intro { margin-top: 14px; font-size: 17px; line-height: 1.5; color: var(--r-muted); }
  {{ s }}.vf-align--center .vf-rows__intro { margin-left: auto; margin-right: auto; max-width: 52ch; }

  /* ---------- Mobile: swipeable cards ---------- */
  {{ s }} .vf-rows__track {
    display: flex; gap: 12px;
    padding: 0 var(--r-gutter) 8px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 var(--r-gutter);
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  {{ s }} .vf-rows__track::-webkit-scrollbar { display: none; }
  {{ s }} .vf-row {
    position: relative;
    flex: 0 0 88%;
    scroll-snap-align: start;
    display: flex; flex-direction: column;
    border-radius: 24px; overflow: hidden;
    background: var(--p-bg); color: var(--p-fg);
  }
  {{ s }} .vf-rows__track.is-single .vf-row { flex-basis: 100%; }

  {{ s }} .vf-row__media { position: relative; aspect-ratio: 1 / 1; background: #FFFFFF; overflow: hidden; }
  {{ s }} .vf-row__media-link { display: block; width: 100%; height: 100%; }
  {{ s }} .vf-row__img, {{ s }} .vf-row__media video, {{ s }} .vf-row__ph { display: block; width: 100%; height: 100%; }
  {{ s }} .vf-row__media--contain .vf-row__img { object-fit: contain; padding: 5%; }
  {{ s }} .vf-row__media--cover .vf-row__img, {{ s }} .vf-row__media video { object-fit: cover; }
  {{ s }} .vf-row__ph { background: var(--vf-chalk, #F7F5EF); fill: rgba(17,17,17,.35); }

  {{ s }} .vf-row__label {
    position: absolute; top: 16px; left: 16px;
    padding: 7px 14px; border-radius: 999px;
    background: var(--vf-carbon, #111111); color: #FFFFFF;
    font-size: 12px; font-weight: 700; line-height: 1.1; letter-spacing: 0.06em; text-transform: uppercase;
  }
  {{ s }} .vf-row__play {
    position: absolute; right: 16px; bottom: 16px; width: 48px; height: 48px; border-radius: 999px; border: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(17,17,17,.72); color: #FFFFFF; cursor: pointer;
  }
  {{ s }} .vf-row__play svg { width: 20px; height: 20px; fill: currentColor; }
  {{ s }} .vf-row__play .vf-i-pause { display: none; }
  {{ s }} .vf-row__play[aria-pressed="true"] .vf-i-play { display: none; }
  {{ s }} .vf-row__play[aria-pressed="true"] .vf-i-pause { display: block; }

  /* ---------- Panel content ---------- */
  {{ s }} .vf-row__panel { flex: 1 1 auto; display: flex; background: var(--p-bg); color: var(--p-fg); }
  {{ s }} .vf-row__content { width: 100%; display: flex; flex-direction: column; gap: 16px; padding: 28px 20px 24px; }
  {{ s }}.vf-align--center .vf-row__content { align-items: center; text-align: center; }

  {{ s }} .vf-row__eyebrow { display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--p-fg); }
  {{ s }} .vf-row__eyebrow::before, {{ s }} .vf-row__eyebrow::after { content: ""; width: 22px; height: 2px; border-radius: 2px; background: var(--r-signal); }
  {{ s }}.vf-align--left .vf-row__eyebrow::before { display: none; }

  {{ s }} .vf-row__title {
    font-family: var(--r-font-display); font-weight: 800;
    font-size: 40px; line-height: 0.98; letter-spacing: -0.035em;
    color: var(--p-fg); text-wrap: balance;
  }
  {{ s }} .vf-row__title.is-long { font-size: 28px; line-height: 1.08; letter-spacing: -0.02em; }
  {{ s }} .vf-row__title a { color: inherit; text-decoration: none; }
  {{ s }} .vf-row__title a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  {{ s }} .vf-row__line { font-size: 17px; line-height: 1.45; color: var(--p-muted); max-width: 34ch; }

  {{ s }} .vf-row__rating { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--p-muted); font-variant-numeric: tabular-nums; }
  {{ s }} .vf-stars { position: relative; display: inline-block; line-height: 0; }
  {{ s }} .vf-stars__base, {{ s }} .vf-stars__fill { display: inline-flex; gap: 2px; white-space: nowrap; }
  {{ s }} .vf-stars__fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; }
  {{ s }} .vf-stars svg { width: 16px; height: 16px; flex-shrink: 0; }
  {{ s }} .vf-stars__base svg { fill: var(--p-line); }
  {{ s }} .vf-stars__fill svg { fill: var(--p-fg); }
  {{ s }} .vf-row__rating-text { color: var(--p-fg); font-weight: 700; }
  {{ s }} .vf-row__rating-count { color: var(--p-muted); font-weight: 400; }

  {{ s }} .vf-benefits { display: flex; flex-wrap: wrap; gap: 8px; }
  {{ s }}.vf-align--center .vf-benefits { justify-content: center; }
  {{ s }} .vf-benefit {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 36px; padding: 0 14px 0 6px; border-radius: 999px;
    background: var(--p-chip); border: 1px solid var(--p-line);
    font-size: 14px; font-weight: 600; line-height: 1.2; color: var(--p-fg);
  }
  {{ s }} .vf-benefit__icon { width: 26px; height: 26px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: var(--p-fg); color: var(--p-bg); flex-shrink: 0; }
  {{ s }} .vf-benefit__icon svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- Buy box ---------- */
  {{ s }} .vf-buy { display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 400px; margin-top: 4px; }
  {{ s }} .vf-sizes__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  {{ s }}.vf-align--center .vf-sizes__chips { justify-content: center; }
  {{ s }} .vf-chip { position: relative; }
  {{ s }} .vf-chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  {{ s }} .vf-chip span {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; min-width: 72px; padding: 0 16px; border-radius: 999px;
    border: 1px solid var(--p-line); background: var(--p-chip);
    font-size: 15px; font-weight: 600; color: var(--p-fg); font-variant-numeric: tabular-nums;
  }
  {{ s }} .vf-chip input:checked + span { background: var(--p-sel-bg); color: var(--p-sel-fg); border-color: var(--p-sel-bg); }
  {{ s }} .vf-chip input:focus-visible + span { outline: 2px solid var(--p-fg); outline-offset: 2px; }
  {{ s }} .vf-chip.is-soldout span { opacity: .5; text-decoration: line-through; }

  {{ s }} .vf-po { display: grid; gap: 8px; }
  {{ s }} .vf-po__seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; padding: 4px; border-radius: 999px; background: var(--p-chip); border: 1px solid var(--p-line); }
  {{ s }} .vf-po__opt { position: relative; }
  {{ s }} .vf-po__opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; z-index: 1; }
  {{ s }} .vf-po__opt span {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    min-height: 44px; padding: 0 12px; border-radius: 999px;
    font-size: 14px; font-weight: 600; line-height: 1.15; color: var(--p-fg); text-align: center;
    transition: background-color 180ms ease, color 180ms ease;
  }
  {{ s }} .vf-po__opt input:checked + span { background: var(--p-sel-bg); color: var(--p-sel-fg); }
  {{ s }} .vf-po__opt input:focus-visible + span { outline: 2px solid var(--p-fg); outline-offset: 2px; }
  {{ s }} .vf-po__save { padding: 2px 7px; border-radius: 999px; background: var(--r-signal); color: var(--r-ink); font-size: 12px; font-weight: 800; }
  {{ s }} .vf-po__freq { display: grid; gap: 8px; }
  {{ s }} .vf-po__note { font-size: 13px; color: var(--p-muted); }
  {{ s }} .vf-select { position: relative; }
  {{ s }} .vf-select select {
    width: 100%; min-height: 48px; padding: 0 40px 0 16px;
    border: 1px solid var(--p-line); border-radius: 14px; background: var(--p-chip); color: var(--p-fg);
    font: inherit; font-size: 16px; -webkit-appearance: none; appearance: none; cursor: pointer;
  }
  {{ s }} .vf-select select option { color: #111111; background: #FFFFFF; }
  {{ s }} .vf-select svg { position: absolute; right: 14px; top: 50%; width: 18px; height: 18px; transform: translateY(-50%); fill: none; stroke: var(--p-fg); stroke-width: 1.75; pointer-events: none; }

  /* Primary button: price inside, so the decision is one tap */
  {{ s }} .vf-btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    width: 100%; min-height: 56px; padding: 0 24px; border: 0; border-radius: 14px;
    background: var(--p-btn-bg); color: var(--p-btn-fg);
    font-family: var(--r-font); font-size: 16px; font-weight: 700; letter-spacing: 0;
    text-decoration: none; cursor: pointer; overflow: hidden; -webkit-tap-highlight-color: transparent;
    transition: transform 180ms var(--r-ease);
  }
  @media (hover: hover) { {{ s }} .vf-btn:hover { transform: translateY(-2px); } }
  {{ s }} .vf-btn:active { transform: translateY(1px); }
  {{ s }} .vf-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
  {{ s }} .vf-btn__label { display: inline-flex; align-items: baseline; gap: 8px; font-variant-numeric: tabular-nums; }

  /* Price: crossed-out MRP, selling price, discount badge */
  {{ s }} .vf-price { display: grid; gap: 2px; }
  {{ s }} .vf-price__row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; font-variant-numeric: tabular-nums; }
  {{ s }}.vf-align--center .vf-price__row { justify-content: center; }
  {{ s }} .vf-price__mrp { font-size: 15px; font-weight: 500; color: var(--p-muted); white-space: nowrap; }
  {{ s }} .vf-price__mrp s { text-decoration-thickness: 1.5px; }
  {{ s }} .vf-price__mrp-label { font-size: 13px; }
  {{ s }} .vf-price__now { font-family: var(--r-font-display); font-size: 30px; font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; color: var(--p-fg); }
  {{ s }} .vf-price__off { align-self: center; padding: 3px 9px; border-radius: 999px; background: var(--r-signal); color: var(--r-ink); font-size: 13px; font-weight: 800; line-height: 1.2; }
  {{ s }} .vf-price__tax { font-size: 12px; color: var(--p-muted); }
  {{ s }} .vf-btn[aria-busy="true"] .vf-btn__label { opacity: .55; }
  {{ s }} .vf-btn__label, {{ s }} .vf-btn__done { transition: opacity 200ms ease, transform 200ms var(--r-ease); }
  {{ s }} .vf-btn__done { position: absolute; inset: 0; display: inline-flex; align-items: center; justify-content: center; gap: 8px; opacity: 0; transform: translateY(8px); }
  {{ s }} .vf-btn__done svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  {{ s }} .vf-btn.is-added .vf-btn__label { opacity: 0; transform: translateY(-8px); }
  {{ s }} .vf-btn.is-added .vf-btn__done { opacity: 1; transform: none; }

  {{ s }} .vf-row__perday { font-size: 14px; color: var(--p-muted); font-variant-numeric: tabular-nums; }
  {{ s }} .vf-row__perday b { color: var(--p-fg); font-weight: 700; }
  {{ s }} .vf-buy__status { font-size: 14px; color: var(--p-fg); }
  {{ s }} .vf-buy__status:empty { display: none; }
  {{ s }} .vf-buy__status a { color: inherit; font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  {{ s }} .vf-buy__status.is-error { font-weight: 600; }
  {{ s }} .vf-buy__note { font-size: 13px; color: var(--p-muted); }

  /* Product facts */
  {{ s }} .vf-facts { width: 100%; max-width: 400px; border-top: 1px solid var(--p-line); text-align: left; }
  {{ s }} .vf-facts summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 48px; cursor: pointer; list-style: none;
    font-size: 14px; font-weight: 700; color: var(--p-fg);
  }
  {{ s }} .vf-facts summary::-webkit-details-marker { display: none; }
  {{ s }} .vf-facts summary svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.75; transition: transform 200ms var(--r-ease); }
  {{ s }} .vf-facts[open] summary svg { transform: rotate(180deg); }
  {{ s }} .vf-facts__list { display: grid; padding-bottom: 8px; }
  {{ s }} .vf-facts__list > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px dashed var(--p-line); font-size: 14px; line-height: 1.35; }
  {{ s }} .vf-facts__list dt { color: var(--p-muted); }
  {{ s }} .vf-facts__list dd { color: var(--p-fg); font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
  {{ s }} .vf-facts__more { display: inline-flex; min-height: 44px; align-items: center; font-size: 14px; font-weight: 700; color: var(--p-fg); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }

  /* Slider arrows (joined pill) */
  {{ s }} .vf-arrows { display: none; align-items: center; margin-top: 8px; }
  {{ s }} .vf-arrow {
    width: 60px; height: 44px; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--p-fg); background: transparent; color: var(--p-fg); cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }
  {{ s }} .vf-arrow[data-prev] { border-radius: 999px 0 0 999px; }
  {{ s }} .vf-arrow[data-next] { border-radius: 0 999px 999px 0; margin-left: -1px; }
  {{ s }} .vf-arrows__count { margin-left: 14px; font-size: 13px; font-weight: 600; color: var(--p-muted); font-variant-numeric: tabular-nums; }
  {{ s }} .vf-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) { {{ s }} .vf-arrow:hover { background: var(--p-fg); color: var(--p-bg); } }

  {{ s }} a:focus-visible, {{ s }} button:focus-visible, {{ s }} select:focus-visible, {{ s }} summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  {{ s }} .vf-vh { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  {{ s }} .vf-rows__note { padding: 8px 12px; background: #FFF4B8; color: #111111; font-size: 13px; line-height: 1.4; border-radius: 10px; text-align: left; }

  /* Phones: compact card, visible edge on white pages */
  @media (max-width: 749px) {
