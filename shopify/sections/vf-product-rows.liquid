    {{ s }} *, {{ s }} *::before, {{ s }} *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
{% endstyle %}

<script>
  (function () {
    if (customElements.get('vf-product-rows')) return;

    /* Shopify money formatting (follows the shop's / market's format) */
    function formatMoney(cents, format) {
      if (typeof cents === 'string') cents = cents.replace('.', '');
      var re = /\{\{\s*(\w+)\s*\}\}/;
      var fmt = format || '₹{{amount}}';
      function withDelims(n, precision, thousands, decimal) {
        thousands = thousands || ','; decimal = decimal || '.';
        if (isNaN(n) || n === null) return '0';
        var num = (n / 100.0).toFixed(precision);
        var parts = num.split('.');
        var dollars = parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands);
        var c = parts[1] ? decimal + parts[1] : '';
        return dollars + c;
      }
      var m = fmt.match(re);
      var value = '';
      switch (m ? m[1] : 'amount') {
        case 'amount': value = withDelims(cents, 2); break;
        case 'amount_no_decimals': value = withDelims(cents, 0); break;
        case 'amount_with_comma_separator': value = withDelims(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': value = withDelims(cents, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator': value = withDelims(cents, 2, "'", '.'); break;
        case 'amount_no_decimals_with_space_separator': value = withDelims(cents, 0, ' '); break;
        case 'amount_with_space_separator': value = withDelims(cents, 2, ' ', ','); break;
        case 'amount_with_period_and_space_separator': value = withDelims(cents, 2, ' ', '.'); break;
        default: value = withDelims(cents, 2);
      }
      return fmt.replace(re, value).replace(/<[^>]*>/g, '');
    }
    /* Whole units for "about ₹X a day" */
    function formatWhole(cents, format) {
      var rounded = Math.round(cents / 100) * 100;
      return formatMoney(rounded, format).replace(/[.,]00(?!\d)/, '');
    }

    function currentSpecies() {
      var s = null;
      try { s = new URLSearchParams(window.location.search).get('pet'); } catch (e) {}
      if (s !== 'dog' && s !== 'cat') { try { s = localStorage.getItem('vf_pet'); } catch (e) {} }
      return s === 'cat' ? 'cat' : (s === 'dog' ? 'dog' : null);
    }

    class VfProductRows extends HTMLElement {
      connectedCallback() {
        var self = this;
        this.list = this.querySelector('[data-list]');
        this.rows = Array.prototype.slice.call(this.querySelectorAll('[data-row]'));
        this.design = this.dataset.design === 'true';
        this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.hoverMq = window.matchMedia('(hover: hover) and (pointer: fine)');
        try { this.moneyFormat = JSON.parse(this.querySelector('[data-money]').textContent); } catch (e) { this.moneyFormat = null; }
        try { this.atcLabel = JSON.parse(this.querySelector('[data-labels]').textContent); } catch (e) { this.atcLabel = 'Add to cart'; }

        this.onSpecies = function (e) { var d = (e && e.detail) || {}; self.filter(d.species || d.pet || d.value); };
        this.onBlockSelect = function (e) {
          var id = e.detail && e.detail.blockId;
          var row = id && self.querySelector('[data-row][data-block-id="' + id + '"]');
          if (row && self.list && self.list.scrollWidth > self.list.clientWidth) {
            self.list.scrollTo({ left: row.offsetLeft - self.list.offsetLeft - 16, behavior: 'smooth' });
          }
        };
        document.addEventListener('vf:species-change', this.onSpecies);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        this.rows.forEach(function (row, i) { self.setupRow(row, i); });
        this.filter(currentSpecies());
      }

      disconnectedCallback() {
        document.removeEventListener('vf:species-change', this.onSpecies);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      /* ---------- Dog / Cat: show the right rows ---------- */
      filter(species) {
        if (species !== 'dog' && species !== 'cat') species = null;
        this.species = species;
        var shown = [];
        this.rows.forEach(function (row) {
          var show = row.dataset.show;
          var ok = this.design || !species || show === 'always' || show === species;
          row.hidden = !ok;
          if (ok) shown.push(row);
        }, this);
        /* Never leave the section empty */
        if (!shown.length) { this.rows.forEach(function (r) { r.hidden = false; }); shown = this.rows.slice(); }
        shown.forEach(function (r, i) { r.classList.toggle('is-flip', i % 2 === 1); });
        if (this.list) this.list.classList.toggle('is-single', shown.length === 1);
      }

      /* ---------- One row ---------- */
      setupRow(row, index) {
        var self = this;
        var form = row.querySelector('[data-buy]');
        var data = null;
        try { data = JSON.parse(row.querySelector('[data-row-json]').textContent); } catch (e) {}
        var state = { variant: null, plan: null };
        row._state = state;

        var variantInput = row.querySelector('[data-variant-input]');
        var planInput = row.querySelector('[data-plan-input]');
        var planSelect = row.querySelector('[data-plan]');
        var freq = row.querySelector('[data-freq]');
        var priceEl = row.querySelector('[data-price]');
        var compareEl = row.querySelector('[data-compare]');
        var perDayLine = row.querySelector('[data-perday-line]');
        var perDayEl = row.querySelector('[data-per-day]');
        var lasts = row.querySelector('[data-lasts]');
        var daysEl = row.querySelector('[data-days]');
        var atc = row.querySelector('[data-atc]');
        var atcLabel = row.querySelector('[data-atc-label]');
        var soldOutText = atc ? atc.dataset.soldOut : 'Sold out';

        function findVariant(id) {
          if (!data) return null;
          for (var i = 0; i < data.variants.length; i++) if (String(data.variants[i].id) === String(id)) return data.variants[i];
          return null;
        }

        function refresh() {
          var v = state.variant;
          if (!v) return;
          var subOn = row.querySelector('[data-po][value="sub"]:checked');
          var planId = subOn && planSelect ? planSelect.value : null;
          var price = planId && v.plans && v.plans[planId] != null ? v.plans[planId] : v.price;

          if (variantInput) variantInput.value = v.id;
          if (planInput) planInput.value = planId || '';
          if (freq) freq.hidden = !subOn;
          if (priceEl) priceEl.textContent = formatMoney(price, self.moneyFormat);
          if (compareEl) {
            var showCmp = !planId && v.compare > v.price;
            compareEl.hidden = !showCmp;
            if (showCmp) compareEl.textContent = formatMoney(v.compare, self.moneyFormat);
          }
          if (perDayLine) {
            perDayLine.hidden = !(v.days > 0);
            if (v.days > 0 && perDayEl) perDayEl.textContent = formatWhole(price / v.days, self.moneyFormat);
          }
          if (lasts) {
            lasts.hidden = !(v.days > 0);
            if (daysEl) daysEl.textContent = v.days;
          }
          if (atc) {
            atc.disabled = !v.available;
            if (atcLabel) atcLabel.textContent = v.available ? self.atcLabel : (soldOutText || 'Sold out');
          }
        }

        if (data && data.variants.length) {
          state.variant = findVariant(variantInput ? variantInput.value : data.variants[0].id) || data.variants[0];
        }

        row.querySelectorAll('[data-size]').forEach(function (r) {
          r.addEventListener('change', function () { state.variant = findVariant(r.value) || state.variant; refresh(); });
        });
        row.querySelectorAll('[data-po]').forEach(function (r) { r.addEventListener('change', refresh); });
        if (planSelect) planSelect.addEventListener('change', refresh);
        refresh();

        /* Video: hover plays on desktop; tap the play button on phones */
        var video = row.querySelector('video');
        var playBtn = row.querySelector('[data-play]');
        if (video) {
          var setPressed = function (on) { if (playBtn) { playBtn.setAttribute('aria-pressed', on ? 'true' : 'false'); playBtn.setAttribute('aria-label', on ? 'Pause video' : 'Play video'); } };
          var play = function () { var p = video.play(); if (p && p.catch) p.catch(function () {}); setPressed(true); };
          var pause = function () { video.pause(); setPressed(false); };
          row.addEventListener('mouseenter', function () { if (self.hoverMq.matches && !self.reduce.matches) play(); });
          row.addEventListener('mouseleave', function () { if (self.hoverMq.matches) pause(); });
          if (playBtn) playBtn.addEventListener('click', function () { if (video.paused) play(); else pause(); });
          /* Stop when scrolled away */
          new IntersectionObserver(function (en) { if (!en[0].isIntersecting) pause(); }).observe(row);
        }

        /* Add to cart */
        if (form && atc) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            self.addToCart(row, index, form, atc);
          });
        }
      }

      addToCart(row, index, form, btn) {
        var self = this;
        if (btn.disabled || btn.getAttribute('aria-busy') === 'true') return;
        var status = row.querySelector('[data-status]');
        var st = row._state || {};
        var v = st.variant;
        var planInput = row.querySelector('[data-plan-input]');
        var item = { id: Number(v ? v.id : form.querySelector('[name="id"]').value), quantity: 1 };
        if (planInput && planInput.value) item.selling_plan = Number(planInput.value);

        btn.setAttribute('aria-busy', 'true');
        if (status) { status.textContent = ''; status.classList.remove('is-error'); }

        var url = (this.dataset.cartAdd || '/cart/add') + '.js';
        fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: [item], sections: 'cart-drawer,cart-icon-bubble', sections_url: window.location.pathname })
        })
          .then(function (res) { return res.json().then(function (j) { return { ok: res.ok, json: j }; }); })
          .then(function (r) {
            btn.removeAttribute('aria-busy');
            if (!r.ok) throw new Error((r.json && (r.json.description || r.json.message)) || 'Could not add to cart.');

            btn.classList.add('is-added');
            setTimeout(function () { btn.classList.remove('is-added'); }, 2200);

            /* Analytics: add_to_cart with species and row position */
            var detail = { variant_id: item.id, selling_plan: item.selling_plan || null, species: self.species || row.dataset.species, row_position: index + 1 };
            try { (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: 'add_to_cart', section: 'vf_product_rows' }, detail)); } catch (e) {}
            try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('vf_add_to_cart', detail); } catch (e) {}

            document.dispatchEvent(new CustomEvent('vf:cart:changed'));
            document.dispatchEvent(new CustomEvent('cart:refresh'));

            if (self.dataset.action === 'cart' && self.openDrawer(r.json, btn)) return;
            if (status) {
              var cartUrl = self.dataset.cartUrl || '/cart';
              status.textContent = (self.dataset.addedText || 'Added to your cart.') + ' ';
              var a = document.createElement('a');
              a.href = cartUrl;
              a.textContent = self.dataset.viewCart || 'View cart';
              status.appendChild(a);
            }
          })
          .catch(function (err) {
            btn.removeAttribute('aria-busy');
            if (status) { status.textContent = err.message || 'Could not add to cart.'; status.classList.add('is-error'); }
          });
      }

      /* Open the cart drawer: the Vettofit cart drawer, or Dawn's. Returns true if one opened. */
      openDrawer(json, trigger) {
        var evt = new CustomEvent('vf:cart:open', { cancelable: true, bubbles: true, detail: { trigger: trigger, response: json } });
        document.dispatchEvent(evt);
        if (evt.defaultPrevented) return true;
        var dawn = document.querySelector('cart-drawer');
        if (dawn && typeof dawn.renderContents === 'function' && json && json.sections && json.sections['cart-drawer']) {
          try {
            dawn.classList.remove('is-empty');
            dawn.renderContents(Object.assign({ id: json.items && json.items[0] ? json.items[0].key : '' }, json));
            return true;
          } catch (e) {}
        }
        return false;
      }
    }

    customElements.define('vf-product-rows', VfProductRows);
  })();
</script>

{% schema %}
{
  "name": "Vettofit product rows",
  "tag": "section",
  "class": "vf-rows-section",
  "enabled_on": {
    "templates": ["page", "index", "product", "collection"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Brand colours only. White is the default for product rows.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "chalk", "label": "Chalk" },
        { "value": "plum", "label": "Night Plum" },
        { "value": "carbon", "label": "Carbon" }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Best under 6 words.",
      "default": "Pick their ritual."
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Short intro",
      "info": "Optional. One sentence.",
      "default": "Wild-caught salmon oil, made for dogs and for cats."
    },
    {
      "type": "select",
      "id": "row_style",
      "label": "Row style",
      "options": [
        { "value": "alternate", "label": "Alternate left / right" },
        { "value": "left", "label": "Photo always left" }
      ],
      "default": "alternate"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "info": "Comes from your reviews app automatically.",
      "default": true
    },
    {
      "type": "header",
      "content": "Cost per day"
    },
    {
      "type": "checkbox",
      "id": "show_cost",
      "label": "Show cost per day",
      "info": "Worked out from price, bottle size and the feeding guide. Hides itself if any of that data is missing.",
      "default": true
    },
    {
      "type": "range",
      "id": "cost_weight_dog",
      "label": "Cost-per-day example weight (dogs)",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "kg",
      "default": 10,
      "info": "Shows e.g. \"about ₹X a day for a 10 kg dog\"."
