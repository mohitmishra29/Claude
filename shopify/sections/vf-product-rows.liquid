          "label": "Product",
          "info": "Price, sizes, rating, stock and benefits come from the product."
        },
        {
          "type": "select",
          "id": "show_for",
          "label": "Show for",
          "info": "\"Automatic\" reads the product's species metafield.",
          "options": [
            { "value": "auto", "label": "Automatic" },
            { "value": "always", "label": "Always" },
            { "value": "dog", "label": "Dog selected" },
            { "value": "cat", "label": "Cat selected" }
          ],
          "default": "auto"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo override",
          "info": "Optional. Square works best. Otherwise uses the product's ritual video, then its first photo."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video override",
          "info": "Optional. Muted 4–6 second loop, under 1.5MB."
        },
        {
          "type": "select",
          "id": "label",
          "label": "Label",
          "info": "Fixed list. No free-text badges.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "bestseller", "label": "Bestseller" },
            { "value": "new", "label": "New" },
            { "value": "back", "label": "Back in stock" }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "benefits_count",
          "label": "Benefits shown",
          "info": "Top items from the product's benefits metafield.",
          "min": 2,
          "max": 3,
          "step": 1,
          "default": 3
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vettofit product rows",
      "blocks": [
        { "type": "product_row", "settings": { "show_for": "auto", "label": "bestseller" } },
        { "type": "product_row", "settings": { "show_for": "auto" } }
