  /* ---------- Tablet & desktop: 50 / 50 split bands ---------- */
  @media (min-width: 750px) {
    {{ s }} { --r-gutter: clamp(24px, 4vw, 64px); }
    {{ s }} .vf-rows__head { padding-top: 80px; padding-bottom: 48px; }
    {{ s }} .vf-rows__heading { font-size: clamp(32px, 2vw + 14px, 46px); }

    {{ s }} .vf-rows__track { display: grid; gap: 0; padding: 0; overflow: visible; }
    {{ s }}.vf-rows--page .vf-rows__track { gap: 24px; max-width: 1440px; margin: 0 auto; padding: 0 var(--r-gutter); }
    {{ s }} .vf-row { display: grid; grid-template-columns: 1fr 1fr; border-radius: 0; min-height: clamp(560px, 82vh, 820px); }
    {{ s }}.vf-rows--page .vf-row { border-radius: 24px; }
    {{ s }} .vf-row__media { aspect-ratio: auto; height: 100%; grid-column: 2; grid-row: 1; }
    {{ s }} .vf-row__panel { grid-column: 1; grid-row: 1; align-items: center; justify-content: center; }
    {{ s }}.vf-rows--alternate .vf-row.is-flip .vf-row__media { grid-column: 1; }
    {{ s }}.vf-rows--alternate .vf-row.is-flip .vf-row__panel { grid-column: 2; }
    {{ s }} .vf-row__content { max-width: 560px; padding: 64px clamp(28px, 4vw, 72px); gap: 20px; }
    {{ s }}.vf-align--center .vf-row__content { margin: 0 auto; }
    {{ s }} .vf-row__media--contain .vf-row__img { padding: 8%; }
    {{ s }} .vf-row__title { font-size: clamp(40px, 3.4vw + 8px, 72px); }
    {{ s }} .vf-row__title.is-long { font-size: clamp(30px, 1.8vw + 10px, 46px); }
    {{ s }} .vf-row__line { font-size: 19px; }
    {{ s }} .vf-row__eyebrow { font-size: 13px; }
    {{ s }} .vf-row__eyebrow::before, {{ s }} .vf-row__eyebrow::after { width: 28px; }
    {{ s }} .vf-row__label { top: 24px; left: 24px; }

    /* Slider layout: one product at a time with arrows */
    {{ s }}.vf-rows--slider .vf-rows__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    {{ s }}.vf-rows--slider .vf-row { flex: 0 0 100%; scroll-snap-align: start; }
    {{ s }}.vf-rows--slider.vf-rows--page .vf-rows__track { scroll-padding: 0 var(--r-gutter); }
