    {{ s }} .vf-row__media { grid-column: 1 / span 7; max-height: 82vh; aspect-ratio: auto; height: min(82vh, 720px); }
    {{ s }} .vf-row__info { grid-column: 8 / span 5; max-width: 480px; }
    {{ s }}.vf-rows--alternate .vf-row.is-flip .vf-row__media { grid-column: 6 / span 7; }
    {{ s }}.vf-rows--alternate .vf-row.is-flip .vf-row__info { grid-column: 1 / span 5; justify-self: end; width: 100%; }
    {{ s }} .vf-btn { min-height: 56px; }
