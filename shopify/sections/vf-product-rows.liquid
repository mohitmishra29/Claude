{% endstyle %}

<script>
  (function () {
    if (customElements.get('vf-product-rows')) return;

    function formatMoney(cents, format) {
      var re = /\{\{\s*(\w+)\s*\}\}/;
      var fmt = format || '₹{{amount}}';
      function d(n, p, t, dec) {
        t = t || ','; dec = dec || '.';
        if (isNaN(n) || n === null) return '0';
        var parts = (n / 100).toFixed(p).split('.');
        return parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + t) + (parts[1] ? dec + parts[1] : '');
      }
      var m = fmt.match(re), v;
      switch (m ? m[1] : 'amount') {
        case 'amount_no_decimals': v = d(cents, 0); break;
        case 'amount_with_comma_separator': v = d(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': v = d(cents, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator': v = d(cents, 2, "'", '.'); break;
        case 'amount_no_decimals_with_space_separator': v = d(cents, 0, ' '); break;
        case 'amount_with_space_separator': v = d(cents, 2, ' ', ','); break;
        case 'amount_with_period_and_space_separator': v = d(cents, 2, ' ', '.'); break;
        default: v = d(cents, 2);
      }
      return fmt.replace(re, v).replace(/<[^>]*>/g, '');
    }
    function formatWhole(cents, format) {
      return formatMoney(Math.round(cents / 100) * 100, format).replace(/[.,]00(?!\d)/, '');
    }
    function currentSpecies() {
      var s = null;
      try { s = new URLSearchParams(window.location.search).get('pet'); } catch (e) {}
      if (s !== 'dog' && s !== 'cat') { try { s = localStorage.getItem('vf_pet'); } catch (e) {} }
      return s === 'cat' ? 'cat' : (s === 'dog' ? 'dog' : null);
    }

    class VfProductRows extends HTMLElement {
      connectedCallback() {
        var self = this;
        this.track = this.querySelector('[data-list]');
        this.rows = Array.prototype.slice.call(this.querySelectorAll('[data-row]'));
        this.design = this.dataset.design === 'true';
        this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.hoverMq = window.matchMedia('(hover: hover) and (pointer: fine)');
        try { this.moneyFormat = JSON.parse(this.querySelector('[data-money]').textContent); } catch (e) { this.moneyFormat = null; }
        try { this.atcLabel = JSON.parse(this.querySelector('[data-labels]').textContent); } catch (e) { this.atcLabel = 'Add to cart'; }

        this.onSpecies = function (e) { var d = (e && e.detail) || {}; self.filter(d.species || d.pet || d.value); };
        this.onBlockSelect = function (e) {
          var id = e.detail && e.detail.blockId;
          var row = id && self.querySelector('[data-row][data-block-id="' + id + '"]');
          if (row) self.scrollToRow(row);
        };
        document.addEventListener('vf:species-change', this.onSpecies);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        this.rows.forEach(function (row, i) { self.setupRow(row, i); });
        this.querySelectorAll('[data-prev]').forEach(function (b) { b.addEventListener('click', function () { self.step(-1); }); });
        this.querySelectorAll('[data-next]').forEach(function (b) { b.addEventListener('click', function () { self.step(1); }); });
        this.filter(currentSpecies());
      }

      disconnectedCallback() {
        document.removeEventListener('vf:species-change', this.onSpecies);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      visibleRows() { return this.rows.filter(function (r) { return !r.hidden; }); }

      scrollToRow(row) {
        if (!this.track) return;
        if (this.track.scrollWidth > this.track.clientWidth + 2) {
          var pad = parseFloat(getComputedStyle(this.track).paddingLeft) || 0;
          var left = this.track.scrollLeft + row.getBoundingClientRect().left - this.track.getBoundingClientRect().left - pad;
          this.track.scrollTo({ left: left, behavior: this.reduce.matches ? 'auto' : 'smooth' });
        }
      }

      step(dir) {
        var rows = this.visibleRows();
        if (!rows.length || !this.track) return;
        var trackLeft = this.track.getBoundingClientRect().left + (parseFloat(getComputedStyle(this.track).paddingLeft) || 0);
        var idx = 0, best = Infinity;
        rows.forEach(function (r, i) { var dl = Math.abs(r.getBoundingClientRect().left - trackLeft); if (dl < best) { best = dl; idx = i; } });
        this.scrollToRow(rows[(idx + dir + rows.length) % rows.length]);
      }

      filter(species) {
        if (species !== 'dog' && species !== 'cat') species = null;
        this.species = species;
        var shown = [];
        this.rows.forEach(function (row) {
          var show = row.dataset.show;
          var ok = this.design || !species || show === 'always' || show === species;
          row.hidden = !ok;
          if (ok) shown.push(row);
        }, this);
        if (!shown.length) { this.rows.forEach(function (r) { r.hidden = false; }); shown = this.rows.slice(); }
        shown.forEach(function (r, i) {
          r.classList.toggle('is-flip', i % 2 === 1);
          var now = r.querySelector('[data-count-now]'), all = r.querySelector('[data-count-all]');
          if (now) now.textContent = i + 1;
          if (all) all.textContent = shown.length;
          var arrows = r.querySelector('.vf-arrows');
          if (arrows) arrows.hidden = shown.length < 2;
        });
        if (this.track) this.track.classList.toggle('is-single', shown.length === 1);
      }

      setupRow(row, index) {
        var self = this;
        var form = row.querySelector('[data-buy]');
        var data = null;
        try { data = JSON.parse(row.querySelector('[data-row-json]').textContent); } catch (e) {}
        var state = { variant: null };
        row._state = state;

        var q = function (sel) { return row.querySelector(sel); };
        var variantInput = q('[data-variant-input]'), planInput = q('[data-plan-input]'), planSelect = q('[data-plan]');
        var freq = q('[data-freq]'), priceEl = q('[data-price]'), compareEl = q('[data-compare]');
        var perDayLine = q('[data-perday-line]'), perDayEl = q('[data-per-day]');
        var atc = q('[data-atc]'), atcLabel = q('[data-atc-label]');
        var soldOutText = atc ? atc.dataset.soldOut : 'Sold out';
        var fSizeRow = q('[data-fact-size-row]'), fSize = q('[data-fact-size]');
        var fDaysRow = q('[data-fact-days-row]'), fDays = q('[data-fact-days]');
        var fCostRow = q('[data-fact-cost-row]'), fCost = q('[data-fact-cost]'), fPrice = q('[data-fact-price]');
        var mrpLabel = q('[data-mrp-label]');
        var compareAmt = q('[data-compare-amount]'), offEl = q('[data-off]'), offPct = q('[data-off-pct]');
        var fMrpRow = q('[data-fact-mrp-row]'), fMrp = q('[data-fact-mrp]');

        function findVariant(id) {
          if (!data) return null;
          for (var i = 0; i < data.variants.length; i++) if (String(data.variants[i].id) === String(id)) return data.variants[i];
          return null;
        }

        function refresh() {
          var v = state.variant;
          if (!v) return;
          var subOn = row.querySelector('[data-po][value="sub"]:checked');
          var planId = subOn && planSelect ? planSelect.value : null;
          var price = planId && v.plans && v.plans[planId] != null ? v.plans[planId] : v.price;
          var priceText = formatMoney(price, self.moneyFormat);
          var perDay = v.days > 0 ? formatWhole(price / v.days, self.moneyFormat) : '';

          if (variantInput) variantInput.value = v.id;
          if (planInput) planInput.value = planId || '';
          if (freq) freq.hidden = !subOn;
          if (priceEl) priceEl.textContent = priceText;
          /* MRP (compare-at) crossed out; with a subscription, the regular price is crossed out if there's no MRP */
          var struck = Math.max(v.compare || 0, planId ? v.price : 0);
          var hasStrike = struck > price;
          var pct = hasStrike ? Math.round((struck - price) * 100 / struck) : 0;
          if (compareEl) { compareEl.hidden = !hasStrike; if (compareAmt) compareAmt.textContent = formatMoney(struck, self.moneyFormat); }
          /* Only call it "MRP" when it really is the MRP (compare-at price), never the regular price */
          if (mrpLabel) mrpLabel.hidden = !(v.compare > 0 && struck === v.compare);
          if (offEl) { offEl.hidden = !(pct > 0); if (offPct) offPct.textContent = pct; }
          if (fMrpRow) { fMrpRow.hidden = !(v.compare > price); if (fMrp) fMrp.textContent = formatMoney(v.compare, self.moneyFormat); }
          if (perDayLine) { perDayLine.hidden = !perDay; if (perDay && perDayEl) perDayEl.textContent = perDay; }
          if (fPrice) fPrice.textContent = priceText;
          if (fSizeRow) { fSizeRow.hidden = !v.size; if (fSize) fSize.textContent = v.size; }
          if (fDaysRow) { fDaysRow.hidden = !(v.days > 0); if (fDays) fDays.textContent = v.days; }
          if (fCostRow) { fCostRow.hidden = !perDay; if (fCost) fCost.textContent = perDay; }
          if (atc) {
            atc.disabled = !v.available;
            if (atcLabel) atcLabel.textContent = v.available ? self.atcLabel : soldOutText;
          }
        }

        if (data && data.variants.length) {
          state.variant = findVariant(variantInput ? variantInput.value : data.variants[0].id) || data.variants[0];
        }
        row.querySelectorAll('[data-size]').forEach(function (r) {
          r.addEventListener('change', function () { state.variant = findVariant(r.value) || state.variant; refresh(); });
        });
        row.querySelectorAll('[data-po]').forEach(function (r) { r.addEventListener('change', refresh); });
        if (planSelect) planSelect.addEventListener('change', refresh);
        refresh();

        var video = row.querySelector('video'), playBtn = row.querySelector('[data-play]');
        if (video) {
          var setPressed = function (on) { if (playBtn) { playBtn.setAttribute('aria-pressed', on ? 'true' : 'false'); playBtn.setAttribute('aria-label', on ? 'Pause video' : 'Play video'); } };
          var play = function () { var p = video.play(); if (p && p.catch) p.catch(function () {}); setPressed(true); };
          var pause = function () { video.pause(); setPressed(false); };
          row.addEventListener('mouseenter', function () { if (self.hoverMq.matches && !self.reduce.matches) play(); });
          row.addEventListener('mouseleave', function () { if (self.hoverMq.matches) pause(); });
          if (playBtn) playBtn.addEventListener('click', function () { if (video.paused) play(); else pause(); });
          new IntersectionObserver(function (en) { if (!en[0].isIntersecting) pause(); }).observe(row);
        }

        if (form && atc) {
          form.addEventListener('submit', function (e) { e.preventDefault(); self.addToCart(row, index, form, atc); });
        }
      }

      addToCart(row, index, form, btn) {
        var self = this;
        if (btn.disabled || btn.getAttribute('aria-busy') === 'true') return;
        var status = row.querySelector('[data-status]');
        var v = (row._state || {}).variant;
        var planInput = row.querySelector('[data-plan-input]');
        var item = { id: Number(v ? v.id : form.querySelector('[name="id"]').value), quantity: 1 };
        if (planInput && planInput.value) item.selling_plan = Number(planInput.value);

        btn.setAttribute('aria-busy', 'true');
        if (status) { status.textContent = ''; status.classList.remove('is-error'); }

        fetch((this.dataset.cartAdd || '/cart/add') + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: [item], sections: 'cart-drawer,cart-icon-bubble', sections_url: window.location.pathname })
        })
          .then(function (res) { return res.json().then(function (j) { return { ok: res.ok, json: j }; }); })
          .then(function (r) {
            btn.removeAttribute('aria-busy');
            if (!r.ok) throw new Error((r.json && (r.json.description || r.json.message)) || 'Could not add to cart.');
            btn.classList.add('is-added');
            setTimeout(function () { btn.classList.remove('is-added'); }, 2200);

            var detail = { variant_id: item.id, selling_plan: item.selling_plan || null, species: self.species || row.dataset.species, row_position: index + 1 };
            try { (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: 'add_to_cart', section: 'vf_product_rows' }, detail)); } catch (e) {}
            try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('vf_add_to_cart', detail); } catch (e) {}
            document.dispatchEvent(new CustomEvent('vf:cart:changed'));
            document.dispatchEvent(new CustomEvent('cart:refresh'));

            if (self.dataset.action === 'cart' && self.openDrawer(r.json, btn)) return;
            if (status) {
              status.textContent = (self.dataset.addedText || 'Added to your cart.') + ' ';
              var a = document.createElement('a');
              a.href = self.dataset.cartUrl || '/cart';
              a.textContent = self.dataset.viewCart || 'View cart';
              status.appendChild(a);
            }
          })
          .catch(function (err) {
            btn.removeAttribute('aria-busy');
            if (status) { status.textContent = err.message || 'Could not add to cart.'; status.classList.add('is-error'); }
          });
      }

      openDrawer(json, trigger) {
        var evt = new CustomEvent('vf:cart:open', { cancelable: true, bubbles: true, detail: { trigger: trigger, response: json } });
        document.dispatchEvent(evt);
        if (evt.defaultPrevented) return true;
        var dawn = document.querySelector('cart-drawer');
        if (dawn && typeof dawn.renderContents === 'function' && json && json.sections && json.sections['cart-drawer']) {
          try {
            dawn.classList.remove('is-empty');
            dawn.renderContents(Object.assign({ id: json.items && json.items[0] ? json.items[0].key : '' }, json));
            return true;
          } catch (e) {}
        }
        return false;
      }
    }

    customElements.define('vf-product-rows', VfProductRows);
  })();
</script>

{% schema %}
{
  "name": "Vettofit product rows",
  "tag": "div",
  "class": "vf-rows-section",
  "enabled_on": {
    "templates": ["page", "index", "product", "collection"]
  },
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Look" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Rows stack the products one under another. Slider shows one at a time with arrows. Phones always swipe.",
      "options": [
        { "value": "rows", "label": "Rows" },
        { "value": "slider", "label": "Slider with arrows" }
      ],
      "default": "rows"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "full", "label": "Edge to edge" },
        { "value": "page", "label": "Page width (rounded cards)" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "row_style",
      "label": "Row style",
      "options": [
        { "value": "alternate", "label": "Alternate left / right" },
        { "value": "left", "label": "Colour panel always left" }
      ],
      "default": "alternate"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Section background",
      "info": "Behind the heading. Each row's panel colour is set in the row itself.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "chalk", "label": "Chalk" },
        { "value": "plum", "label": "Night Plum" },
        { "value": "carbon", "label": "Carbon" }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Best under 6 words. If empty, it's hidden but still read by search engines and screen readers.",
      "default": "Pick their ritual."
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Short intro",
      "info": "Optional. One sentence.",
      "default": "Wild-caught salmon oil, made for dogs and for cats."
    },
    {
      "type": "text",
      "id": "eyebrow_auto",
      "label": "Automatic small label",
      "info": "Used when a row's own label is empty. Keep [pets]; it becomes dogs or cats.",
      "default": "For [pets]"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "info": "Comes from your reviews app automatically.",
      "default": true
    },
    { "type": "header", "content": "Cost per day" },
    {
      "type": "checkbox",
      "id": "show_cost",
      "label": "Show cost per day",
      "info": "Worked out from price, bottle size and the feeding guide. Hides itself if any of that data is missing.",
      "default": true
    },
    {
      "type": "range",
      "id": "cost_weight_dog",
      "label": "Example weight (dogs)",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "kg",
      "default": 10
    },
    {
      "type": "range",
      "id": "cost_weight_cat",
      "label": "Example weight (cats)",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "kg",
      "default": 4
    },
    {
      "type": "text",
      "id": "cost_text",
      "label": "Cost-per-day line",
      "info": "Keep [price], [weight] and [pet]. They fill in automatically.",
      "default": "About [price] a day for a [weight] kg [pet]"
    },
    { "type": "header", "content": "Buying" },
    {
      "type": "checkbox",
      "id": "show_subscribe",
      "label": "Show subscribe-and-save option",
      "info": "Appears only on products with a subscription plan. One-time is always pre-selected.",
      "default": true
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Button action",
      "options": [
        { "value": "cart", "label": "Add to cart and open cart" },
        { "value": "product", "label": "Go to product page" }
      ],
      "default": "cart"
    },
    {
      "type": "checkbox",
      "id": "show_mrp",
      "label": "Show MRP and discount",
      "info": "Shows the product's compare-at price as the crossed-out MRP, next to the selling price. Set the compare-at price on each product in Admin.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show % off badge",
      "default": true
    },
    {
      "type": "text",
      "id": "mrp_label",
      "label": "MRP label",
      "default": "MRP"
    },
    {
      "type": "text",
      "id": "tax_note",
      "label": "Tax note under the price",
      "info": "Leave empty to hide.",
      "default": "Inclusive of all taxes"
