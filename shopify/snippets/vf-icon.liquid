{%- comment -%}
  Vettofit monoline icon set · 24px grid · 1.5px stroke · round caps (brand book 6.12)
  Usage: {% render 'vf-icon', name: 'shield-check', size: 20 %}
  Icons are decorative (aria-hidden); always pair them with a visible text label.
  No paw icons by design.
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 24
  assign filled = false
  if name == 'star'
    assign filled = true
  endif
-%}
<svg class="vf-icon vf-icon--{{ name }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" {% if filled %}fill="currentColor" stroke="none"{% else %}fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"{% endif %} aria-hidden="true" focusable="false">
  {%- case name -%}
